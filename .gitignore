# ==============================================================================
# LegalTrace - Robust Production .gitignore
# Covers: Python, ML/RAG models, Embeddings, Indices, Scraped Corpus, DBs, IDEs
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (CRITICAL FOR SECURITY)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local.env
*.pem
*.key
*.cert
*.crt
credentials.json
client_secret*.json
*.token

# ------------------------------------------------------------------------------
# 2. Python Bytecode, Caches & Packaging
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 3. Virtual Environments & Package Managers
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.conda/
.uv/

# ------------------------------------------------------------------------------
# 4. Data Corpus, Scraped Stores & RAG Indices (Bulky Big Data)
# ------------------------------------------------------------------------------
# Scraped document storage (HTML, text, and per-doc JSONs)
raw-store/
raw_store/
data/

# Generated RAG hybrid indices (FAISS, BM25, embeddings)
search_index/
*.index
*.faiss
*.bin

# Bulky JSONL / Parquet dumps generated during scraping & batch processing
chunks.jsonl
chunks.json
all_*_cleaned_judgments.jsonl
all_*_enriched_judgments.jsonl
all_*_headnotes.jsonl
all_*_structured_judgments.jsonl
consolidated_*.jsonl
discovered_*.jsonl
*.parquet
*.feather
*.arrow

# ------------------------------------------------------------------------------
