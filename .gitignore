# ------------------------------------------------------------------------------
*.log
logs/
*.pid
*.seed
nohup.out
scratch_*.*
temp_*.*
tmp/
*.tmp
test_script*.js

# ------------------------------------------------------------------------------
# 10. Operating System Files (Windows, macOS, Linux)
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ------------------------------------------------------------------------------
