# Acquisition Strategy Mode: scrape_only (default) | hybrid | api
# Set to scrape_only when official API key is not approved or unavailable
MODE=scrape_only
ENABLE_HTML_FALLBACK=true

# Concurrency & Worker Threads
MAX_WORKERS=3

# Rate Limiting & Politeness (Applies across all concurrent worker threads)
SCRAPE_MIN_DELAY_SECONDS=2.0
SCRAPE_MAX_DELAY_SECONDS=4.0
ADAPTIVE_BACKOFF_SECONDS=15.0
API_RATE_LIMIT_RPS=2.0

# User-Agent Identification for Ethical Crawling
USER_AGENT=LegalTraceAcademicBot/0.1 (+contact: academic-research@legaltrace.org; purpose: academic research corpus, non-commercial)

# Optional Session / Clearance Cookies (e.g. if challenged or authenticated)
# INDIANKANOON_COOKIES=sessionid=...; cf_clearance=...

# Indian Kanoon API Configuration (optional - used if MODE=api or MODE=hybrid with active token)
# INDIANKANOON_API_TOKEN=your_api_token_here
INDIANKANOON_API_BASE=https://api.indiankanoon.org
INDIANKANOON_BASE_URL=https://indiankanoon.org
MAX_API_CALLS_PER_RUN=5000

# Scope and Target Settings
TARGET_COURTS=["Delhi High Court", "Supreme Court of India"]
TARGET_YEARS=[2023]
SAMPLE_LIMIT=1000

# Storage Locations
INTAKE_OUTPUT_PATH=./raw-store
DB_PATH=./raw-store/job_state/legaltrace_ingest.sqlite

# Network & Retry Policy
HTTP_TIMEOUT_SECONDS=30.0
MAX_RETRIES=3
BACKOFF_FACTOR=2.0
