a key="d2">1</data></node><node id="prec_2010_6_scc_773"><data key="d0">precedent</data><data key="d1">(2010) 6 SCC 773</data><data key="d2">1</data></node><node id="prec_2006_1_scc_479"><data key="d0">precedent</data><data key="d1">See U.P. State Brassware Corpn. Ltd. v. Uday Narain Pandey Neutral Citation Number</data><data key="d2">1</data></node><node id="prec_2007_9_scc_353"><data key="d0">precedent</data><data key="d1">See U.P. State Brassware Corpn. Ltd. v. Uday Narain Pandey Neutral Citation Number</data><data key="d2">1</data></node><node id="prec_2007_1_scc_575"><data key="d0">precedent</data><data key="d1">are Corpn. Ltd. v. Uday Narain Pandey Neutral Citation Number</data><data key="d2">1</data></node><node id="prec_2007_9_scc_748"><data key="d0">precedent</data><data key="d1">Sita Ram v. Moti Lal Nehru Farmers Training Institute</data><data key="d2">1</data></node><node id="prec_2008_5_scc_75"><data key="d0">precedent</data><data key="d1">Sita Ram v. Moti Lal Nehru Farmers Training Institute</data><data key="d2">1</data></node><node id="prec_2006_11_scc_684"><data key="d0">precedent</data><data key="d1">Sita Ram v. Moti Lal Nehru Farmers Training Institute</data><data key="d2">1</data></node><node id="prec_2008_4_scc_261"><data key="d0">precedent</data><data key="d1">Sita Ram v. Moti Lal Nehru Farmers Training Institute</data><data key="d2">1</data></node><node id="prec_2008_1_scc_575"><data key="d0">precedent</data><data key="d1">Sita Ram v. Moti Lal Nehru Farmers Training Institute</data><data key="d2">1</data></node><node id="prec_2009_15_scc_327"><data key="d0">precedent</data><data key="d1">This Court in Jagbir Singh vs. Haryana State Agriculture Marketing Board</data><data key="d2">1</data></node><node id="prec_air_2014_sc_1188"><data key="d0">precedent</data><data key="d1">the terminated workman should not be denied the relief of reinstatement. Reliance has been placed on B.S.N.L. vs. Bhurumal</data><data key="d2">1</data></node><node id="prec_air_2010_sc_1116"><data key="d0">precedent</data><data key="d1">Reliance has been placed on Harjinder Singh vs Punjab State Warehousing Corporation</data><data key="d2">1</data></node><node id="prec_air_1950_sc_188"><data key="d0">precedent</data><data key="d1">Bidi Leaves vs. The State of Bombay</data><data key="d2">1</data></node><node id="prec_air_1962_sc_486"><data key="d0">precedent</data><data key="d1">Bidi Leaves vs. The State of Bombay</data><data key="d2">1</data></node><node id="prec_air_1970_sc_1401"><data key="d0">precedent</data><data key="d1">Rourkela vs. AK Roy</data><data key="d2">1</data></node><node id="prec_air_1979_sc_75"><data key="d0">precedent</data><data key="d1">Ltd. v. Employees of Hindustan Tin Works</data><data key="d2">1</data></node><node id="prec_air_1967_sc_1427"><data key="d0">precedent</data><data key="d1">Jaisinghani v. Union of Neutral Citation Number</data><data key="d2">1</data></node><node id="prec_2023_dhc_3103"><data key="d0">precedent</data><data key="d1">2023:DHC:3103</data><data key="d2">1</data></node><node id="prec_2006_9_scc_305"><data key="d0">precedent</data><data key="d1">Co Ltd vs. State of T.N</data><data key="d2">1</data></node><node id="prec_1996_1_scc_327"><data key="d0">precedent</data><data key="d1">Bihar State Housing Board v. Ramesh Kumar Singh</data><data key="d2">1</data></node><node id="prec_2010_13_scc_311"><data key="d0">precedent</data><data key="d1">Anr. v. Sangram Keshari Misra</data><data key="d2">1</data></node><node id="prec_1994_3_scc_357"><data key="d0">precedent</data><data key="d1">Ors. v. Upendra Singh</data><data key="d2">1</data></node><node id="prec_1999_7_scc_409"><data key="d0">precedent</data><data key="d1">Zunjarrao Bhikaji Nagarkar vs. Union of India and Others</data><data key="d2">1</data></node><node id="prec_2007_4_scc_566"><data key="d0">precedent</data><data key="d1">Inspector Prem Chand vs. Govt. of NCT of Delhi</data><data key="d2">1</data></node><node id="prec_1993_2_scc_49"><data key="d0">precedent</data><data key="d1">Union of India vs. R.K. Desai</data><data key="d2">1</data></node><node id="prec_2007_4_scc_247"><data key="d0">precedent</data><data key="d1">Ramesh Chander Singh v. High Court of Allahabad and Another</data><data key="d2">1</data></node><node id="prec_2020_11_scc_760"><data key="d0">precedent</data><data key="d1">Dr. Kothari has also relied upon the judgment of the Supreme Court in the case of Sadhna Chaudhary v. State of Uttar Pradesh</data><data key="d2">1</data></node><node id="prec_2006_6_scc_359"><data key="d0">precedent</data><data key="d1">He further relied upon the judgment of the Supreme Court in the case of Kunhayammed and Ors. v. State of Kerala</data><data key="d2">1</data></node><node id="prec_2001_2_scc_330"><data key="d0">precedent</data><data key="d1">Reliance has been placed upon the judgment of the Supreme Court in the case of State of Punjab v. V.K. Khanna</data><data key="d2">1</data></node><node id="prec_1992_4_scc_54"><data key="d0">precedent</data><data key="d1">Ors. vs. Ram Singh Ex-Constable</data><data key="d2">1</data></node><node id="prec_2019_10_scc_640"><data key="d0">precedent</data><data key="d1">In Krishna Prasad Verma v. State of Bihar</data><data key="d2">1</data></node><node id="prec_2006_5_scc_680"><data key="d0">precedent</data><data key="d1">Union of India v. Duli Chand</data><data key="d2">1</data></node><node id="prec_air_1987_sc_943"><data key="d0">precedent</data><data key="d1">Bihar State Housing Board v. Ramesh Kumar Singh</data><data key="d2">1</data></node><node id="prec_air_2000_sc_3603"><data key="d0">precedent</data><data key="d1">AIR 2000 SC 3603</data><data key="d2">1</data></node><node id="prec_air_2004_sc_1467"><data key="d0">precedent</data><data key="d1">Anr. v. Kunisetty Satyanarayana</data><data key="d2">1</data></node><node id="prec_air_2007_sc_906"><data key="d0">precedent</data><data key="d1">Anr. v. Kunisetty Satyanarayana</data><data key="d2">1</data></node><node id="prec_air_1967_sc_1274"><data key="d0">precedent</data><data key="d1">Govinda Memon v. Union of India</data><data key="d2">1</data></node><node id="prec_2001_scc_online_del_756"><data key="d0">precedent</data><data key="d1">Others v. Dolly Saxena</data><data key="d2">1</data></node><node id="prec_2010_scc_online_del_4113"><data key="d0">precedent</data><data key="d1">In the case of Union of India v. Harsh Vardhan Chauhan</data><data key="d2">1</data></node><node id="prec_2023_dhc_3522"><data key="d0">precedent</data><data key="d1">2023:DHC:3522</data><data key="d2">1</data></node><node id="prec_2014_14_scc_731"><data key="d0">precedent</data><data key="d1">(2014) 14 SCC 731</data><data key="d2">1</data></node><node id="prec_2012_11_scc_257"><data key="d0">precedent</data><data key="d1">Subsequent decisions of this Court in Southern Painters v. Fertilizers</data><data key="d2">1</data></node><node id="prec_2006_11_scc_548"><data key="d0">precedent</data><data key="d1">Joseph Vilangandan v. Executive Engineer</data><data key="d2">1</data></node><node id="prec_1977_3_scc_457"><data key="d0">precedent</data><data key="d1">The decisions of this Court in Radhakrishna Agarwal v. State of Bihar</data><data key="d2">1</data></node><node id="prec_1981_1_scc_722"><data key="d0">precedent</data><data key="d1">Maneka Gandhi v. Union of India</data><data key="d2">1</data></node><node id="prec_1990_3_scc_752"><data key="d0">precedent</data><data key="d1">reference to the following passage from the decision of this Court in Mahabir Auto Stores v. Indian Oil Corpn</data><data key="d2">1</data></node><node id="prec_2022_4_scc_393"><data key="d0">precedent</data><data key="d1">(2022) 4 SCC 393</data><data key="d2">1</data></node><node id="prec_2021_2_scc_551"><data key="d0">precedent</data><data key="d1">Gorkha Security Services v. State</data><data key="d2">1</data></node><node id="prec_air_1994_sc_1277"><data key="d0">precedent</data><data key="d1">Subsequent decisions of this Court in Southern Painters v. Fertilizers</data><data key="d2">1</data></node><node id="prec_2020_scc_online_del_68"><data key="d0">precedent</data><data key="d1">2020 SCC OnLine Del 68</data><data key="d2">1</data></node><node id="prec_2013_scc_online_del_4289"><data key="d0">precedent</data><data key="d1">Gorkha Security Services v. State</data><data key="d2">1</data></node><node id="prec_2016_scc_online_del_5772"><data key="d0">precedent</data><data key="d1">no allegation of any coercion was raised by Devki Nandan Garg and this itself strikes at the credibility of the retraction application This court in Dayawanti v. Commissioner of Income Tax</data><data key="d2">1</data></node><node id="prec_2015_scc_online_del_13824"><data key="d0">precedent</data><data key="d1">The reliability of the retracted statements has been discussed by the division bench of this court Central Excise v. Vishnu</data><data key="d2">1</data></node><node id="prec_2018_scc_online_del_8873"><data key="d0">precedent</data><data key="d1">Raj Kumar Goel v. Directorate of Enforcement</data><data key="d2">1</data></node><node id="prec_2009_8_scc_325"><data key="d0">precedent</data><data key="d1">In Savitri Agarwal v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_2019_17_scc_326"><data key="d0">precedent</data><data key="d1">Pradeep Ram v. State of Jharkhand</data><data key="d2">1</data></node><node id="prec_2009_6_scc_332"><data key="d0">precedent</data><data key="d1">Mithabhai Pashabhai Patel v. State of Gujarat</data><data key="d2">1</data></node><node id="prec_2011_6_scc_189"><data key="d0">precedent</data><data key="d1">See Prakash Kadam v. Ramprasad Vishwanath Gupta</data><data key="d2">1</data></node><node id="prec_2012_4_scc_379"><data key="d0">precedent</data><data key="d1">See Prakash Kadam v. Ramprasad Vishwanath Gupta</data><data key="d2">1</data></node><node id="prec_2005_8_scc_21"><data key="d0">precedent</data><data key="d1">and State of U.P. v. Amarmani Tripathi</data><data key="d2">1</data></node><node id="prec_1996_1_scc_667"><data key="d0">precedent</data><data key="d1">Salauddin Abdulsamad Shaikh v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_1998_9_scc_348"><data key="d0">precedent</data><data key="d1">Verma v. State</data><data key="d2">1</data></node><node id="prec_2004_7_scc_558"><data key="d0">precedent</data><data key="d1">Verma v. State</data><data key="d2">1</data></node><node id="prec_air_1960_sc_1125"><data key="d0">precedent</data><data key="d1">person released on bail by invoking the principle stated by this Court in State of U.P. v. Deoman Upadhyaya</data><data key="d2">1</data></node><node id="prec_2019_scc_online_del_11829"><data key="d0">precedent</data><data key="d1">2019 SCC OnLine Del 11829</data><data key="d2">1</data></node><node id="prec_2019_scc_online_sc_825"><data key="d0">precedent</data><data key="d1">Pradeep Ram v. State of Jharkhand</data><data key="d2">1</data></node><node id="prec_2021_dhc_1965"><data key="d0">precedent</data><data key="d1">He has relied on the judgment of Arvind Yadav In JC Through His Pairokar v. Govt Of NCT Delhi Through Standing Counsel in BAIL APPLN</data><data key="d2">1</data></node><node id="prec_2011_15_scc_1"><data key="d0">precedent</data><data key="d1">Anr. v. State of Manipur</data><data key="d2">1</data></node><node id="prec_air_1993_sc_1456"><data key="d0">precedent</data><data key="d1">He states the procedure of sampling has to be done in accordance with the directions given by Apex Court in Gaunter Edwin Kircher versus State of Goa</data><data key="d2">1</data></node><node id="prec_air_1961_sc_1527"><data key="d0">precedent</data><data key="d1">This principle has been followed by the Judicial Committee of the Privy Council in Nazir Ahmad v. Emperor</data><data key="d2">1</data></node><node id="prec_1969_2_scc_131"><data key="d0">precedent</data><data key="d1">(1969) 2 SCC 131</data><data key="d2">1</data></node><node id="prec_1972_1_scc_618"><data key="d0">precedent</data><data key="d1">(1972) 1 SCC 618</data><data key="d2">1</data></node><node id="prec_2018_16_scc_632"><data key="d0">precedent</data><data key="d1">(2018) 16 SCC 632</data><data key="d2">1</data></node><node id="prec_2007_6_scc_1"><data key="d0">precedent</data><data key="d1">(2007) 6 SCC 1</data><data key="d2">1</data></node><node id="prec_2011_4_scc_85"><data key="d0">precedent</data><data key="d1">(2011) 4 SCC 85</data><data key="d2">1</data></node><node id="prec_air_1978_del_250"><data key="d0">precedent</data><data key="d1">Diplock in Erwen Warnink BV v. J.Townend</data><data key="d2">1</data></node><node id="prec_2009_160_dlt_417"><data key="d0">precedent</data><data key="d1">2009 (160) DLT 417</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_3370"><data key="d0">precedent</data><data key="d1">2022 SCC OnLine Del 3370</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_1492"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine Del 1492</data><data key="d2">1</data></node><node id="prec_2023_dhc_2816"><data key="d0">precedent</data><data key="d1">2023:DHC:2816</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_901"><data key="d0">precedent</data><data key="d1">Infrastructure Development Corpn. Ltd. v. Well Protect Manpower Services</data><data key="d2">1</data></node><node id="prec_2023_dhc_4948"><data key="d0">precedent</data><data key="d1">Padmvati Investment Ltd. Vs. Govt. of NCT of Delhi</data><data key="d2">1</data></node><node id="prec_2008_12_scc_481"><data key="d0">precedent</data><data key="d1">Sharma v. SAIL</data><data key="d2">1</data></node><node id="prec_2010_14_scc_38"><data key="d0">precedent</data><data key="d1">ble Supreme Court in the case of Ramjas Foundation v. Union of India</data><data key="d2">1</data></node><node id="prec_2006_2_scc_541"><data key="d0">precedent</data><data key="d1">ble Supreme Court in the case of Ram Saran v. IG of Police</data><data key="d2">1</data></node><node id="prec_2003_6_scc_230"><data key="d0">precedent</data><data key="d1">ble Supreme Court in the case of Dwarka Prasad Agarwal v. B.D. Agarwal</data><data key="d2">1</data></node><node id="prec_1994_1_scc_1"><data key="d0">precedent</data><data key="d1">Chengalvaraya Naidu v. Jagannath and Ors</data><data key="d2">1</data></node><node id="prec_2003_8_scc_319"><data key="d0">precedent</data><data key="d1">ble Supreme Court in the case of Ram Chandra Singh v. Savitri Devi</data><data key="d2">1</data></node><node id="prec_2005_7_scc_605"><data key="d0">precedent</data><data key="d1">ble Supreme Court in the case of BhauraoDagduParalkar v. State of Maharashtra and Ors</data><data key="d2">1</data></node><node id="prec_1996_5_scc_550"><data key="d0">precedent</data><data key="d1">and Indian Bank v. Satyam Fibres</data><data key="d2">1</data></node><node id="prec_air_1963_sc_1572"><data key="d0">precedent</data><data key="d1">and Indian Bank v. Satyam Fibres</data><data key="d2">1</data></node><node id="prec_2008_scc_online_sc_1025"><data key="d0">precedent</data><data key="d1">Sharma v. SAIL</data><data key="d2">1</data></node><node id="prec_2022_11_scc_549"><data key="d0">precedent</data><data key="d1">(2022) 11 SCC 549</data><data key="d2">1</data></node><node id="prec_2017_9_scc_611"><data key="d0">precedent</data><data key="d1">(2017) 9 SCC 611</data><data key="d2">1</data></node><node id="prec_2009_12_scc_26"><data key="d0">precedent</data><data key="d1">In Sayeed Ahmed and Co. v. State of U.P</data><data key="d2">1</data></node><node id="prec_1992_1_scc_508"><data key="d0">precedent</data><data key="d1">(1992) 1 SCC 508</data><data key="d2">1</data></node><node id="prec_2022_2_scc_331"><data key="d0">precedent</data><data key="d1">(2022) 2 SCC 331</data><data key="d2">1</data></node><node id="prec_2021_scc_online_sc_855"><data key="d0">precedent</data><data key="d1">2021 SCC OnLine SC 855</data><data key="d2">1</data></node><node id="prec_2017_scc_online_sc_2075"><data key="d0">precedent</data><data key="d1">2017 SCC OnLine SC 2075</data><data key="d2">1</data></node><node id="prec_2021_scc_online_del_5434"><data key="d0">precedent</data><data key="d1">National Highways Authority of India vs. M. Hakeem and Another6</data><data key="d2">1</data></node><node id="prec_2023_dhc_001487"><data key="d0">precedent</data><data key="d1">2023/DHC/001487</data><data key="d2">1</data></node><node id="prec_1999_9_scc_449"><data key="d0">precedent</data><data key="d1">In Arosan Enterprises Ltd. v. Union of India</data><data key="d2">1</data></node><node id="prec_2002_4_scc_45"><data key="d0">precedent</data><data key="d1">Anr. vs. Sarvesh Chopra</data><data key="d2">1</data></node><node id="prec_2015_2_scc_189"><data key="d0">precedent</data><data key="d1">Ltd. vs. Governor</data><data key="d2">1</data></node><node id="prec_2019_8_scc_726"><data key="d0">precedent</data><data key="d1">Chandigarh vs. Kalsi Construction Company</data><data key="d2">1</data></node><node id="prec_1986_3_scc_156"><data key="d0">precedent</data><data key="d1">In the case of Central Inland Water Transport Corporation Ltd. vs. Brojo Nath Ganguly</data><data key="d2">1</data></node><node id="prec_2018_3_scc_133"><data key="d0">precedent</data><data key="d1">in Maharashtra State Electricity Distribution Co. Ltd. v. Datar Switchgear Ltd</data><data key="d2">1</data></node><node id="prec_air_1963_sc_1405"><data key="d0">precedent</data><data key="d1">AIR 1963 SC 1405</data><data key="d2">1</data></node><node id="prec_1999_scc_online_sc_928"><data key="d0">precedent</data><data key="d1">In Arosan Enterprises Ltd. v. Union of India</data><data key="d2">1</data></node><node id="prec_2023_dhc_000323"><data key="d0">precedent</data><data key="d1">2023/DHC/000323</data><data key="d2">1</data></node><node id="prec_2015_1_scc_32"><data key="d0">precedent</data><data key="d1">(2015) 1 SCC 32</data><data key="d2">1</data></node><node id="prec_2000_4_scc_539"><data key="d0">precedent</data><data key="d1">It was held in P. Anand Gajapathi Raju v. P.V.G. Raju</data><data key="d2">1</data></node><node id="prec_1972_1_scc_702"><data key="d0">precedent</data><data key="d1">and Guru Nanak Foundation v. Rattan Singh</data><data key="d2">1</data></node><node id="prec_2004_1_scc_540"><data key="d0">precedent</data><data key="d1">Act. These judgments were distinguished in National Aluminium Co. Ltd. v. Pressteel</data><data key="d2">1</data></node><node id="prec_2008_6_scc_732"><data key="d0">precedent</data><data key="d1">Act. These judgments were distinguished in National Aluminium Co. Ltd. v. Pressteel</data><data key="d2">1</data></node><node id="prec_2008_6_scc_741"><data key="d0">precedent</data><data key="d1">judgments were distinguished in National Aluminium Co. Ltd. v. Pressteel</data><data key="d2">1</data></node><node id="prec_2006_11_scc_521"><data key="d0">precedent</data><data key="d1">see JSW Steel Ltd. v. Jindal Praxair Oxygen Co. Ltd</data><data key="d2">1</data></node><node id="prec_2019_13_scc_472"><data key="d0">precedent</data><data key="d1">it would be pertinent to note that both the aforenoted judgments were considered by the Supreme Court in Cheran Properties Ltd. v. Kasturi</data><data key="d2">1</data></node><node id="prec_2018_16_scc_413"><data key="d0">precedent</data><data key="d1">Division Bench of our Court in Union of India v. Atlanta Ltd.12</data><data key="d2">1</data></node><node id="prec_1970_3_scc_440"><data key="d0">precedent</data><data key="d1">can be made to Prem Lata Agarwal v. Laxman Prasad Gupta</data><data key="d2">1</data></node><node id="prec_1992_3_scc_159"><data key="d0">precedent</data><data key="d1">can be made to Prem Lata Agarwal v. Laxman Prasad Gupta</data><data key="d2">1</data></node><node id="prec_2012_9_scc_552"><data key="d0">precedent</data><data key="d1">Balco v. Kaiser Aluminium Technical Services Inc</data><data key="d2">1</data></node><node id="prec_2017_7_scc_678"><data key="d0">precedent</data><data key="d1">Ltd. v. Datawind Innovations</data><data key="d2">1</data></node><node id="prec_2013_9_scc_32"><data key="d0">precedent</data><data key="d1">Ltd. v. Indian Oil Corpn. Ltd</data><data key="d2">1</data></node><node id="prec_2015_12_scc_225"><data key="d0">precedent</data><data key="d1">Simoese Von Staraburg Niedenthal v. Chhattisgarh Investment Ltd</data><data key="d2">1</data></node><node id="prec_2020_5_scc_462"><data key="d0">precedent</data><data key="d1">This judgment has recently been followed in Brahmani River Pellets Ltd. v. Kamachi Industries Ltd</data><data key="d2">1</data></node><node id="prec_2014_5_scc_1"><data key="d0">precedent</data><data key="d1">Ltd. v. Enercon GmbH</data><data key="d2">1</data></node><node id="prec_2019_4_scc_401"><data key="d0">precedent</data><data key="d1">Metal Inc. v. Hindustan Copper Ltd</data><data key="d2">1</data></node><node id="prec_2017_2_scc_228"><data key="d0">precedent</data><data key="d1">Metal Inc. v. Hindustan Copper Ltd</data><data key="d2">1</data></node><node id="prec_2015_2_scc_52"><data key="d0">precedent</data><data key="d1">Union of India v. U.P. State Bridge Corpn. Ltd</data><data key="d2">1</data></node><node id="prec_air_2015_del_100"><data key="d0">precedent</data><data key="d1">ICI-SOMA JV v. Simplex Infrastructures Ltd</data><data key="d2">1</data></node><node id="prec_2012_scc_online_del_1224"><data key="d0">precedent</data><data key="d1">rms that the view taken by this Court in Daelim Industrial Co. Ltd. supra has been approved. The said view has since also been consistently followed in other dicta of this Court. Reference may be made to Religare Finvest Ltd. v. Ranjit Singh Chouhan</data><data key="d2">1</data></node><node id="prec_2016_scc_online_del_5315"><data key="d0">precedent</data><data key="d1">Mukesh Sharma v. Roger Shashoua</data><data key="d2">1</data></node><node id="prec_2018_scc_online_del_13202"><data key="d0">precedent</data><data key="d1">Trading Corporation of India Ltd. v. Global Steel Holdings Ltd. AIR</data><data key="d2">1</data></node><node id="prec_2021_scc_online_del_3500"><data key="d0">precedent</data><data key="d1">can be made to Prem Lata Agarwal v. Laxman Prasad Gupta</data><data key="d2">1</data></node><node id="prec_1995_scc_online_del_240"><data key="d0">precedent</data><data key="d1">nk of India v. Indexport Registered</data><data key="d2">1</data></node><node id="prec_2016_scc_online_del_3744"><data key="d0">precedent</data><data key="d1">Ltd. v. Indus Mobile Distribution</data><data key="d2">1</data></node><node id="prec_2019_scc_online_sc_929"><data key="d0">precedent</data><data key="d1">This judgment has recently been followed in Brahmani River Pellets Ltd. v. Kamachi Industries Ltd</data><data key="d2">1</data></node><node id="prec_2018_scc_online_del_9338"><data key="d0">precedent</data><data key="d1">Antrix Corpn. Ltd. v. Devas Multimedia</data><data key="d2">1</data></node><node id="prec_1997_4_scc_257"><data key="d0">precedent</data><data key="d1">the learned counsel placed reliance upon Physical Research Laboratory v. K.G. Sharma</data><data key="d2">1</data></node><node id="prec_2011_4_scc_200"><data key="d0">precedent</data><data key="d1">drawn attention of this court towards the judgement delivered in Union of India v. Vartak Labour Union</data><data key="d2">1</data></node><node id="prec_2002_5_scc_654"><data key="d0">precedent</data><data key="d1">the apex court relied upon State of Karnataka v. Umadevi</data><data key="d2">1</data></node><node id="prec_1975_2_scc_847"><data key="d0">precedent</data><data key="d1">ble Supreme Court in the judgement delivered in Workmen v. Indian Standards Institution</data><data key="d2">1</data></node><node id="prec_1972_1_scc_40"><data key="d0">precedent</data><data key="d1">Management of F.I.C.C.I. v. Workmen</data><data key="d2">1</data></node><node id="prec_air_1963_sc_1873"><data key="d0">precedent</data><data key="d1">University of Delhi v. Ramlfath</data><data key="d2">1</data></node><node id="prec_2012_scc_online_del_4852"><data key="d0">precedent</data><data key="d1">ble Court in Indian Medical Association v. PO Labour Court-I</data><data key="d2">1</data></node><node id="prec_2023_dhc_3085"><data key="d0">precedent</data><data key="d1">2023:DHC:3085</data><data key="d2">1</data></node><node id="prec_2014_8_scc_319"><data key="d0">precedent</data><data key="d1">Rajasthan Vs. Binani Cements Limited and Another</data><data key="d2">1</data></node><node id="prec_2017_10_scc_800"><data key="d0">precedent</data><data key="d1">The Supreme Court of India in another writ petition filed by the petitioner in Independent Thought vs. Union of India</data><data key="d2">1</data></node><node id="prec_2023_dhc_3418"><data key="d0">precedent</data><data key="d1">2023:DHC:3418</data><data key="d2">1</data></node><node id="prec_1999_7_scc_1"><data key="d0">precedent</data><data key="d1">(1999) 7 SCC 1</data><data key="d2">1</data></node><node id="prec_1989_3_scc_251"><data key="d0">precedent</data><data key="d1">(1989) 3 SCC 251</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_3094"><data key="d0">precedent</data><data key="d1">2022 SCC OnLine Del 3094</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_2133"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine Del 2133</data><data key="d2">1</data></node><node id="prec_2017_scc_online_del_13008"><data key="d0">precedent</data><data key="d1">2017 SCC OnLine Del 13008</data><data key="d2">1</data></node><node id="prec_2013_scc_online_del_1513"><data key="d0">precedent</data><data key="d1">2013 SCC OnLine Del 1513</data><data key="d2">1</data></node><node id="prec_2023_dhc_3429"><data key="d0">precedent</data><data key="d1">2023:DHC:3429</data><data key="d2">1</data></node><node id="prec_2023_dhc_2436"><data key="d0">precedent</data><data key="d1">Riyazuddin v. State NCT of Delhi</data><data key="d2">1</data></node><node id="prec_2022_dhc_963"><data key="d0">precedent</data><data key="d1">Suraj v. State of Delhi NCT</data><data key="d2">1</data></node><node id="prec_2007_8_scc_770"><data key="d0">precedent</data><data key="d1">The decisions rendered in Dinesh Dalmia v. CBI</data><data key="d2">1</data></node><node id="prec_2014_16_scc_543"><data key="d0">precedent</data><data key="d1">The decisions rendered in Dinesh Dalmia v. CBI</data><data key="d2">1</data></node><node id="prec_1980_3_scc_152"><data key="d0">precedent</data><data key="d1">decision of the Supreme Court reported in Satya Narain v. State of Bihar</data><data key="d2">1</data></node><node id="prec_1971_2_scc_654"><data key="d0">precedent</data><data key="d1">Vide Darshan Singh Ram Kishan v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_air_1962_sc_1559"><data key="d0">precedent</data><data key="d1">See also Pukhraj v. D.R. Kohli</data><data key="d2">1</data></node><node id="prec_air_2001_sc_1919"><data key="d0">precedent</data><data key="d1">After considering the decision of the Hon'ble Supreme Court in Uday Mohanlal Acharya v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_air_1980_sc_506"><data key="d0">precedent</data><data key="d1">decision of the Supreme Court reported in Satya Narain v. State of Bihar</data><data key="d2">1</data></node><node id="prec_2020_scc_online_sc_529"><data key="d0">precedent</data><data key="d1">2020 SCC OnLine SC 529</data><data key="d2">1</data></node><node id="prec_2021_scc_online_sc_532"><data key="d0">precedent</data><data key="d1">judgment of the Hon'ble Supreme Court in Fakhrey Alam v. State of Uttar Pradesh</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_2073"><data key="d0">precedent</data><data key="d1">In Riyazuddin v. State NCT of Delhi</data><data key="d2">1</data></node><node id="prec_2018_9_scc_501"><data key="d0">precedent</data><data key="d1">Poonawalla v. Union of India</data><data key="d2">1</data></node><node id="prec_2015_6_scc_287"><data key="d0">precedent</data><data key="d1">ble Apex Court in case of Priyanka Srivastava v. State of Uttar Pradesh</data><data key="d2">1</data></node><node id="prec_2015_6_scc_439"><data key="d0">precedent</data><data key="d1">ble Supreme Court in case of Ramdev Foods Products Pvt. Ltd. v. State of Gujarat</data><data key="d2">1</data></node><node id="prec_2013_10_scc_705"><data key="d0">precedent</data><data key="d1">In the case of Anil Kumar. v. M.K. Aiyappa</data><data key="d2">1</data></node><node id="prec_1989_4_scc_630"><data key="d0">precedent</data><data key="d1">Ors. v. State of Haryana</data><data key="d2">1</data></node><node id="prec_2008_5_scc_662"><data key="d0">precedent</data><data key="d1">in S.K. Alagh v. State of U.P</data><data key="d2">1</data></node><node id="prec_2010_scc_online_del_2324"><data key="d0">precedent</data><data key="d1">This Court in Subhkaran Luharuka v. State</data><data key="d2">1</data></node><node id="prec_2010_scc_online_del_1053"><data key="d0">precedent</data><data key="d1">Salim v. State</data><data key="d2">1</data></node><node id="prec_2013_scc_online_del_2553"><data key="d0">precedent</data><data key="d1">This Court in Gurdeep Singh Sudan v. State</data><data key="d2">1</data></node><node id="prec_2012_scc_online_del_175"><data key="d0">precedent</data><data key="d1">In Om Prakash v. State</data><data key="d2">1</data></node><node id="prec_2008_scc_online_del_530"><data key="d0">precedent</data><data key="d1">This Court in Harpal Singh Arora v. State</data><data key="d2">1</data></node><node id="prec_1987_2_scc_197"><data key="d0">precedent</data><data key="d1">(1987) 2 SCC 197</data><data key="d2">1</data></node><node id="prec_2007_4_scc_171"><data key="d0">precedent</data><data key="d1">(2007) 4 SCC 171</data><data key="d2">1</data></node><node id="prec_2014_11_scc_282"><data key="d0">precedent</data><data key="d1">(2014) 11 SCC 282</data><data key="d2">1</data></node><node id="prec_2022_12_scc_753"><data key="d0">precedent</data><data key="d1">ble Supreme Court in Kavitha Lankesh v. State of Karnataka and Others</data><data key="d2">1</data></node><node id="prec_2007_3_scc_633"><data key="d0">precedent</data><data key="d1">Asrani v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_2021_scc_online_sc_50"><data key="d0">precedent</data><data key="d1">learned senior counsel has placed reliance upon UOI vs. KA Najeeb</data><data key="d2">1</data></node><node id="prec_2023_dhc_2608"><data key="d0">precedent</data><data key="d1">2023:DHC:2608</data><data key="d2">1</data></node><node id="prec_2006_8_scc_726"><data key="d0">precedent</data><data key="d1">gments of the Supreme Court in Amritdhara Pharmacy v. Satya Deo Gupta</data><data key="d2">1</data></node><node id="prec_2015_scc_online_del_10164"><data key="d0">precedent</data><data key="d1">2015 SCC OnLine Del 10164</data><data key="d2">1</data></node><node id="prec_2014_scc_online_del_3412"><data key="d0">precedent</data><data key="d1">Distillers Pvt. Ltd. vs. Shree Nath Heritage Liquor Pvt. Ltd</data><data key="d2">1</data></node><node id="prec_1999_scc_online_del_27"><data key="d0">precedent</data><data key="d1">dictionary meaning. Reliance is placed on the judgments of this Court in Bata India Limited v. Chawla Boot House</data><data key="d2">1</data></node><node id="prec_2021_scc_online_del_2635"><data key="d0">precedent</data><data key="d1">Reliance was placed on the judgment in PhonePe Private Limited v. EZY Services and Another</data><data key="d2">1</data></node><node id="prec_2002_scc_online_del_646"><data key="d0">precedent</data><data key="d1">Reliance was placed on the judgment of this Court in Pernod Ricard India Private Limited v. Frost Falcon Distilleries Limited</data><data key="d2">1</data></node><node id="prec_2013_scc_online_del_605"><data key="d0">precedent</data><data key="d1">Inc. v. Rajesh Bharti</data><data key="d2">1</data></node><node id="prec_2001_scc_online_del_406"><data key="d0">precedent</data><data key="d1">Inc v. Bharat Malik</data><data key="d2">1</data></node><node id="prec_1972_scc_online_del_141"><data key="d0">precedent</data><data key="d1">s. Atlas Cycle Industries Ltd. v. Hind Cycles Limited</data><data key="d2">1</data></node><node id="prec_2006_scc_online_del_1423"><data key="d0">precedent</data><data key="d1">Reference may be made in this regard to the judgment in FMI Limited v. Ashok Jain</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_3018"><data key="d0">precedent</data><data key="d1">recent judgment in Dreams Lingerie Products v. Akash Chawdhary</data><data key="d2">1</data></node><node id="prec_1995_scc_online_del_268"><data key="d0">precedent</data><data key="d1">in Hitachi Ltd. v. Ajay Kr. Agarwal</data><data key="d2">1</data></node><node id="prec_2009_scc_online_del_3369"><data key="d0">precedent</data><data key="d1">In Bihar Tubes Ltd. v. Garg Ispat Ltd</data><data key="d2">1</data></node><node id="prec_2002_scc_online_del_998"><data key="d0">precedent</data><data key="d1">and Anr. v. Auto Link Sales Corporation</data><data key="d2">1</data></node><node id="prec_1997_scc_online_del_243"><data key="d0">precedent</data><data key="d1">To the same effect are the observations in Alfred Dunhill Limited v. Kartar Singh Makkar and Others</data><data key="d2">1</data></node><node id="prec_2002_scc_online_del_528"><data key="d0">precedent</data><data key="d1">Ram Rakhi v. Union of India</data><data key="d2">1</data></node><node id="prec_2012_2_scc_196"><data key="d0">precedent</data><data key="d1">and Bengal Waterproof Ltd. v. Bombay Waterproof Manufacturing Co.39</data><data key="d2">1</data></node><node id="prec_1997_1_scc_99"><data key="d0">precedent</data><data key="d1">aterproof Ltd. v. Bombay Waterproof Manufacturing Co.39</data><data key="d2">1</data></node><node id="prec_air_1971_sc_898"><data key="d0">precedent</data><data key="d1">AIR 1971 SC 898</data><data key="d2">1</data></node><node id="prec_2019_scc_online_del_8227"><data key="d0">precedent</data><data key="d1">2019 SCC OnLine Del 8227</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_153"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine Del 153</data><data key="d2">1</data></node><node id="prec_air_1963_cal_178"><data key="d0">precedent</data><data key="d1">AIR 1963 Cal 178</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_5823"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine Del 5823</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_1383"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine Del 1383</data><data key="d2">1</data></node><node id="prec_2023_dhc_2424"><data key="d0">precedent</data><data key="d1">2023:DHC:2424</data><data key="d2">1</data></node><node id="prec_2018_2_scc_534"><data key="d0">precedent</data><data key="d1">(2018) 2 SCC 534</data><data key="d2">1</data></node><node id="prec_2008_2_scc_302"><data key="d0">precedent</data><data key="d1">Process Engg. Co. vs. Solanki Traders in this regard</data><data key="d2">1</data></node><node id="prec_2007_6_scc_798"><data key="d0">precedent</data><data key="d1">Ltd. v. Kalinga Mining Corpn</data><data key="d2">1</data></node><node id="prec_2007_7_scc_125"><data key="d0">precedent</data><data key="d1">Ltd. v. Kalinga Mining Corpn</data><data key="d2">1</data></node><node id="prec_2004_9_scc_619"><data key="d0">precedent</data><data key="d1">Organisation v. Sumangal Services</data><data key="d2">1</data></node><node id="prec_air_1951_cal_156"><data key="d0">precedent</data><data key="d1">See Premraj Mundra v. Md. Manech Gazi</data><data key="d2">1</data></node><node id="prec_air_1998_delhi_397"><data key="d0">precedent</data><data key="d1">Global Company v. National Fertilizers Ltd</data><data key="d2">1</data></node><node id="pr