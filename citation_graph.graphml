ata></node><node id="prec_2008_5_scc_368"><data key="d0">precedent</data><data key="d1">See Animireddy Venkata Ramana v. Public Prosecutor</data><data key="d2">2</data></node><node id="prec_2002_4_scc_380"><data key="d0">precedent</data><data key="d1">In Khet Singh v. Union of India</data><data key="d2">2</data></node><node id="prec_2004_3_scc_453"><data key="d0">precedent</data><data key="d1">in the case of State of Punjab v. Makhan Chand</data><data key="d2">2</data></node><node id="prec_1979_4_scc_274"><data key="d0">precedent</data><data key="d1">and Remembrancer of Legal Affairs v. Anil Kumar Bhunja</data><data key="d2">2</data></node><node id="prec_2003_7_scc_465"><data key="d0">precedent</data><data key="d1">Madan Lal v. State of H.P</data><data key="d2">2</data></node><node id="prec_2015_6_scc_222"><data key="d0">precedent</data><data key="d1">Madan Lal v. State of H.P</data><data key="d2">2</data></node><node id="prec_2013_1_scc_395"><data key="d0">precedent</data><data key="d1">samples were drawn after mixing of the substance homogeneously and this procedure was found as due compliance as per mandate of judgment Sumit Tomar v. State of Punjab</data><data key="d2">2</data></node><node id="prec_2000_9_scc_549"><data key="d0">precedent</data><data key="d1">Chennai v. R. Paulsamy</data><data key="d2">2</data></node><node id="prec_air_1980_sc_52"><data key="d0">precedent</data><data key="d1">and Remembrancer of Legal Affairs v. Anil Kumar Bhunja</data><data key="d2">2</data></node><node id="prec_2015_scc_online_del_3860"><data key="d0">precedent</data><data key="d1">Edward Khimani Kamau v. The Narcotics Control Bureau</data><data key="d2">2</data></node><node id="prec_2020_scc_online_del_2128"><data key="d0">precedent</data><data key="d1">co-ordinate bench of this Court in Santini Simone v. Department of Customs</data><data key="d2">2</data></node><node id="prec_2018_scc_online_del_10564"><data key="d0">precedent</data><data key="d1">Basant Rai v. State</data><data key="d2">2</data></node><node id="prec_2021_scc_online_del_486"><data key="d0">precedent</data><data key="d1">In Ahmed Hassan Muhammed v. The Customs</data><data key="d2">2</data></node><node id="prec_2022_scc_online_del_4427"><data key="d0">precedent</data><data key="d1">in Laxman Thakur v. State</data><data key="d2">2</data></node><node id="prec_2022_scc_online_del_1160"><data key="d0">precedent</data><data key="d1">coordinate bench of this Court in Bipin Bihari Lenka v. Narcotics Control Bureau</data><data key="d2">2</data></node><node id="prec_2021_scc_online_del_3619"><data key="d0">precedent</data><data key="d1">in Arvind Yadav v. Govt. of NCT of Delhi Through Standing Counsel</data><data key="d2">2</data></node><node id="prec_1996_5_scc_714"><data key="d0">precedent</data><data key="d1">(1996) 5 SCC 714</data><data key="d2">2</data></node><node id="prec_1969_2_scc_727"><data key="d0">precedent</data><data key="d1">(1969) 2 SCC 727</data><data key="d2">2</data></node><node id="prec_2022_scc_online_del_2321"><data key="d0">precedent</data><data key="d1">In Sona BLW Precision Forgings Ltd v. Sonae EV Private Limited</data><data key="d2">2</data></node><node id="prec_2003_12_scc_91"><data key="d0">precedent</data><data key="d1">(2003) 12 SCC 91</data><data key="d2">2</data></node><node id="prec_2004_3_scc_553"><data key="d0">precedent</data><data key="d1">(2004) 3 SCC 553</data><data key="d2">2</data></node><node id="prec_2021_4_scc_379"><data key="d0">precedent</data><data key="d1">td. v. Singh Consultants</data><data key="d2">2</data></node><node id="prec_1986_1_scc_264"><data key="d0">precedent</data><data key="d1">of India v. Escorts Ltd</data><data key="d2">2</data></node><node id="prec_2008_2_scc_444"><data key="d0">precedent</data><data key="d1">i. J. C. Budhraja v. Chairman</data><data key="d2">2</data></node><node id="prec_2011_5_scc_758"><data key="d0">precedent</data><data key="d1">Engineers Private Limited v. Union of India</data><data key="d2">2