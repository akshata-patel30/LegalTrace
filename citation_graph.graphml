 key="d1">Ltd. v. State of Bihar</data><data key="d2">1</data></node><node id="prec_2002_5_scc_510"><data key="d0">precedent</data><data key="d1">ITI Ltd. v. Siemens Public Communications Network Ltd</data><data key="d2">1</data></node><node id="prec_2004_3_scc_250"><data key="d0">precedent</data><data key="d1">MCD v. International Security</data><data key="d2">1</data></node><node id="prec_1976_3_scc_203"><data key="d0">precedent</data><data key="d1">In Narhari Shivram Shet Narvekar v. Pannalal Umediram</data><data key="d2">1</data></node><node id="prec_1971_1_scc_721"><data key="d0">precedent</data><data key="d1">In Narhari Shivram Shet Narvekar v. Pannalal Umediram</data><data key="d2">1</data></node><node id="prec_2010_2_scc_385"><data key="d0">precedent</data><data key="d1">judgments such as Union of India v. A.L. Rallia Ram</data><data key="d2">1</data></node><node id="prec_1969_2_scc_74"><data key="d0">precedent</data><data key="d1">Shankar Ramchandra Abhynkar v. KrishnajiDattatreya Bapat</data><data key="d2">1</data></node><node id="prec_2018_12_scc_471"><data key="d0">precedent</data><data key="d1">as stated in HRD Corpn. v. GAIL</data><data key="d2">1</data></node><node id="prec_2014_9_scc_263"><data key="d0">precedent</data><data key="d1">so as to narrow grounds of challenge available under the Act. The judgment in ONGC Ltd. v. Saw Pipes Ltd</data><data key="d2">1</data></node><node id="prec_air_1957_sc_540"><data key="d0">precedent</data><data key="d1">Garikapati Veeraya v. N. Subbiah Choudhry</data><data key="d2">1</data></node><node id="prec_air_1963_sc_1685"><data key="d0">precedent</data><data key="d1">judgments such as Union of India v. A.L. Rallia Ram</data><data key="d2">1</data></node><node id="prec_2017_scc_online_del_7684"><data key="d0">precedent</data><data key="d1">2017 SCC OnLine Del 7684</data><data key="d2">1</data></node><node id="prec_2008_scc_online_del_940"><data key="d0">precedent</data><data key="d1">In that sense it consolidates and amends the aforementioned Acts. The Supreme Court in its judgment in the case of Fuerst Day Lawson Ltd. v. Jindal Exports Ltd</data><data key="d2">1</data></node><node id="prec_2012_scc_online_del_4787"><data key="d0">precedent</data><data key="d1">In that sense it consolidates and amends the aforementioned Acts. The Supreme Court in its judgment in the case of Fuerst Day Lawson Ltd. v. Jindal Exports Ltd</data><data key="d2">1</data></node><node id="prec_2023_dhc_3659"><data key="d0">precedent</data><data key="d1">2023:DHC:3659</data><data key="d2">1</data></node><node id="prec_1971_3_scc_550"><data key="d0">precedent</data><data key="d1">Andhra Pradesh v. Taj Mahal Hotel</data><data key="d2">1</data></node><node id="prec_1983_4_scc_353"><data key="d0">precedent</data><data key="d1">Reliance placed by the Respondent on the judgments in Sreenivasa General Traders and Others v. State of Andhra Pradesh and Others</data><data key="d2">1</data></node><node id="prec_1995_1_scc_655"><data key="d0">precedent</data><data key="d1">Reliance placed by the Respondent on the judgments in Sreenivasa General Traders and Others v. State of Andhra Pradesh and Others</data><data key="d2">1</data></node><node id="prec_2012_1_scc_101"><data key="d0">precedent</data><data key="d1">Reliance placed by the Respondent on the judgments in Sreenivasa General Traders and Others v. State of Andhra Pradesh and Others</data><data key="d2">1</data></node><node id="prec_2013_10_scc_772"><data key="d0">precedent</data><data key="d1">Union of India and Another v. National Federation of the Blind and Others</data><data key="d2">1</data></node><node id="prec_2004_4_scc_766"><data key="d0">precedent</data><data key="d1">and Another v. Rawatmal Dugar</data><data key="d2">1</data></node><node id="prec_2003_2_scc_593"><data key="d0">precedent</data><data key="d1">Dayal Singh and Others v. Union of India and Others</data><data key="d2">1</data></node><node id="prec_1977_6_scc_312"><data key="d0">precedent</data><data key="d1">1977 6 SCC

312</data><data key="d2">1</data></node><node id="prec_1990_1_scc_277"><data key="d0">precedent</data><data key="d1">The view was reiterated in Union of India v. Filip Tiago De Gama of Vedem Vasco De Gama</data><data key="d2">1</data></node><node id="prec_1977_2_scc_273"><data key="d0">precedent</data><data key="d1">In D.R. Venkatachalam v. Dy. Transport Commr</data><data key="d2">1</data></node><node id="prec_2000_5_scc_511"><data key="d0">precedent</data><data key="d1">(2000) 5 SCC 511</data><data key="d2">1</data></node><node id="prec_2001_4_scc_534"><data key="d0">precedent</data><data key="d1">In Gurudevdatta VKSSS Maryadit v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_2005_10_scc_437"><data key="d0">precedent</data><data key="d1">In State of Jharkhand and Another v. Govind Singh</data><data key="d2">1</data></node><node id="prec_2007_8_scc_593"><data key="d0">precedent</data><data key="d1">AMU and Others v. K.S. Misra</data><data key="d2">1</data></node><node id="prec_2010_4_scc_653"><data key="d0">precedent</data><data key="d1">Shahabuddin v. State of Bihar and Others</data><data key="d2">1</data></node><node id="prec_2009_3_scc_553"><data key="d0">precedent</data><data key="d1">Industries Ltd. v. State of Haryana</data><data key="d2">1</data></node><node id="prec_2017_scc_online_del_11623"><data key="d0">precedent</data><data key="d1">Ors. v. Mr. Parth Solanki</data><data key="d2">1</data></node><node id="prec_2017_scc_online_del_11733"><data key="d0">precedent</data><data key="d1">Ors. v. Mr. Parth Solanki</data><data key="d2">1</data></node><node id="prec_2007_1_scc_338"><data key="d0">precedent</data><data key="d1">Govt. of A.P. and Ors. Vs. A. Venkata Raidu</data><data key="d2">1</data></node><node id="prec_2013_4_scc_301"><data key="d0">precedent</data><data key="d1">Jhala vs State of Gujarat</data><data key="d2">1</data></node><node id="prec_2006_5_scc_88"><data key="d0">precedent</data><data key="d1">Jhala vs State of Guja