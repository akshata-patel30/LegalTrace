 key="d0">precedent</data><data key="d1">In Shakti Vahini vs. Union of India</data><data key="d2">1</data></node><node id="prec_2018_7_scc_192"><data key="d0">precedent</data><data key="d1">In Shakti Vahini vs. Union of India</data><data key="d2">1</data></node><node id="prec_1970_1_scc_443"><data key="d0">precedent</data><data key="d1">(1970) 1 SCC 443</data><data key="d2">1</data></node><node id="prec_1977_4_scc_608"><data key="d0">precedent</data><data key="d1">In State of Karnataka vs. Union of India.108</data><data key="d2">1</data></node><node id="prec_1998_1_scc_226"><data key="d0">precedent</data><data key="d1">In Vineet Narain vs. Union of India.110</data><data key="d2">1</data></node><node id="prec_1996_6_scc_530"><data key="d0">precedent</data><data key="d1">(1996) 6 SCC 530</data><data key="d2">1</data></node><node id="prec_1996_6_scc_593"><data key="d0">precedent</data><data key="d1">(1996) 6 SCC 593</data><data key="d2">1</data></node><node id="prec_2018_8_scc_501"><data key="d0">precedent</data><data key="d1">(2018) 8 SCC 501</data><data key="d2">1</data></node><node id="prec_1981_1_scc_627"><data key="d0">precedent</data><data key="d1">(1981) 1 SCC 627</data><data key="d2">1</data></node><node id="prec_1984_3_scc_82"><data key="d0">precedent</data><data key="d1">(1984) 3 SCC 82</data><data key="d2">1</data></node><node id="prec_1985_4_scc_677"><data key="d0">precedent</data><data key="d1">MLA vs. State</data><data key="d2">1</data></node><node id="prec_1987_1_scc_265"><data key="d0">precedent</data><data key="d1">(1987) 1 SCC 265</data><data key="d2">1</data></node><node id="prec_1990_1_scc_422"><data key="d0">precedent</data><data key="d1">Hony. Secretary vs. State of vehicle. This led to his death. Bihar</data><data key="d2">1</data></node><node id="prec_1991_3_scc_482"><data key="d0">precedent</data><data key="d1">Hony. Secretary vs. State of vehicle. This led to his death. Bihar</data><data key="d2">1</data></node><node id="prec_1994_6_scc_565"><data key="d0">precedent</data><data key="d1">(1994) 6 SCC 565</data><data key="d2">1</data></node><node id="prec_1994_6_scc_205"><data key="d0">precedent</data><data key="d1">(1994) 6 SCC 205</data><data key="d2">1</data></node><node id="prec_1995_3_scc_702"><data key="d0">precedent</data><data key="d1">Inder Singh vs. State of</data><data key="d2">1</data></node><node id="prec_1996_4_scc_37"><data key="d0">precedent</data><data key="d1">(1996) 4 SCC 37</data><data key="d2">1</data></node><node id="prec_1997_1_scc_416"><data key="d0">precedent</data><data key="d1">D.K. Basu vs. State of W.B</data><data key="d2">1</data></node><node id="prec_1997_3_scc_433"><data key="d0">precedent</data><data key="d1">(1997) 3 SCC 433</data><data key="d2">1</data></node><node id="prec_2011_14_scc_481"><data key="d0">precedent</data><data key="d1">(2011) 14 SCC 481</data><data key="d2">1</data></node><node id="prec_2010_5_scc_600"><data key="d0">precedent</data><data key="d1">Khushboo vs. Kanniammal</data><data key="d2">1</data></node><node id="prec_2015_5_scc_1"><data key="d0">precedent</data><data key="d1">Recently in Shreya Singhal vs. Union of India</data><data key="d2">1</data></node><node id="prec_2006_8_scc_433"><data key="d0">precedent</data><data key="d1">in Directorate General of Doordarshan vs. Anand Patwardhan</data><data key="d2">1</data></node><node id="prec_1985_1_scc_641"><data key="d0">precedent</data><data key="d1">Pvt. Ltd. vs. Union of India</data><data key="d2">1</data></node><node id="prec_2014_5_scc_438"><data key="d0">precedent</data><data key="d1">vide National Legal Services Authority vs. Union of India</data><data key="d2">1</data></node><node id="prec_1982_1_scc_1"><data key="d0">precedent</data><data key="d1">vide National Legal Services Authority vs. Union of India</data><data key="d2">1</data></node><node id="prec_2018_10_scc_639"><data key="d0">precedent</data><data key="d1">vide National Legal Services Authority vs. Union of India</data><data key="d2">1</data></node><node id="prec_2015_1_scc_192"><data key="d0">precedent</data><data key="d1">In Charu Khurana vs. Union of India</data><data key="d2">1</data></node><node id="prec_1973_4_scc_225"><data key="d0">precedent</data><data key="d1">in His Holiness Kesavanada Bharati Sripadagalvaru vs. State of Kerala</data><data key="d2">1</data></node><node id="prec_2005_2_scc_436"><data key="d0">precedent</data><data key="d1">These observations are in consonance with the recognition by this Court in People's Union for Civil Liberties vs. Union of India</data><data key="d2">1</data></node><node id="prec_2005_5_scc_632"><data key="d0">precedent</data><data key="d1">In Zoroastrian Cooperative Housing Society Limited vs. District Registrar</data><data key="d2">1</data></node><node id="prec_2002_5_scc_111"><data key="d0">precedent</data><data key="d1">Pradeep Kumar Biswas vs. Indian Institute of Chemical Biology</data><data key="d2">1</data></node><node id="prec_2019_16_scc_303"><data key="d0">precedent</data><data key="d1">The decision of this Court in Ramakrishna Mission vs. Kago Kunya</data><data key="d2">1</data></node><node id="prec_2003_8_scc_342"><data key="d0">precedent</data><data key="d1">writ is issued as of right vide Union of India vs. Paul Manickam</data><data key="d2">1</data></node><node id="prec_2006_9_scc_364"><data key="d0">precedent</data><data key="d1">(2006) 9 SCC 364</data><data key="d2">1</data></node><node id="prec_2015_2_scc_130"><data key="d0">precedent</data><data key="d1">In Gaurav Kumar Bansal vs. Union of India</data><data key="d2">1</data></node><node id="prec_2016_7_scc_498"><data key="d0">precedent</data><data key="d1">in Swaraj Abhiyan vs. Union of India</data><data key="d2">1</data></node><node id="prec_1989_4_scc_730"><data key="d0">precedent</data><data key="d1">Hongray vs. Union of India</data><data key="d2">1</data></node><node id="prec_1991_2_scc_373"><data key="d0">precedent</data><data key="d1">Kumari vs. State of Tamil Nadu</data><data key="d2">1</data></node><node id="prec_1992_2_scc_223"><data key="d0">precedent</data><data key="d1">Kumari vs. State of Tamil Nadu</data><data key="d2">1</data></node><node id="prec_1995_2_scc_369"><data key="d0">precedent</data><data key="d1">Kumari vs. State of Tamil Nadu</data><data key="d2">1</data></node><node id="prec_2000_4_scc_543"><data key="d0">precedent</data><data key="d1">Kumari vs. State of Tamil Nadu</data><data key="d2">1</data></node><node id="prec_2004_6_scc_213"><data key="d0">precedent</data><data key="d1">in D.K.Basu vs. State of West Bengal</data><data key="d2">1</data></node><node id="prec_2011_8_scc_568"><data key="d0">precedent</data><data key="d1">In Delhi Jal Board vs. National Campaign for Dignity</data><data key="d2">1</data></node><node id="prec_air_1965_sc_1039"><data key="d0">precedent</data><data key="d1">AIR 1965 SC 1039</data><data key="d2">1</data></node><node id="prec_air_1987_sc_1086"><data key="d0">precedent</data><data key="d1">AIR 1987 SC 1086</data><data key="d2">1</data></node><node id="prec_air_1950_sc_124"><data key="d0">precedent</data><data key="d1">while upholding the challenge in Romesh Thappar vs. State of Madras45 held as follows</data><data key="d2">1</data></node><node id="prec_air_1950_sc_129"><data key="d0">precedent</data><data key="d1">the Constitution Bench of this Court also delivered another judgment in Brij Bhushan vs. The State of Delhi46. It also</data><data key="d2">1</data></node><node id="prec_air_1951_sc_301"><data key="d0">precedent</data><data key="d1">nan vs State of Madras83</data><data key="d2">1</data></node><node id="prec_air_1967_sc_1836"><data key="d0">precedent</data><data key="d1">AIR 1967 SC 1836</data><data key="d2">1</data></node><node id="prec_air_1954_sc_245"><data key="d0">precedent</data><data key="d1">has no application in India. This decision was followed in State of Rajasthan vs. Mst</data><data key="d2">1</data></node><node id="prec_air_1962_sc_933"><data key="d0">precedent</data><data key="d1">AIR 1962 SC 933</data><data key="d2">1</data></node><node id="prec_2019_6_scc_787"><data key="d0">precedent</data><data key="d1">(2019) 6 SCC 787</data><data key="d2">1</data></node><node id="prec_2013_6_scc_384"><data key="d0">precedent</data><data key="d1">Union of India v. Col</data><data key="d2">1</data></node><node id="prec_2009_12_scc_40"><data key="d0">precedent</data><data key="d1">Uma Nath Pandey and Ors v. State of Uttar Pradesh</data><data key="d2">1</data></node><node id="prec_1993_3_scc_259"><data key="d0">precedent</data><data key="d1">(1993) 3 SCC 259</data><data key="d2">1</data></node><node id="prec_2005_6_scc_321"><data key="d0">precedent</data><data key="d1">(2005) 6 SCC 321</data><data key="d2">1</data></node><node id="prec_1989_1_scc_229"><data key="d0">precedent</data><data key="d1">(1989) 1 SCC 229</data><data key="d2">1</data></node><node id="prec_2007_3_scc_587"><data key="d0">precedent</data><data key="d1">(2007) 3 SCC 587</data><data key="d2">1</data></node><node id="prec_1987_4_scc_431"><data key="d0">precedent</data><data key="d1">(1987) 4 SCC 431</data><data key="d2">1</data></node><node id="prec_1973_1_scc_380"><data key="d0">precedent</data><data key="d1">(1973) 1 SCC 380</data><data key="d2">1</data></node><node id="prec_1983_4_scc_166"><data key="d0">precedent</data><data key="d1">(1983) 4 SCC 166</data><data key="d2">1</data></node><node id="prec_2003_4_scc_364"><data key="d0">precedent</data><data key="d1">State of AP v. McDowell</data><data key="d2">1</data></node><node id="prec_2018_11_scc_1"><data key="d0">precedent</data><data key="d1">and observing that as per the decision of this Court in the case of Nikesh Tarachand Shah Vs. Unoin of India and Anr</data><data key="d2">1</data></node><node id="prec_2022_scc_online_sc_452"><data key="d0">precedent</data><data key="d1">It is submitted that subsequently in the case of The Asst. Director Enforcement Directorate Vs. Dr. V.C. Mohan</data><data key="d2">1</data></node><node id="prec_1977_4_scc_291"><data key="d0">precedent</data><data key="d1">Learned counsel for the appellant then relied on the decision of this Court in Kashmira Singh v. State of Punjab</data><data key="d2">1</data></node><node id="prec_1984_1_scc_284"><data key="d0">precedent</data><data key="d1">Learned counsel for the appellant then relied on the decision of this Court in Bhagirathsinh v. State of Gujarat</data><data key="d2">1</data></node><node id="prec_1996_2_scc_616"><data key="d0">precedent</data><data key="d1">Kumar v. State of U.P</data><data key="d2">1</data></node><node id="prec_2012_9_scc_446"><data key="d0">precedent</data><data key="d1">in the case of Ash Mohammad v. Shiv Raj Singh alias Lalla Babu and Another</data><data key="d2">1</data></node><node id="prec_1999_4_scc_421"><data key="d0">precedent</data><data key="d1">In Bhagwan Rama Shinde Gosai and Others v. State of Gujarat</data><data key="d2">1</data></node><node id="prec_2008_5_scc_230"><data key="d0">precedent</data><data key="d1">In Sidhartha Vashisht alias Manu Sharma v. State</data><data key="d2">1</data></node><node id="prec_2002_9_scc_364"><data key="d0">precedent</data><data key="d1">(2002) 9 SCC 364</data><data key="d2">1</data></node><node id="prec_2004_6_scc_175"><data key="d0">precedent</data><data key="d1">(2004) 6 SCC 175</data><data key="d2">1</data></node><node id="prec_2014_9_scc_177"><data key="d0">precedent</data><data key="d1">In the case of Atul Tripathi v. State of Uttar Pradesh and Others</data><data key="d2">1</data></node><node id="prec_2004_7_scc_638"><data key="d0">precedent</data><data key="d1">In Kishori Lal v. Rupa and Others</data><data key="d2">1</data></node><node id="prec_2002_9_scc_366"><data key="d0">precedent</data><data key="d1">In Vijay Kumar v. Narendra and Others reported in</data><data key="d2">1</data></node><node id="prec_2005_5_scc_281"><data key="d0">precedent</data><data key="d1">The aforesaid view is reiterated by this Court in the case of Vasant Tukaram Pawar v. State of Maharashtra reported in</data><data key="d2">1</data></node><node id="prec_2007_11_scc_160"><data key="d0">precedent</data><data key="d1">The aforesaid view is reiterated by this Court in the case of Vasant Tukaram Pawar v. State of Maharashtra reported in</data><data key="d2">1</data></node><node id="prec_1982_3_scc_140"><data key="d0">precedent</data><data key="d1">(1982) 3 SCC 140</data><data key="d2">1</data></node><node id="prec_2015_6_scc_773"><data key="d0">precedent</data><data key="d1">(2015) 6 SCC 773</data><data key="d2">1</data></node><node id="prec_air_1973_sc_1461"><data key="d0">precedent</data><data key="d1">AIR 1973 SC 1461</data><data key="d2">1</data></node><node id="prec_2013_11_scc_673"><data key="d0">precedent</data><data key="d1">(2013) 11 SCC 673</data><data key="d2">1</data></node><node id="prec_2015_8_scc_293"><data key="d0">precedent</data><data key="d1">(2015) 8 SCC 293</data><data key="d2">1</data></node><node id="prec_2021_5_scc_524"><data key="d0">precedent</data><data key="d1">In the decision in State of Haryana v. Bhajan Lal4</data><data key="d2">1</data></node><node id="prec_air_1992_sc_604"><data key="d0">precedent</data><data key="d1">AIR 1992 SC 604</data><data key="d2">1</data></node><node id="prec_1974_1_scc_258"><data key="d0">precedent</data><data key="d1">Karthikeyan vs. State of Kerala</data><data key="d2">1</data></node><node id="prec_1999_4_scc_630"><data key="d0">precedent</data><data key="d1">vide State of Tamil Nadu vs. Board of Trustees of the Port of Madras</data><data key="d2">1</data></node><node id="prec_2002_4_scc_57"><data key="d0">precedent</data><data key="d1">vide State of Tamil Nadu vs. Board of Trustees of the Port of Madras</data><data key="d2">1</data></node><node id="prec_1985_2_scc_197"><data key="d0">precedent</data><data key="d1">State of Himachal Pradesh vs. Yash Pal Garg</data><data key="d2">1</data></node><node id="prec_2003_9_scc_92"><data key="d0">precedent</data><data key="d1">State of Himachal Pradesh vs. Yash Pal Garg</data><data key="d2">1</data></node><node id="prec_1985_4_scc_124"><data key="d0">precedent</data><data key="d1">ii. In Hindustan Gum and Chemicals Ltd. vs. State of Haryana</data><data key="d2">1</data></node><node id="prec_1997_1_scc_326"><data key="d0">precedent</data><data key="d1">Constitution Bench of this Court in State of Tamil Nadu vs. Arooran Sugars Ltd</data><data key="d2">1</data></node><node id="prec_2003_5_scc_298"><data key="d0">precedent</data><data key="d1">v. In Bakhtawar Trust vs. M.D. Narayan</data><data key="d2">1</data></node><node id="prec_2017_1_scc_283"><data key="d0">precedent</data><data key="d1">In Cheviti Venkanna Yadav vs. State of Telangana</data><data key="d2">1</data></node><node id="prec_1985_2_scc_1987"><data key="d0">precedent</data><data key="d1">and Anr. v. Union of India and Ors</data><data key="d2">1</data></node><node id="prec_1995_6_scc_16"><data key="d0">precedent</data><data key="d1">Bhagwat and Ors. v. State of Mysore</data><data key="d2">1</data></node><node id="prec_2019_13_scc_185"><data key="d0">precedent</data><data key="d1">and Medical Council of India v. State of Kerala and Ors</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_79"><data key="d0">precedent</data><data key="d1">State of Himachal Pradesh vs. Yash Pal Garg</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_813"><data key="d0">precedent</data><data key="d1">recent judgment of this Court in the case of Dr. Jaya Thakur vs. Union of India</data><data key="d2">1</data></node><node id="prec_2020_14_scc_643"><data key="d0">precedent</data><data key="d1">Relying on the decision of this Court in the case of Geo Miller and Company Private Limited v. Chairman</data><data key="d2">1</data></node><node id="prec_2022_3_scc_117"><data key="d0">precedent</data><data key="d1">(2022) 3 SCC 117</data><data key="d2">1</data></node><node id="prec_2008_7_scc_169"><data key="d0">precedent</data><data key="d1">decision of this Court in the case of Consolidated Engineering Enterprises v. Principal Secretary</data><data key="d2">1</data></node><node id="prec_1988_3_scc_76"><data key="d0">precedent</data><data key="d1">(1988) 3 SCC 76</data><data key="d2">1</data></node><node id="prec_1988_2_scc_338"><data key="d0">precedent</data><data key="d1">of the view that the High Court was right in this case. See in this connection the observations of this Court in Inder Singh Rekhi v. D.D.A</data><data key="d2">1</data></node><node id="prec_1993_4_scc_338"><data key="d0">precedent</data><data key="d1">Inder Singh Rekhi v. DDA</data><data key="d2">1</data></node><node id="prec_1999_2_scc_571"><data key="d0">precedent</data><data key="d1">Inder Singh Rekhi v. DDA</data><data key="d2">1</data></node><node id="prec_1989_4_scc_582"><data key="d0">precedent</data><data key="d1">Rathore v. State of M.P</data><data key="d2">1</data></node><node id="prec_2010_1_scc_394"><data key="d0">precedent</data><data key="d1">Rathore v. State of M.P</data><data key="d2">1</data></node><node id="prec_2020_5_scc_185"><data key="d0">precedent</data><data key="d1">S.S. Rathore v. State of M.P</data><data key="d2">1</data></node><node id="prec_2006_4_scc_658"><data key="d0">precedent</data><data key="d1">In Hari Shankar Singhania v. Gaur Hari Singhania</data><data key="d2">1</data></node><node id="prec_1996_2_scc_216"><data key="d0">precedent</data><data key="d1">State of Orissa v. Damodar Das</data><data key="d2">1</data></node><node id="prec_air_1988_sc_1887"><data key="d0">precedent</data><data key="d1">Inder Singh Rekhi v. Delhi Development Authority reported in AIR</data><data key="d2">1</data></node><node id="prec_air_1978_cal_228"><data key="d0">precedent</data><data key="d1">It appears that these questions were discussed in the decision of the Calcutta High Court in Jiwnani Engineering Works Pvt. Ltd. v. Union of India</data><data key="d2">1</data></node><node id="prec_air_1924_cal_600"><data key="d0">precedent</data><data key="d1">in Dwijendra Narain Roy v. Joges Chandra De and others</data><data key="d2">1</data></node><node id="prec_1991_1_scc_476"><data key="d0">precedent</data><data key="d1">(1991) 1 SCC 476</data><data key="d2">1</data></node><node id="prec_2020_16_scc_127"><data key="d0">precedent</data><data key="d1">(2020) 16 SCC 127</data><data key="d2">1</data></node><node id="prec_1969_3_scc_400"><data key="d0">precedent</data><data key="d1">(1969) 3 SCC 400</data><data key="d2">1</data></node><node id="prec_1970_1_scc_219"><data key="d0">precedent</data><data key="d1">(1970) 1 SCC 219</data><data key="d2">1</data></node><node id="prec_1969_1_scc_433"><data key="d0">precedent</data><data key="d1">Abdul Karim v. State of W.B</data><data key="d2">1</data></node><node id="prec_1980_2_scc_275"><data key="d0">precedent</data><data key="d1">in the case of Francis Coralie Mullin v. W.C. Khambra</data><data key="d2">1</data></node><node id="prec_1995_4_scc_51"><data key="d0">precedent</data><data key="d1">(1995) 4 SCC 51</data><data key="d2">1</data></node><node id="prec_1992_4_scc_305"><data key="d0">precedent</data><data key="d1">one of which is by the complainant V. Ganesh Kumar in FIR No.298 of</data><data key="d2">1</data></node><node id="prec_1992_4_scc_653"><data key="d0">precedent</data><data key="d1">one of which is by the complainant V. Ganesh Kumar in FIR No.298 of</data><data key="d2">1</data></node><node id="prec_2007_1_scc_732"><data key="d0">precedent</data><data key="d1">(2007) 1 SCC 732</data><data key="d2">1</data></node><node id="prec_2023_3_scc_315"><data key="d0">precedent</data><data key="d1">(2023) 3 SCC 315</data><data key="d2">1</data></node><node id="prec_1970_3_scc_881"><data key="d0">precedent</data><data key="d1">the learned senior counsel relies upon the decision of the Delhi High Court in Enforcement Directorate vs. Gagandeep Singh18 and Parvathi Kollur vs. State</data><data key="d2">1</data></node><node id="prec_2020_9_scc_121"><data key="d0">precedent</data><data key="d1">(2020) 9 SCC 121</data><data key="d2">1</data></node><node id="prec_2000_8_scc_395"><data key="d0">precedent</data><data key="d1">(2000) 8 SCC 395</data><data key="d2">1</data></node><node id="prec_2001_10_scc_191"><data key="d0">precedent</data><data key="d1">(2001) 10 SCC 191</data><data key="d2">1</data></node><node id="prec_2011_14_scc_770"><data key="d0">precedent</data><data key="d1">(2011) 14 SCC 770</data><data key="d2">1</data></node><node id="prec_2004_5_scc_518"><data key="d0">precedent</data><data key="d1">(2004) 5 SCC 518</data><data key="d2">1</data></node><node id="prec_air_1967_sc_389"><data key="d0">precedent</data><data key="d1">AIR 1967 SC 389</data><data key="d2">1</data></node><node id="prec_2022_scc_online_sc_1186"><data key="d0">precedent</data><data key="d1">2022 SCC OnLine SC 1186</data><data key="d2">1</data></node><node id="prec_2022_10_scale_577"><data key="d0">precedent</data><data key="d1">because the Hon'ble Supreme Court in Vijay Madanlal Chaudhary and others v. Union of India and others</data><data key="d2">1</data></node><node id="prec_2018_1_scc_797"><data key="d0">precedent</data><data key="d1">(2018) 1 SCC 797</data><data key="d2">1</data></node><node id="prec_2013_1_scc_598"><data key="d0">precedent</data><data key="d1">Inspector General of Police v. S. Samuthiram</data><data key="d2">1</data></node><node id="prec_1994_1_scc_541"><data key="d0">precedent</data><data key="d1">Referring to the judgment of this Court in RBI v. Bhopal Singh Panchal</data><data key="d2">1</data></node><node id="prec_2013_7_scc_685"><data key="d0">precedent</data><data key="d1">(2013) 7 SCC 685</data><data key="d2">1</data></node><node id="prec_2010_11_scc_455"><data key="d0">precedent</data><data key="d1">Fuljit Kaur v. State of Punjab</data><data key="d2">1</data></node><node id="prec_2015_2_scc_591"><data key="d0">precedent</data><data key="d1">Commr. of Police v. Mehar Singh</data><data key="d2">1</data></node><node id="prec_2016_8_scc_471"><data key="d0">precedent</data><data key="d1">(2016) 8 SCC 471</data><data key="d2">1</data></node><node id="prec_air_1964_sc_787"><data key="d0">precedent</data><data key="d1">was considered by this Court in Inspector General of Police v. S. Samuthiram</data><data key="d2">1</data></node><node id="prec_2012_9_scc_750"><data key="d0">precedent</data><data key="d1">(2012) 9 SCC 750</data><data key="d2">1</data></node><node id="prec_2020_10_scc_555"><data key="d0">precedent</data><data key="d1">We may also refer to the judgment of this Court in the case of Raju vs. State of Haryana8</data><data key="d2">1</data></node><node id="prec_2019_14_scc_401"><data key="d0">precedent</data><data key="d1">We may also refer to the judgment of this Court in the case of Raju vs. State of Haryana8</data><data key="d2">1</data></node><node id="prec_2001_6_scc_181"><data key="d0">precedent</data><data key="d1">(2001) 6 SCC 181</data><data key="d2">1</data></node><node id="prec_1997_1_scc_361"><data key="d0">precedent</data><data key="d1">(1997) 1 SCC 361</data><data key="d2">1</data></node><node id="prec_2000_3_scc_693"><data key="d0">precedent</data><data key="d1">(2000) 3 SCC 693</data><data key="d2">1</data></node><node id="prec_1973_2_scc_823"><data key="d0">precedent</data><data key="d1">(1973) 2 SCC 823</data><data key="d2">1</data></node><node id="prec_2006_4_scc_359"><data key="d0">precedent</data><data key="d1">(2006) 4 SCC 359</data><data key="d2">1</data></node><node id="prec_2001_7_scc_536"><data key="d0">precedent</data><data key="d1">this Court in Devendra Nath Singh v. State of Bihar and Ors.9 noted that there is no specific requirement to seek leave of the court for further investigation or to file</data><data key="d2">1</data></node><node id="prec_2023_1_scc_48"><data key="d0">precedent</data><data key="d1">(2023) 1 SCC 48</data><data key="d2">1</data></node><node id="prec_2013_13_scc_673"><data key="d0">precedent</data><data key="d1">(2013) 13 SCC 673</data><data key="d2">1</data></node><node id="prec_2022_7_scc_124"><data key="d0">precedent</data><data key="d1">(2022) 7 SCC 124</data><data key="d2">1</data></node><node id="prec_2011_2_scc_330"><data key="d0">precedent</data><data key="d1">(2011) 2 SCC 330</data><data key="d2">1</data></node><node id="prec_1979_4_scc_163"><data key="d0">precedent</data><data key="d1">(1979) 4 SCC 163</data><data key="d2">1</data></node><node id="prec_2000_7_scc_357"><data key="d0">precedent</data><data key="d1">(2000) 7 SCC 357</data><data key="d2">1</data></node><node id="prec_1989_4_scc_131"><data key="d0">precedent</data><data key="d1">ourt has also considered the decision of this Court in Nair Service Society Ltd v. Rev. Father K. C. Alexander</data><data key="d2">1</data></node><node id="prec_1971_1_scc_265"><data key="d0">precedent</data><data key="d1">of the Code of Civil Procedure as held by this Court in Mahabir Prasad v. Jage Ram</data><data key="d2">1</data></node><node id="prec_2016_2_scc_82"><data key="d0">precedent</data><data key="d1">(2016) 2 SCC 82</data><data key="d2">1</data></node><node id="prec_1987_1_scc_254"><data key="d0">precedent</data><data key="d1">(1987) 1 SCC 254</data><data key="d2">1</data></node><node id="prec_1981_3_scc_103"><data key="d0">precedent</data><data key="d1">(1981) 3 SCC 103</data><data key="d2">1</data></node><node id="prec_2012_8_scc_148"><data key="d0">precedent</data><data key="d1">(2012) 8 SCC 148</data><data key="d2">1</data></node><node id="prec_air_1968_sc_1165"><data key="d0">precedent</data><data key="d1">dered the decision of this Court in Nair Service Society Ltd v. Rev. Father K. C. Alexander</data><data key="d2">1</data></node><node id="prec_air_1971_sc_742"><data key="d0">precedent</data><data key="d1">AIR 1971 SC 742</data><data key="d2">1</data></node><node id="prec_2019_16_scc_547"><data key="d0">precedent</data><data key="d1">Dipakbhai Jagdishchndra Patel v. State of Gujarat</data><data key="d2">1</data></node><node id="prec_2015_4_scc_609"><data key="d0">precedent</data><data key="d1">Dipakbhai Jagdishchndra Patel v. State of Gujarat</data><data key="d2">1</data></node><node id="prec_1998_5_scc_749"><data key="d0">precedent</data><data key="d1">(1998) 5 SCC

749</data><data key="d2">1</data></node><node id="prec_2009_8_scc_1"><data key="d0">precedent</data><data key="d1">Sudhir Shantilal Mehta v. Central Bureau of Investigation</data><data key="d2">1</data></node><node id="prec_2009_8_scc_751"><data key="d0">precedent</data><data key="d1">Iridium India Telecom Limited v. Motorola Incorporated and Others</data><data key="d2">1</data></node><node id="prec_2011_13_scc_412"><data key="d0">precedent</data><data key="d1">we would only like to refer to the judgment of this Court in Thermax Limited and Others v. K.M. Johny16</data><data key="d2">1</data></node><node id="prec_2019_16_scc_610"><data key="d0">precedent</data><data key="d1">Birla Corporation Limited v. Adventz Investments and Holdings Limited and Others</data><data key="d2">1</data></node><node id="prec_2015_12_scc_420"><data key="d0">precedent</data><data key="d1">and Mehmood Ul Rehman v. Khazir Mohammad Tunda</data><data key="d2">1</data></node><node id="prec_2014_14_scc_638"><data key="d0">precedent</data><data key="d1">Vijay Dhanuka v. Najima Mamtaj</data><data key="d2">1</data></node><node id="prec_2017_3_scc_528"><data key="d0">precedent</data><data key="d1">Vijay Dhanuka v. Najima Mamtaj</data><data key="d2">1</data></node><node id="prec_air_2011_sc_20"><data key="d0">precedent</data><data key="d1">Iridium India Telecom Limited v. Motorola Incorporated and Others</data><data key="d2">1</data></node><node id="prec_2000_2_scc_595"><data key="d0">precedent</data><data key="d1">Union of India v. V. Sriharan</data><data key="d2">1</data></node><node id="prec_2021_9_scc_292"><data key="d0">precedent</data><data key="d1">investigation and disposal of the case and before See State of Haryana v. Raj Kumar</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_35"><data key="d0">precedent</data><data key="d1">Jaswant Singh v. State of Chhattisgarh</data><data key="d2">1</data></node><node id="prec_2008_2_scc_672"><data key="d0">precedent</data><data key="d1">The CAT placed reliance on the decision of this Court in DDA v. Joint Action Committee</data><data key="d2">1</data></node><node id="prec_1996_3_scc_454"><data key="d0">precedent</data><data key="d1">Constitutional Court cannot substitute the existing service conditions of an employee. V.M. Gadre v. M.G. Diwan and Others</data><data key="d2">1</data></node><node id="prec_2015_2_scc_796"><data key="d0">precedent</data><data key="d1">particular manner. Census Commissioner and Others v. R. Krishnamurthy</data><data key="d2">1</data></node><node id="prec_2016_10_scc_77"><data key="d0">precedent</data><data key="d1">State of Himachal Pradesh and Others v. Rajesh Chander Sood and Others</data><data key="d2">1</data></node><node id="prec_2015_5_scc_333"><data key="d0">precedent</data><data key="d1">Sampath and Others v. Secretary</data><data key="d2">1</data></node><node id="prec_2022_4_scc_193"><data key="d0">precedent</data><data key="d1">(2022) 4 SCC 193</data><data key="d2">1</data></node><node id="prec_1980_3_scc_97"><data key="d0">precedent</data><data key="d1">refer to the following decision in Tamil Nadu Education Department Ministerial and General Subordinate Services Association and Others v. State of Tamil Nadu and Others reported in</data><data key="d2">1</data></node><node id="prec_2000_10_scc_527"><data key="d0">precedent</data><data key="d1">decision of this Court in the case of State of Bihar and Another v. Teachers' Association of Govt. Engineering College and Others</data><data key="d2">1</data></node><node id="prec_2007_8_scc_231"><data key="d0">precedent</data><data key="d1">he employees. It has been time and again reiterated that the court must adopt an attitude of total non- interference or minimal interference in the matter of interpretation of rules framed by autonomous institutions. In Kerala SRTC v. K.O. Varghese</data><data key="d2">1</data></node><node id="prec_1996_11_scc_348"><data key="d0">precedent</data><data key="d1">Chandigarh v. Krishan Bhandari</data><data key="d2">1</data></node><node id="prec_1997_7_scc_334"><data key="d0">precedent</data><data key="d1">In Union of India and Others v. Lieut</data><data key="d2">1</data></node><node id="prec_1952_1_scc_798"><data key="d0">precedent</data><data key="d1">In the case of Ebrahim Aboobakar and Hawabai Aboobakar v. The Custodian General of Evacuee Property</data><data key="d2">1</data></node><node id="prec_1952_1_scc_449"><data key="d0">precedent</data><data key="d1">This Court in Parry and Company Limited v. Commercial Employees' Association</data><data key="d2">1</data></node><node id="prec_air_2018_sc_2652"><data key="d0">precedent</data><data key="d1">We must also look into the decision of this Court in the case of Kerala Assistant Public Prosecutors Associations v. State of Kerala and Others reported in AIR</data><data key="d2">1</data></node><node id="prec_air_2021_sc_3457"><data key="d0">precedent</data><data key="d1">AIR 2021 SC 3457</data><data key="d2">1</data></node><node id="prec_air_1954_sc_440"><data key="d0">precedent</data><data key="d1">J. in T.C. Basappa v. T. Nagappa and Another</data><data key="d2">1</data></node><node id="prec_air_1963_sc_1626"><data key="d0">precedent</data><data key="d1">according to this Court in K.M. Shanmugam v. The S.R.V.S</data><data key="d2">1</data></node><node id="prec_air_2000_sc_1508"><data key="d0">precedent</data><data key="d1">it will be profitable for us to refer to the decision of this Court in the case of Indian Overseas Bank v. I.O.B. Staff Canteen Workers' Union and Another</data><data key="d2">1</data></node><node id="prec_air_1952_sc_179"><data key="d0">precedent</data><data key="d1">This Court in Parry and Company Limited v. Commercial Employees' Association</data><data key="d2">1</data></node><node id="prec_air_1951_sc_115"><data key="d0">precedent</data><data key="d1">AIR 1951 SC 115</data><data key="d2">1</data></node><node id="prec_2020_scc_online_sc_1332"><data key="d0">precedent</data><data key="d1">The interim order in favour of Salma Khatoon was vacated by this Court in the case of Central Council for Research in Unani Medicine v. Dr. Salma Khatoon and Others reported as</data><data key="d2">1</data></node><node id="prec_2002_3_scc_598"><data key="d0">precedent</data><data key="d1">(2002) 3 SCC 598</data><data key="d2">1</data></node><node id="prec_2010_14_scc_496"><data key="d0">precedent</data><data key="d1">(2010) 14 SCC 496</data><data key="d2">1</data></node><node id="prec_2020_2_scc_118"><data key="d0">precedent</data><data key="d1">(2020) 2 SCC 118</data><data key="d2">1</data></node><node id="prec_1996_4_scc_693"><data key="d0">precedent</data><data key="d1">(1996) 4 SCC 693</data><data key="d2">1</data></node><node id="prec_2018_16_scc_511"><data key="d0">precedent</data><data key="d1">(2018) 16 SCC 511</data><data key="d2">1</data></node><node id="prec_2022_9_scc_321"><data key="d0">precedent</data><data key="d1">(2022) 9 SCC

321</data><data key="d2">1</data></node><node id="prec_2021_15_scc_518"><data key="d0">precedent</data><data key="d1">(2021) 15 SCC 518</data><data key="d2">1</data></node><node id="prec_2022_14_scc_529"><data key="d0">precedent</data><data key="d1">Prem Shankar Prasad v. State of Bihar</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_1059"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine SC 1059</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_1062"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine SC 1062</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_892"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine SC 892</data><data key="d2">1</data></node><node id="prec_1994_6_scc_241"><data key="d0">precedent</data><data key="d1">(1994) 6 SCC 241</data><data key="d2">1</data></node><node id="prec_2010_14_scc_489"><data key="d0">precedent</data><data key="d1">this Court. The first case is of Vijakumar v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_2012_1_scc_113"><data key="d0">precedent</data><data key="d1">case is of Vijakumar v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_2019_10_scc_166"><data key="d0">precedent</data><data key="d1">Anr. v. Mangesh Nivrutti Kashid</data><data key="d2">1</data></node><node id="prec_1994_1_scc_359"><data key="d0">precedent</data><data key="d1">Ors. v. Ravi Prakash Babulalsing Parmar</data><data key="d2">1</data></node><node id="prec_2007_1_scc_80"><data key="d0">precedent</data><data key="d1">Ors. v. Ravi Prakash Babulalsing Parmar</data><data key="d2">1</data></node><node id="prec_2012_1_scc_333"><data key="d0">precedent</data><data key="d1">(2012) 1 SCC 333</data><data key="d2">1</data></node><node id="prec_2021_9_scc_811"><data key="d0">precedent</data><data key="d1">(2021) 9 SCC 811</data><data key="d2">1</data></node><node id="prec_2009_10_scc_84"><data key="d0">precedent</data><data key="d1">The learned counsel placed strong reliance on the decision of this Court in the context of Revajeetu Builders and Developers v. Narayanaswamy</data><data key="d2">1</data></node><node id="prec_2008_8_scc_511"><data key="d0">precedent</data><data key="d1">Gorakhpur v. Bhagwan Das reported in</data><data key="d2">1</data></node><node id="prec_1990_1_scc_166"><data key="d0">precedent</data><data key="d1">Also see Gajanan Jaikishan Joshi v. Prabhakar Mohanlal Kalwar</data><data key="d2">1</data></node><node id="prec_2009_14_scc_525"><data key="d0">precedent</data><data key="d1">In the case of P.A. Jayalakshmi v. H. Saradha and Others reported in</data><data key="d2">1</data></node><node id="prec_2000_1_scc_712"><data key="d0">precedent</data><data key="d1">Narayana Pillai v. Parameswaran Pillai and Another reported in</data><data key="d2">1</data></node><node id="prec_1974_2_scc_393"><data key="d0">precedent</data><data key="d1">Again in Ganga Bai v. Vijay Kumar</data><data key="d2">1</data></node><node id="prec_1978_2_scc_91"><data key="d0">precedent</data><data key="d1">In Ganesh Trading Co. v. Moji Ram</data><data key="d2">1</data></node><node id="prec_1996_2_scc_25"><data key="d0">precedent</data><data key="d1">Nagamma and Another v. Siromanamma and Another reported in</data><data key="d2">1</data></node><node id="prec_2014_11_scc_316"><data key="d0">precedent</data><data key="d1">In Praful Manohar Rele v. Krishnabai Narayan Ghosalkar and Others reported in</data><data key="d2">1</data></node><node id="prec_2007_5_scc_602"><data key="d0">precedent</data><data key="d1">the judgment of this Court in Usha Balashaheb Swami and Others v. Kiran Appaso Swami and Others reported in</data><data key="d2">1</data></node><node id="prec_2011_12_scc_268"><data key="d0">precedent</data><data key="d1">(2011) 12 SCC

268</data><data key="d2">1</data></node><node id="prec_air_1957_sc_363"><data key="d0">precedent</data><data key="d1">In Pirgonda Hongonda Patil v. Kalgonda Shidgonda Patil</data><data key="d2">1</data></node><node id="prec_air_1967_sc_96"><data key="d0">precedent</data><data key="d1">In B.K. Narayana Pillai v. Parameswaran Pillai and Another reported in</data><data key="d2">1</data></node><node id="prec_air_1957_sc_357"><data key="d0">precedent</data><data key="d1">Cropper v. Smith</data><data key="d2">1</data></node><node id="prec_air_1951_sc_177"><data key="d0">precedent</data><data key="d1">three-Judge Bench of this Court in the case of Firm Sriniwas Ram Kumar v. Mahabir Prasad and Others reported in AIR</data><data key="d2">1</data></node><node id="prec_air_1965_sc_295"><data key="d0">precedent</data><data key="d1">AIR 1965 SC 295</data><data key="d2">1</data></node><node id="prec_air_1948_bom_226"><data key="d0">precedent</data><data key="d1">In Vithal Rajaram Sutar and another v. Ramchandra Pandu Jadhav and others reported in AIR</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_1897"><data key="d0">precedent</data><data key="d1">See Vijay Gupta v. Gagninder Kr. Gandhi</data><data key="d2">1</data></node><node id="prec_2016_4_scc_754"><data key="d0">precedent</data><data key="d1">They relied on Ram Kumar Gijroya vs. Delhi Subordinate Services Selection Board</data><data key="d2">1</data></node><node id="prec_1980_2_scc_752"><data key="d0">precedent</data><data key="d1">Dolly Chhanda vs. Chairman</data><data key="d2">1</data></node><node id="prec_2005_9_scc_779"><data key="d0">precedent</data><data key="d1">Dolly Chhanda vs. Chairman</data><data key="d2">1</data></node><node id="prec_2017_11_scc_276"><data key="d0">precedent</data><data key="d1">Dolly Chhanda vs. Chairman</data><data key="d2">1</data></node><node id="prec_2018_18_scc_242"><data key="d0">precedent</data><data key="d1">Dolly Chhanda vs. Chairman</data><data key="d2">1</data></node><node id="prec_1997_4_scc_18"><data key="d0">precedent</data><data key="d1">Learned counsel relied on Ashok Kumar Sharma and Others vs. Chander Shekhar and Another</data><data key="d2">1</data></node><node id="prec_2003_3_scc_548"><data key="d0">precedent</data><data key="d1">and Yogesh Kumar vs. GNCTD</data><data key="d2">1</data></node><node id="prec_2000_5_scc_262"><data key="d0">precedent</data><data key="d1">See Rekha Chaturvedi v. University of Rajasthan</data><data key="d2">1</data></node><node id="prec_2007_4_scc_54"><data key="d0">precedent</data><data key="d1">See Rekha Chaturvedi v. University of Rajasthan</data><data key="d2">1</data></node><node id="prec_1990_2_scc_669"><data key="d0">precedent</data><data key="d1">See A.P. Public Service Commission v. B. Sarat Chandra</data><data key="d2">1</data></node><node id="prec_2008_9_scc_403"><data key="d0">precedent</data><data key="d1">In T. Jayakumar vs. A. Gopu and Another</data><data key="d2">1</data></node><node id="prec_2020_scc_online_sc_1472"><data key="d0">precedent</data><data key="d1">the last day for submission of the application for Preliminary Examination. They relied on Ram Kumar Gijroya vs. Delhi Subordinate Services Selection Board</data><data key="d2">1</data></node><node id="prec_2022_scc_online_sc_1341"><data key="d0">precedent</data><data key="d1">ion of the application for Preliminary Examination. They relied on Ram Kumar Gijroya vs. Delhi Subordinate Services Selection Board</data><data key="d2">1</data></node><node id="prec_1972_1_scc_409"><data key="d0">precedent</data><data key="d1">(1972) 1 SCC 409</data><data key="d2">1</data></node><node id="prec_1979_4_scc_507"><data key="d0">precedent</data><data key="d1">(1979) 4 SCC 507</data><data key="d2">1</data></node><node id="prec_2022_1_scc_401"><data key="d0">precedent</data><data key="d1">Sashidhar v. Indian Overseas Bank</data><data key="d2">1</data></node><node id="prec_2020_11_scc_467"><data key="d0">precedent</data><data key="d1">K. Sashidhar v. Indian Overseas Bank</data><data key="d2">1</data></node><node id="prec_2021_3_scc_475"><data key="d0">precedent</data><data key="d1">Ltd v. Spade Financial Services Ltd. and Ors</data><data key="d2">1</data></node><node id="prec_2021_10_scc_401"><data key="d0">precedent</data><data key="d1">Placing reliance on Kalpraj Dharamshi and Anr. v. Kotak Investment Advisors Limited and Anr</data><data key="d2">1</data></node><node id="prec_2022_2_scc_544"><data key="d0">precedent</data><data key="d1">ing share in the CoC which deserves to be taken forward. Learned SG has relied on the decisions of this Court in Vallal RCK v. Siva Industries and Holdings Ltd. and Ors</data><data key="d2">1</data></node><node id="prec_2021_scc_online_sc_569"><data key="d0">precedent</data><data key="d1">and Ors. v. Monitoring Committee of Reliance Infratel Ltd and Anr</data><data key="d2">1</data></node><node id="prec_2022_scc_online_sc_717"><data key="d0">precedent</data><data key="d1">voting share in the CoC which deserves to be taken forward. Learned SG has relied on the decisions of this Court in Vallal RCK v. Siva Industries and Holdings Ltd. and Ors</data><data key="d2">1</data></node><node id="prec_2008_9_scc_299"><data key="d0">precedent</data><data key="d1">Valji Khimji and Company v. Official Liquidator of Hindustan Nitro Product</data><data key="d2">1</data></node><node id="prec_2015_5_scc_574"><data key="d0">precedent</data><data key="d1">Sadashiv Prasad Singh v. Harendar Singh</data><data key="d2">1</data></node><node id="prec_2014_5_scc_610"><data key="d0">precedent</data><data key="d1">g. The aforesaid position has also been echoed in the case of Mathew Varghese v. M. Amritha Kumar and Ors</data><data key="d2">1</data></node><node id="prec_2021_12_scc_761"><data key="d0">precedent</data><data key="d1">The said judgment also considered and distinguished the judgment of this Court in Shakeena and Anr. v. Bank of India and Ors</data><data key="d2">1</data></node><node id="prec_2022_10_scc_641"><data key="d0">precedent</data><data key="d1">Ors. v. N. Subhash Chand Jain</data><data key="d2">1</data></node><node id="prec_2016_4_scc_1"><data key="d0">precedent</data><data key="d1">Anr. v. Board for Industrial and Financial Reconstruction</data><data key="d2">1</data></node><node id="prec_2011_6_scc_780"><data key="d0">precedent</data><data key="d1">Trust v. EDC Limited and Others reported in</data><data key="d2">1</data></node><node id="prec_1977_3_scc_247"><data key="d0">precedent</data><data key="d1">Narandas Karsondas v. S.A. Kamtam</data><data key="d2">1</data></node><node id="prec_2018_5_scc_491"><data key="d0">precedent</data><data key="d1">In Dwarika Prasad v. State of Uttar Pradesh reported in</data><data key="d2">1</data></node><node id="prec_2017_8_scc_272"><data key="d0">precedent</data><data key="d1">Anr. v. Allahabad Bank</data><data key="d2">1</data></node><node id="prec_2015_14_scc_316"><data key="d0">precedent</data><data key="d1">it would be apposite to refer to the decision of this Court in Embassy Hotels Private Ltd. v. Gajraj and Company</data><data key="d2">1</data></node><node id="prec_2022_2_scc_221"><data key="d0">precedent</data><data key="d1">as observed by this Court in Arce Polymers Pvt. Ltd. v. Alpine Pharmaceuticals Pvt. Ltd</data><data key="d2">1</data></node><node id="prec_2017_16_scc_741"><data key="d0">precedent</data><data key="d1">Ors. v. Hero Fincorp Limited reported in</data><data key="d2">1</data></node><node id="prec_2016_3_scc_762"><data key="d0">precedent</data><data key="d1">Kalsaria v. Bank of India</data><data key="d2">1</data></node><node id="prec_2010_3_scc_786"><data key="d0">precedent</data><data key="d1">Maharashtra University of Health Sciences v. Satchikitsa Prasarak Mandal</data><data key="d2">1</data></node><node id="prec_2022_5_scc_710"><data key="d0">precedent</data><data key="d1">Kumara Gupta v. Sri Markendaya and Sri Omkareswara Swamy Temple</data><data key="d2">1</data></node><node id="prec_2022_11_scc_761"><data key="d0">precedent</data><data key="d1">This Court in National Spot Exchange Ltd. v. Anil Kohli</data><data key="d2">1</data></node><node id="prec_2011_14_scc_739"><data key="d0">precedent</data><data key="d1">BSNL v. Mishri Lal</data><data key="d2">1</data></node><node id="prec_2007_2_scc_230"><data key="d0">precedent</data><data key="d1">Raghunath Rai Bareja v. Punjab National Bank</data><data key="d2">1</data></node><node id="prec_2000_7_scc_521"><data key="d0">precedent</data><data key="d1">In Council for Indian School Certificate Examination v. Isha Mittal</data><data key="d2">1</data></node><node id="prec_2003_5_scc_413"><data key="d0">precedent</data><data key="d1">Bhattad v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_2003_1_scc_123"><data key="d0">precedent</data><data key="d1">Palanisamy v. Palanisamy</data><data key="d2">1</data></node><node id="prec_2003_9_scc_393"><data key="d0">precedent</data><data key="d1">In India House v. Kishan N. Lalwani</data><data key="d2">1</data></node><node id="prec_air_1963_sc_1633"><data key="d0">precedent</data><data key="d1">in Madamanchi Ramappa v. Muthaluru Bojjappa</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_510"><data key="d0">precedent</data><data key="d1">Authorised Officer State Bank of India v. C. Natarajan and Anr</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_1138"><data key="d0">precedent</data><data key="d1">recent decision by this Court in Eva Agro Feeds Private Limited v. Punjab National Bank</data><data key="d2">1</data></node><node id="prec_2009_6_scc_595"><data key="d0">precedent</data><data key="d1">Ors. v. State through Central Bureau of Investigation</data><data key="d2">1</data></node><node id="prec_2014_10_scc_270"><data key="d0">precedent</data><data key="d1">Ors. v. State through Central Bureau of Investigation</data><data key="d2">1</data></node><node id="prec_2020_10_scc_108"><data key="d0">precedent</data><data key="d1">Ors. v. State through Central Bureau of Investigation</data><data key="d2">1</data></node><node id="prec_2019_18_scc_161"><data key="d0">precedent</data><data key="d1">Ors. v. State through Central Bureau of Investigation</data><data key="d2">1</data></node><node id="prec_2011_6_scc_1"><data key="d0">precedent</data><data key="d1">Ors. v. State through Central Bureau of Investigation</data><data key="d2">1</data></node><node id="prec_1976_2_scc_819"><data key="d0">precedent</data><data key="d1">(1976) 2 SCC 819</data><data key="d2">1</data></node><node id="prec_2008_16_scc_328"><data key="d0">precedent</data><data key="d1">we may usefully refer to the judgment of this Court in Asraf Ali v. State of Assam</data><data key="d2">1</data></node><node id="prec_1951_scc_online_sc_49"><data key="d0">precedent</data><data key="d1">as their Lordships of the Privy Council indicated in Dwarkanath Varma v. Emperor</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_174"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine SC 174</data><data key="d2">1</data></node><node id="prec_2010_8_scc_739"><data key="d0">precedent</data><data key="d1">vide Ajmera Housing Corporation vs. Commissioner of Income Tax</data><data key="d2">1</data></node><node id="prec_1979_4_scc_121"><data key="d0">precedent</data><data key="d1">which was subsequently discovered by the Assessing Officer. iv. Reliance was placed on the decision of this Court in Commissioner of Income Tax vs. B.N. Bhattacharjee</data><data key="d2">1</data></node><node id="prec_1994_2_scc_374"><data key="d0">precedent</data><data key="d1">referred to the judgment of this Court in Commissioner of Income Tax vs. Express Newspapers Ltd</data><data key="d2">1</data></node><node id="prec_2004_3_scc_624"><data key="d0">precedent</data><data key="d1">to refer to the decision of this Court in Ashirvad Enterprises vs. State of Bihar</data><data key="d2">1</data><