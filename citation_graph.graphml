cc_289"><data key="d0">precedent</data><data key="d1">In Brij Mohan Lal v. Union of India20 this Court reiterated on this aspect and made out</data><data key="d2">1</data></node><node id="prec_2005_5_scc_181"><data key="d0">precedent</data><data key="d1">In Brij Mohan Lal v. Union of India20 this Court reiterated on this aspect and made out</data><data key="d2">1</data></node><node id="prec_2015_7_scc_698"><data key="d0">precedent</data><data key="d1">In Brij Mohan Lal v. Union of India20 this Court reiterated on this aspect and made out</data><data key="d2">1</data></node><node id="prec_air_1993_sc_2178"><data key="d0">precedent</data><data key="d1">Later in the seminal judgment of this court in Unni Krishnan J.P. versus State of Andhra Pradesh and Ors</data><data key="d2">1</data></node><node id="prec_2018_7_scc_731"><data key="d0">precedent</data><data key="d1">(2018) 7 SCC 731</data><data key="d2">1</data></node><node id="prec_2015_15_scc_748"><data key="d0">precedent</data><data key="d1">(2015) 15 SCC

748</data><data key="d2">1</data></node><node id="prec_2021_6_scc_258"><data key="d0">precedent</data><data key="d1">(2021) 6 SCC 258</data><data key="d2">1</data></node><node id="prec_2011_4_scc_593"><data key="d0">precedent</data><data key="d1">The Court relied upon Kaushalya Devi Massand v. Roopkishore Khore</data><data key="d2">1</data></node><node id="prec_2018_1_scc_560"><data key="d0">precedent</data><data key="d1">i. The Court relied upon Kaushalya Devi Massand v. Roopkishore Khore</data><data key="d2">1</data></node><node id="prec_2012_5_scc_661"><data key="d0">precedent</data><data key="d1">(2012) 5 SCC

661</data><data key="d2">1</data></node><node id="prec_2012_3_scc_255"><data key="d0">precedent</data><data key="d1">In JIK Industries Limited and Others v. Amarlal V. Jumani and Another reported in</data><data key="d2">1</data></node><node id="prec_2000_1_scc_1"><data key="d0">precedent</data><data key="d1">even while overruling its decision in Anil Hada v. Indian Acrylic Ltd. reported in</data><data key="d2">1</data></node><node id="prec_2021_9_scc_321"><data key="d0">precedent</data><data key="d1">This Court in Lalit Kumar Jain v. Union of India and Others reported in</data><data key="d2">1</data></node><node id="prec_1982_3_scc_358"><data key="d0">precedent</data><data key="d1">Maharashtra SEB v. Official Liquidator</data><data key="d2">1</data></node><node id="prec_2019_20_scc_38"><data key="d0">precedent</data><data key="d1">In an interesting case titled Goa State Cooperative Bank Limited v. Krishna Nath A. and Others reported in</data><data key="d2">1</data></node><node id="prec_2018_17_scc_394"><data key="d0">precedent</data><data key="d1">In State Bank of India v. V. Ramakrishnan and Another reported in</data><data key="d2">1</data></node><node id="prec_2019_20_scc_455"><data key="d0">precedent</data><data key="d1">In Vijay Kumar Jain v. Standard Chartered Bank reported in</data><data key="d2">1</data></node><node id="prec_air_1940_bom_247"><data key="d0">precedent</data><data key="d1">see Jagannath Ganeshram Agarwale v. Shivnarayan Bhagirath</data><data key="d2">1</data></node><node id="prec_air_1970_sc_1041"><data key="d0">precedent</data><data key="d1">Ltd. v. New Kaiser-I-Hind Spg. And Wvg. Co. Ltd</data><data key="d2">1</data></node><node id="prec_2005_1_scc_88"><data key="d0">precedent</data><data key="d1">(2005) 1 SCC 88</data><data key="d2">1</data></node><node id="prec_2013_9_scc_293"><data key="d0">precedent</data><data key="d1">(2013) 9 SCC 293</data><data key="d2">1</data></node><node id="prec_2019_18_scc_191"><data key="d0">precedent</data><data key="d1">(2019) 18 SCC 191</data><data key="d2">1</data></node><node id="prec_2003_4_scc_46"><data key="d0">precedent</data><data key="d1">(2003) 4 SCC 46</data><data key="d2">1</data></node><node id="prec_2013_7_scc_675"><data key="d0">precedent</data><data key="d1">(2013) 7 SCC 675</data><data key="d2">1</data></node><node id="prec_2004_8_scc_1"><data key="d0">precedent</data><data key="d1">learned ASG has also placed reliance on the decision of this Court in the case of Zile Singh Vs. State of Haryana</data><data key="d2">1</data></node><node id="prec_2014_6_scc_444"><data key="d0">precedent</data><data key="d1">III Vs. Calcutta Knitwears</data><data key="d2">1</data></node><node id="prec_1975_2_scc_274"><data key="d0">precedent</data><data key="d1">reliance is placed on the decision of this Court in the case of Government of Andhra Pradesh Vs. Hindustan Machine Tools Ltd</data><data key="d2">1</data></node><node id="prec_2013_7_scc_653"><data key="d0">precedent</data><data key="d1">reliance is placed on the decision of this Court in the case of Government of Andhra Pradesh Vs. Hindustan Machine Tools Ltd</data><data key="d2">1</data></node><node id="prec_1974_3_scc_249"><data key="d0">precedent</data><data key="d1">question of power and not procedure as observed and held by this Court in the case of State of Tamil Nadu Vs. Star Tobacco Co</data><data key="d2">1</data></node><node id="prec_2002_2_scc_645"><data key="d0">precedent</data><data key="d1">State of Rajasthan v. Mangilal Pindwal</data><data key="d2">1</data></node><node id="prec_1996_5_scc_60"><data key="d0">precedent</data><data key="d1">State of Rajasthan v. Mangilal Pindwal</data><data key="d2">1</data></node><node id="prec_1969_1_scc_255"><data key="d0">precedent</data><data key="d1">it is to be found in West U.P. Sugar Mills Assn. v. State of U.P</data><data key="d2">1</data></node><node id="prec_2007_3_scc_668"><data key="d0">precedent</data><data key="d1">Ltd. v. Union of India</data><data key="d2">1</data></node><node id="prec_2006_12_scc_607"><data key="d0">precedent</data><data key="d1">Ltd. v. Union of India</data><data key="d2">1</data></node><node id="prec_2006_12_scc_583"><data key="d0">precedent</data><data key="d1">this Court noticed the decisions of this Court in Gursahai Saigal v. CIT</data><data key="d2">1</data></node><node id="prec_1994_6_scc_623"><data key="d0">precedent</data><data key="d1">and Gursahai Saigal v. CIT</data><data key="d2">1</data></node><node id="prec_1980_1_scc_370"><data key="d0">precedent</data><data key="d1">and Gursahai Saigal v. CIT</data><data key="d2">1</data></node><node id="prec_1981_4_scc_578"><data key="d0">precedent</data><data key="d1">Ltd. v. CTO</data><data key="d2">1</data></node><node id="prec_1992_1_scc_335"><data key="d0">precedent</data><data key="d1">Raghunath v. State of Karnataka</data><data key="d2">1</data></node><node id="prec_1997_1_scc_373"><data key="d0">precedent</data><data key="d1">See Sultana Begum v. Prem Chand Jain</data><data key="d2">1</data></node><node id="prec_air_1963_sc_933"><data key="d0">precedent</data><data key="d1">in West U.P. Sugar Mills Assn. v. State of U.P</data><data key="d2">1</data></node><node id="prec_air_1955_sc_661"><data key="d0">precedent</data><data key="d1">In Bengal Immunity Co. Ltd. v. State of Bihar</data><data key="d2">1</data></node><node id="prec_air_1992_sc_1"><data key="d0">precedent</data><data key="d1">The principles indicated in the said cases were reiterated by this Court in Mohan Kumar Singhania v. Union of India</data><data key="d2">1</data></node><node id="prec_air_1992_sc_81"><data key="d0">precedent</data><data key="d1">Raghunath v. State of Karnataka</data><data key="d2">1</data></node><node id="prec_air_1997_sc_1006"><data key="d0">precedent</data><data key="d1">See Sultana Begum v. Prem Chand Jain</data><data key="d2">1</data></node><node id="prec_2014_scc_online_del_4155"><data key="d0">precedent</data><data key="d1">was necessitated in view of the observation of the Delhi High Court in the case of Pepsico India Holdings Private Limited Vs. Assistant Commissioner of Income Tax</data><data key="d2">1</data></node><node id="prec_2019_3_scc_572"><data key="d0">precedent</data><data key="d1">(2019) 3 SCC 572</data><data key="d2">1</data></node><node id="prec_2019_3_scc_410"><data key="d0">precedent</data><data key="d1">(2019) 3 SCC 410</data><data key="d2">1</data></node><node id="prec_2019_12_scc_391"><data key="d0">precedent</data><data key="d1">(2019) 12 SCC 391</data><data key="d2">1</data></node><node id="prec_2014_scc_online_del_101"><data key="d0">precedent</data><data key="d1">2014 SCC OnLine Del 101</data><data key="d2">1</data></node><node id="prec_2013_5_scc_226"><data key="d0">precedent</data><data key="d1">Munish Kakkar v. Nidhi Kakkar4 and Neha Tyagi v. Lieutenant Colonel Deepak Tyagi5 has held that an irretrievable marriage is</data><data key="d2">1</data></node><node id="prec_2022_3_scc_86"><data key="d0">precedent</data><data key="d1">Munish Kakkar v. Nidhi Kakkar4 and Neha Tyagi v. Lieutenant Colonel Deepak Tyagi5 has held that an irretrievable marriage is</data><data key="d2">1</data></node><node id="prec_2007_4_scc_511"><data key="d0">precedent</data><data key="d1">(2007) 4 SCC 511</data><data key="d2">1</data></node><node id="prec_2004_10_scc_562"><data key="d0">precedent</data><data key="d1">inference would be that serious doubts are created with respect to the prosecution's endeavour to prove the fact of possession of contraband by the appellant. This aspect of the matter has been considered by this Court in Jitendra v. State of M.P</data><data key="d2">1</data></node><node id="prec_2018_4_scc_334"><data key="d0">precedent</data><data key="d1">this Court in Union of India v. Jarooparam</data><data key="d2">1</data></node><node id="prec_2019_10_scc_516"><data key="d0">precedent</data><data key="d1">It is submitted that as observed and held by this Court in the case of Prem Singh Vs. State of Uttar Pradesh and Ors</data><data key="d2">1</data></node><node id="prec_2003_10_scc_733"><data key="d0">precedent</data><data key="d1">Federal Bank Ltd. vs. Sagar Thomas</data><data key="d2">1</data></node><node id="prec_air_1969_sc_556"><data key="d0">precedent</data><data key="d1">if the petitioner is able to show that its case falls within any of the exceptions carved out in Baburam Prakash Chandra Maheshwari v. Antarim Zila Parishad</data><data key="d2">1</data></node><node id="prec_1987_2_scc_34"><data key="d0">precedent</data><data key="d1">In Rakesh Kumar alias Babli v. State of Haryana reported in</data><data key="d2">1</data></node><node id="prec_1999_9_scc_507"><data key="d0">precedent</data><data key="d1">In the case of Sukhar v. State of U.P. reported in</data><data key="d2">1</data></node><node id="prec_1976_4_scc_382"><data key="d0">precedent</data><data key="d1">it will also be profitable to refer to the following observations of this Court in the case of State of Andhra Pradesh v. Rayavarapu Punnayya and Another reported in</data><data key="d2">1</data></node><node id="prec_2004_11_scc_381"><data key="d0">precedent</data><data key="d1">the essential requirement as pointed out by this Court in the case of Parkash Chand v. State of Himachal Pradesh reported in</data><data key="d2">1</data></node><node id="prec_air_1983_sc_753"><data key="d0">precedent</data><data key="d1">See Bharwada Bhoginbhai Hirjibhai v. State of Gujarat</data><data key="d2">1</data></node><node id="prec_air_1995_sc_3717"><data key="d0">precedent</data><data key="d1">See Bharwada Bhoginbhai Hirjibhai v. State of Gujarat</data><data key="d2">1</data></node><node id="prec_air_1966_sc_1874"><data key="d0">precedent</data><data key="d1">Rajwant v. State of Kerala</data><data key="d2">1</data></node><node id="prec_air_1958_sc_465"><data key="d0">precedent</data><data key="d1">In Virsa Singh v. State of Punjab</data><data key="d2">1</data></node><node id="prec_2019_3_scc_653"><data key="d0">precedent</data><data key="d1">Reliance was placed on the decision of this Court in State of Himachal Pradesh vs. Shashi Kumar</data><data key="d2">1</data></node><node id="prec_1989_4_scc_468"><data key="d0">precedent</data><data key="d1">In Sushma Gosain vs. Union of India</data><data key="d2">1</data></node><node id="prec_1994_4_scc_138"><data key="d0">precedent</data><data key="d1">In Umesh Kumar Nagpal vs. State of Haryana</data><data key="d2">1</data></node><node id="prec_1997_8_scc_85"><data key="d0">precedent</data><data key="d1">In Haryana State Electricity Board vs. Hakim Singh</data><data key="d2">1</data></node><node id="prec_1996_1_scc_301"><data key="d0">precedent</data><data key="d1">consistent line of authority of this Court on the principle that appointment on compassionate grounds is given only for meeting the immediate unexpected hardship which is faced by the family by reason of the death of the bread earner vide Jagdish Prasad vs. State of Bihar</data><data key="d2">1</data></node><node id="prec_2007_6_scc_162"><data key="d0">precedent</data><data key="d1">In the same vein is the decision of this Court in Mumtaz Yunus Mulani vs. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_2008_11_scc_384"><data key="d0">precedent</data><data key="d1">In the same vein is the decision of this Court in Mumtaz Yunus Mulani vs. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_1997_6_scc_538"><data key="d0">precedent</data><data key="d1">vide Jagdish Lal vs. State of Haryana</data><data key="d2">1</data></node><node id="prec_2007_9_scc_278"><data key="d0">precedent</data><data key="d1">vide Jagdish Lal vs. State of Haryana</data><data key="d2">1</data></node><node id="prec_2013_12_scc_179"><data key="d0">precedent</data><data key="d1">it may be apposite to refer to the decision of this Court in State of Uttaranchal vs. Shiv Charan Singh Bhandari</data><data key="d2">1</data></node><node id="prec_air_2003_sc_3797"><data key="d0">precedent</data><data key="d1">This Court in State of Haryana vs. Ankur Gupta</data><data key="d2">1</data></node><node id="prec_air_2006_sc_2743"><data key="d0">precedent</data><data key="d1">In State of Jammu and Kashmir vs. Sajad Ahmed Mir</data><data key="d2">1</data></node><node id="prec_air_1967_sc_1450"><data key="d0">precedent</data><data key="d1">Constitution Bench of this Court in Moon Mills Ltd. vs. M. R. Meher</data><data key="d2">1</data></node><node id="prec_air_2022_sc_2836"><data key="d0">precedent</data><data key="d1">It may be apposite at this juncture to refer to the following observations of this Court in Malaya Nanda Sethy vs. State of Orissa</data><data key="d2">1</data></node><node id="prec_air_2006_sc_2382"><data key="d0">precedent</data><data key="d1">vide Ashok Lenka vs. Rishi Dikshit</data><data key="d2">1</data></node><node id="prec_1992_3_scc_141"><data key="d0">precedent</data><data key="d1">in the correct perspective. Reliance upon CBI v. Vikas Mishra</data><data key="d2">1</data></node><node id="prec_2023_6_scc_49"><data key="d0">precedent</data><data key="d1">Reliance upon CBI v. Vikas Mishra</data><data key="d2">1</data></node><node id="prec_2018_9_scc_745"><data key="d0">precedent</data><data key="d1">State of Maharashtra v. Tasneem Rizwan Siddiquee</data><data key="d2">1</data></node><node id="prec_2014_13_scc_436"><data key="d0">precedent</data><data key="d1">this issue has been considered in Saurabh Kumar v. Jailor</data><data key="d2">1</data></node><node id="prec_2013_1_scc_314"><data key="d0">precedent</data><data key="d1">this issue has been considered in Saurabh Kumar v. Jailor</data><data key="d2">1</data></node><node id="prec_1994_2_scc_691"><data key="d0">precedent</data><data key="d1">Anr. v. State of T.N</data><data key="d2">1</data></node><node id="prec_1982_1_scc_31"><data key="d0">precedent</data><data key="d1">Ors. v. State of Punjab</data><data key="d2">1</data></node><node id="prec_2005_3_scc_647"><data key="d0">precedent</data><data key="d1">In yet another decision in Ahmed Noormohmed Bhatti v. State of Gujarat</data><data key="d2">1</data></node><node id="prec_2015_2_scc_33"><data key="d0">precedent</data><data key="d1">Also see Manzoor Ali Khan v. Union of India</data><data key="d2">1</data></node><node id="prec_2008_13_scc_305"><data key="d0">precedent</data><data key="d1">in the case of Union of India v. Padam Narain Aggarwal</data><data key="d2">1</data></node><node id="prec_2013_15_scc_1"><data key="d0">precedent</data><data key="d1">In State of Rajasthan v. Basant Agrotech</data><data key="d2">1</data></node><node id="prec_2014_16_scc_623"><data key="d0">precedent</data><data key="d1">In Sundeep Kumar Bafna v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_2003_8_scc_559"><data key="d0">precedent</data><data key="d1">an investigating agency performing its statutory mandate. In Bharat Damodar Kale v. State of A.P</data><data key="d2">1</data></node><node id="prec_1997_2_scc_397"><data key="d0">precedent</data><data key="d1">(1997) 2 SCC 397</data><data key="d2">1</data></node><node id="prec_2020_8_scc_129"><data key="d0">precedent</data><data key="d1">In Indore Development Authority v. Manoharlal</data><data key="d2">1</data></node><node id="prec_1995_3_scc_33"><data key="d0">precedent</data><data key="d1">In Mahadeo Savlaram Shelke v. Pune Municipal Corpn</data><data key="d2">1</data></node><node id="prec_2010_1_scc_417"><data key="d0">precedent</data><data key="d1">In Amarjeet Singh v. Devi Ratan</data><data key="d2">1</data></node><node id="prec_1992_2_scc_620"><data key="d0">precedent</data><data key="d1">and Ram Krishna Verma v. State of U.P</data><data key="d2">1</data></node><node id="prec_1998_3_scc_376"><data key="d0">precedent</data><data key="d1">Vide Shiv Shankar v. U.P. SRTC</data><data key="d2">1</data></node><node id="prec_2005_8_scc_423"><data key="d0">precedent</data><data key="d1">Vide Shiv Shankar v. U.P. SRTC</data><data key="d2">1</data></node><node id="prec_1980_2_scc_191"><data key="d0">precedent</data><data key="d1">In Ram Krishna Verma v. State of U.P</data><data key="d2">1</data></node><node id="prec_2004_2_scc_783"><data key="d0">precedent</data><data key="d1">In Karnataka Rare Earth v. Deptt. of Mines</data><data key="d2">1</data></node><node id="prec_1969_3_scc_156"><data key="d0">precedent</data><data key="d1">essential that they should be made to serve and be subordinate to that purpose.' This Court in State of Gujarat v. Ramprakash P. Puri</data><data key="d2">1</data></node><node id="prec_1952_2_scc_329"><data key="d0">precedent</data><data key="d1">four-Judge Bench in Keshardeo Chamria v. Radha Kissen Chamria</data><data key="d2">1</data></node><node id="prec_2003_8_scc_648"><data key="d0">precedent</data><data key="d1">passed in the matter. In South Eastern Coalfields Ltd. v. State of M.P</data><data key="d2">1</data></node><node id="prec_2014_14_scc_434"><data key="d0">precedent</data><data key="d1">we do not wish to go any further as it has been dealt with by this Court in Satyajit Ballubhai Desai v. State of Gujarat</data><data key="d2">1</data></node><node id="prec_1952_2_scc_237"><data key="d0">precedent</data><data key="d1">in Aswini Kumar Ghose v. Arabinda Bose</data><data key="d2">1</data></node><node id="prec_2009_1_scc_469"><data key="d0">precedent</data><data key="d1">Bangalore v. Srikumar Agencies</data><data key="d2">1</data></node><node id="prec_2004_3_scc_75"><data key="d0">precedent</data><data key="d1">As observed in Union of India v. Amrit Lal Manchanda</data><data key="d2">1</data></node><node id="prec_2015_15_scc_613"><data key="d0">precedent</data><data key="d1">Satya Pal Singh v. State of Madhya Pradesh</data><data key="d2">1</data></node><node id="prec_1976_1_scc_128"><data key="d0">precedent</data><data key="d1">four-Judge Bench in Dwarka Prasad v. Dwarka Das Saraf</data><data key="d2">1</data></node><node id="prec_1986_3_scc_141"><data key="d0">precedent</data><data key="d1">The decision in Chaganti Satyanarayana v. State of Andhra Pradesh</data><data key="d2">1</data></node><node id="prec_2009_9_scc_266"><data key="d0">precedent</data><data key="d1">The larger Bench of this Court in Budh Singh v. State of Punjab</data><data key="d2">1</data></node><node id="prec_air_1970_sc_940"><data key="d0">precedent</data><data key="d1">In Romesh Chandra Mehta v. State of West Bengal</data><data key="d2">1</data></node><node id="prec_air_1961_sc_1353"><data key="d0">precedent</data><data key="d1">In Mrutunjay Pani v. Narmada Bala Sasmal</data><data key="d2">1</data></node><node id="prec_air_1953_sc_23"><data key="d0">precedent</data><data key="d1">four-Judge Bench in Keshardeo Chamria v. Radha Kissen Chamria</data><data key="d2">1</data></node><node id="prec_air_1952_sc_369"><data key="d0">precedent</data><data key="d1">in Aswini Kumar Ghose v. Arabinda Bose</data><data key="d2">1</data></node><node id="prec_air_1955_sc_376"><data key="d0">precedent</data><data key="d1">In Jugalkishore Saraf v. Raw Cotton Co. Ltd</data><data key="d2">1</data></node><node id="prec_air_1962_sc_680"><data key="d0">precedent</data><data key="d1">Abdul Kayoom v. CIT</data><data key="d2">1</data></node><node id="prec_2000_4_scc_406"><data key="d0">precedent</data><data key="d1">reliance is placed on the decision of this Court in the case of Allahabad Bank Vs. Canara Bank and Anr</data><data key="d2">1</data></node><node id="prec_2005_5_scc_75"><data key="d0">precedent</data><data key="d1">reliance is placed on the decision of this Court in the case of Allahabad Bank Vs. Canara Bank and Anr</data><data key="d2">1</data></node><node id="prec_2021_7_scc_474"><data key="d0">precedent</data><data key="d1">It is submitted that this Hon'ble Court has looked at overarching object and economic balance achieved by IBC and as such has appreciated the working and operation of IBC in unlocking value for all its stakeholders including financial institutions in the case of Innoventive Industries Limited Vs. ICICI Bank and Anr</data><data key="d2">1</data></node><node id="prec_2021_7_scc_313"><data key="d0">precedent</data><data key="d1">It is submitted that this Hon'ble Court has looked at overarching object and economic balance achieved by IBC and as such has appreciated the working and operation of IBC in unlocking value for all its stakeholders including financial institutions in the case of Innoventive Industries Limited Vs. ICICI Bank and Anr</data><data key="d2">1</data></node><node id="prec_1996_2_scc_405"><data key="d0">precedent</data><data key="d1">Rustom Cavasjee Cooper Vs. Union of India</data><data key="d2">1</data></node><node id="prec_2016_2_scc_226"><data key="d0">precedent</data><data key="d1">In Directorate General of Foreign Trade v. Kanak Exports</data><data key="d2">1</data></node><node id="prec_2011_10_scc_727"><data key="d0">precedent</data><data key="d1">Employees Provident Fund Commissioner v. Official Liquidator of Esskay Pharmaceuticals Limited</data><data key="d2">1</data></node><node id="prec_2022_8_scc_749"><data key="d0">precedent</data><data key="d1">Employees Provident Fund Commissioner v. Official Liquidator of Esskay Pharmaceuticals Limited</data><data key="d2">1</data></node><node id="prec_2021_3_scc_723"><data key="d0">precedent</data><data key="d1">(2021) 3 SCC 723</data><data key="d2">1</data></node><node id="prec_2021_3_scc_725"><data key="d0">precedent</data><data key="d1">(2021) 3 SCC 725</data><data key="d2">1</data></node><node id="prec_2019_5_scc_1"><data key="d0">precedent</data><data key="d1">(2019) 5 SCC 1</data><data key="d2">1</data></node><node id="prec_2001_6_scc_338"><data key="d0">precedent</data><data key="d1">as observed by this Court in Puran v. Rambilas</data><data key="d2">1</data></node><node id="prec_1978_1_scc_118"><data key="d0">precedent</data><data key="d1">The considerations which normally weigh with the court in granting bai