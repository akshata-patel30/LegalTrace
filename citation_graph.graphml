</data></node><node id="prec_2007_8_scc_100"><data key="d0">precedent</data><data key="d1">merely because the result is not palatable. In Union of India v. S. Vinodh Kumar</data><data key="d2">1</data></node><node id="prec_1991_3_scc_368"><data key="d0">precedent</data><data key="d1">See also Munindra Kumar v. Rajiv Govil</data><data key="d2">1</data></node><node id="prec_2006_12_scc_724"><data key="d0">precedent</data><data key="d1">See also Munindra Kumar v. Rajiv Govil</data><data key="d2">1</data></node><node id="prec_1991_1_scc_662"><data key="d0">precedent</data><data key="d1">In Mohinder Sain Garg vs. State of Punjab</data><data key="d2">1</data></node><node id="prec_1971_1_scc_38"><data key="d0">precedent</data><data key="d1">Miss Nishi Maghu vs. State of</data><data key="d2">1</data></node><node id="prec_1980_4_scc_95"><data key="d0">precedent</data><data key="d1">Miss Nishi Maghu vs. State of</data><data key="d2">1</data></node><node id="prec_air_1990_sc_434"><data key="d0">precedent</data><data key="d1">In Dalpat Abasaheb Solunke vs. Dr. B.S. Mahajan</data><data key="d2">1</data></node><node id="prec_air_1990_sc_461"><data key="d0">precedent</data><data key="d1">three-judge Bench of this Court in Kumari Anamica Mishra vs. UP Public Service Commission</data><data key="d2">1</data></node><node id="prec_air_1981_sc_1777"><data key="d0">precedent</data><data key="d1">This Court in Lila Dhar vs. State of Rajasthan</data><data key="d2">1</data></node><node id="prec_2003_8_scc_93"><data key="d0">precedent</data><data key="d1">(2003) 8 SCC 93</data><data key="d2">1</data></node><node id="prec_2009_6_scc_498"><data key="d0">precedent</data><data key="d1">Reliance was placed on Arvind Singh v. State of Maharashtra18 for the submission that if</data><data key="d2">1</data></node><node id="prec_2011_3_scc_685"><data key="d0">precedent</data><data key="d1">Reliance was placed on Arvind Singh v. State of Maharashtra18 for the submission that if</data><data key="d2">1</