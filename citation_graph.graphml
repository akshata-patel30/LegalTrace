ora v. Airports Authority of India</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_1210"><data key="d0">precedent</data><data key="d1">Delhi Metro Rail Corporation Ltd. v. J. Kumar Crtg. JV</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_3060"><data key="d0">precedent</data><data key="d1">Canara Bank v. State Trading Corporation of India Ltd</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_160"><data key="d0">precedent</data><data key="d1">this Hon'ble High Court in Union of India v. Alcon Builders</data><data key="d2">1</data></node><node id="prec_2008_scc_online_del_956"><data key="d0">precedent</data><data key="d1">Union of India v. Modern Laminators Ltd</data><data key="d2">1</data></node><node id="prec_2014_scc_online_del_4834"><data key="d0">precedent</data><data key="d1">The Delhi High Court in Nussli Switzerland Ltd. v. Organizing Committee</data><data key="d2">1</data></node><node id="prec_2015_scc_online_del_9126"><data key="d0">precedent</data><data key="d1">The Division Bench of the Delhi High Court while noticing R. S. Jiwani's Case in the case titled Puri Construction P. Ltd. v. Larsen and Toubro Ltd</data><data key="d2">1</data></node><node id="prec_2005_scc_online_del_689"><data key="d0">precedent</data><data key="d1">Bhasin Associates v. N.B.C.C</data><data key="d2">1</data></node><node id="prec_2015_scc_online_del_6669"><data key="d0">precedent</data><data key="d1">and Canara Bank v. BSNL</data><data key="d2">1</data></node><node id="prec_2015_scc_online_del_8379"><data key="d0">precedent</data><data key="d1">and Canara Bank v. BSNL</data><data key="d2">1</data></node><node id="prec_2014_scc_online_del_1581"><data key="d0">precedent</data><data key="d1">DDA v. Bhardwaj Bros</data><data key="d2">1</data></node><node id="prec_2014_scc_online_del_3426"><data key="d0">precedent</data><data key="d1">Central Warehousing Corpn. v. A.S.A. Transport</data><data key="d2">1</data></node><node id="prec_2012_scc_online_del_4846"><data key="d0">precedent</data><data key="d1">State Trading Corpn. of India Ltd. v. Toepfer International Asia PTE Ltd</data><data key="d2">1</data></node><node id="prec_2023_dhc_2814"><data key="d0">precedent</data><data key="d1">2023:DHC:2814</data><data key="d2">1</data></node><node id="prec_2019_9_scc_798"><data key="d0">precedent</data><data key="d1">in State of Jharkhand vs. HSS Integrated DSN</data><data key="d2">1</data></node><node id="prec_2015_3_scc_251"><data key="d0">precedent</data><data key="d1">The Hon'ble Supreme Court in BCCI vs. Cricket Association</data><data key="d2">1</data></node><node id="prec_2021_15_scc_730"><data key="d0">precedent</data><data key="d1">Vanitha v. The Deputy Commissioner</data><data key="d2">1</data></node><node id="prec_2003_4_scc_166"><data key="d0">precedent</data><data key="d1">and of this Court in Vidyanidhi Dalmia v. Nilanajana Dalmia</data><data key="d2">1</data></node><node id="prec_1994_4_scc_662"><data key="d0">precedent</data><data key="d1">by LRs v. Satyavati Bhargava and Others</data><data key="d2">1</data></node><node id="prec_2010_scc_online_del_225"><data key="d0">precedent</data><data key="d1">placing reliance on the judgment of this Court in Manita Khurana v. Indra Khurana</data><data key="d2">1</data></node><node id="prec_2020_scc_online_del_2481"><data key="d0">precedent</data><data key="d1">placing reliance on the judgment of this Court in Manita Khurana v. Indra Khurana</data><data key="d2">1</data></node><node id="prec_2021_scc_online_sc_1064"><data key="d0">precedent</data><data key="d1">by LRs v. Shanti Parshad</data><data key="d2">1</data></node><node id="prec_2020_scc_online_del_2487"><data key="d0">precedent</data><data key="d1">by LRs v. Shanti Parshad</data><data key="d2">1</data></node><node id="prec_2008_scc_online_del_371"><data key="d0">precedent</data><data key="d1">and of this Court in Vidyanidhi Dalmia v. Nilanajana Dalmia</data><data key="d2">1</data></node><node id="prec_2012_9_scc_257"><data key="d0">precedent</data><data key="d1">Ors. v. Union of India</data><data key="d2">1</data></node><node id="prec_2018_12_scc_129"><data key="d0">precedent</data><data key="d1">Jagan Mohan Reddy v. CBI</data><data key="d2">1</data></node><node id="prec_2013_7_scc_466"><data key="d0">precedent</data><data key="d1">Nimmagadda Prasad v. CBI</data><data key="d2">1</data></node><node id="prec_2015_16_scc_1"><data key="d0">precedent</data><data key="d1">Nimmagadda Prasad v. CBI</data><data key="d2">1</data></node><node id="prec_2009_12_scc_1"><data key="d0">precedent</data><data key="d1">Ors. v. Ferro Concrete Construction Pvt. Ltd</data><data key="d2">1</data></node><node id="prec_2009_10_scc_259"><data key="d0">precedent</data><data key="d1">In Som Datt Builders Ltd. vs. State of Kerala</data><data key="d2">1</data></node><node id="prec_1973_2_scc_836"><data key="d0">precedent</data><data key="d1">In Union of India v. Mohan Lal Capoor</data><data key="d2">1</data></node><node id="prec_1974_3_scc_318"><data key="d0">precedent</data><data key="d1">In Woolcombers of India Ltd. v. Workers' Union</data><data key="d2">1</data></node><node id="prec_1999_2_scc_10"><data key="d0">precedent</data><data key="d1">In Kuldeep Singh v. Commr. of Police</data><data key="d2">1</data></node><node id="prec_2013_3_scc_747"><data key="d0">precedent</data><data key="d1">The Courts of the Country have expressed their opinion on the principle and its applicability. In P. Radhakrishna Murthy v. National Buildings Construction Corp. Ltd</data><data key="d2">1</data></node><node id="prec_air_1973_sc_2758"><data key="d0">precedent</data><data key="d1">In Woolcombers of India Ltd. v. Workers' Union</data><data key="d2">1</data></node><node id="prec_2021_scc_online_sc_508"><data key="d0">precedent</data><data key="d1">Ltd. v. Board of Trustees of V.O. Chidambranar Port Trust Tuticorin</data><data key="d2">1</data></node><node id="prec_2021_scc_online_del_5048"><data key="d0">precedent</data><data key="d1">in DMRC vs. Kone Elevators India</data><data key="d2">1</data></node><node id="prec_2023_dhc_2390"><data key="d0">precedent</data><data key="d1">2023:DHC:2390</data><data key="d2">1</data></node><node id="prec_2013_7_scc_452"><data key="d0">precedent</data><data key="d1">Reference was made to CBI vs. Vijay Sai Reddy</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_4279"><data key="d0">precedent</data><data key="d1">In Sanjay Pandey vs. Directorate of Enforcement</data><data key="d2">1</data></node><node id="prec_2023_dhc_2920"><data key="d0">precedent</data><data key="d1">2023:DHC:2920</data><data key="d2">1</data></node><node id="prec_1990_3_scc_682"><data key="d0">precedent</data><data key="d1">Chandigarh v. Presiding Officer</data><data key="d2">1</data></node><node id="prec_2019_9_scc_185"><data key="d0">precedent</data><data key="d1">Reliance was also placed on the judgment in D.A.V. College Trust and Management Society and Others v. Director of Public Instructions and Others</data><data key="d2">1</data></node><node id="prec_2022_2_scc_25"><data key="d0">precedent</data><data key="d1">reliance was placed on the judgment of the Supreme Court in Union of India and Others v. N. Murugesan and Others</data><data key="d2">1</data></node><node id="prec_2013_6_scc_1"><data key="d0">precedent</data><data key="d1">In Novartis AG v. Union of India and Others</data><data key="d2">1</data></node><node id="prec_2015_scc_online_del_13619"><data key="d0">precedent</data><data key="d1">Anr. v. Cipla Ltd</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_516"><data key="d0">precedent</data><data key="d1">By applying the test laid down by this Court in Sotefin SA v. Indraprastha Cancer Society and Research Centre and Others</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_1909"><data key="d0">precedent</data><data key="d1">Inc. v. Controller of Patents</data><data key="d2">1</data></node><node id="prec_2021_scc_online_del_3746"><data key="d0">precedent</data><data key="d1">and FMC Corporation and Others v. GSP Crop Science Private Limited</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_3784"><data key="d0">precedent</data><data key="d1">and FMC Corporation and Others v. GSP Crop Science Private Limited</data><data key="d2">1</data></node><node id="prec_1998_7_scc_123"><data key="d0">precedent</data><data key="d1">(1998) 7 SCC 123</data><data key="d2">1</data></node><node id="prec_2016_6_scc_245"><data key="d0">precedent</data><data key="d1">(2016) 6 SCC 245</data><data key="d2">1</data></node><node id="prec_1982_1_scc_159"><data key="d0">precedent</data><data key="d1">(1982) 1 SCC 159</data><data key="d2">1</data></node><node id="prec_air_2006_delhi_325"><data key="d0">precedent</data><data key="d1">In the case of Akash Gupta v. Frankfinn Institute of Air Hostess Training</data><data key="d2">1</data></node><node id="prec_2023_dhc_5017"><data key="d0">precedent</data><data key="d1">2023:DHC:5017</data><data key="d2">1</data></node><node id="prec_2009_11_scc_522"><data key="d0">precedent</data><data key="d1">ble Supreme Court in Krishna Bhagya Jala Nigam Ltd. Vs Mohammed Rafi reported as</data><data key="d2">1</data></node><node id="prec_2006_1_scc_106"><data key="d0">precedent</data><data key="d1">ble Supreme Court in Krishna Bhagya Jala Nigam Ltd. Vs Mohammed Rafi reported as</data><data key="d2">1</data></node><node id="prec_2005_8_scc_750"><data key="d0">precedent</data><data key="d1">ble Supreme Court in Surendranagar District Panchayat v. Dahyabhai Amarsinh reported as</data><data key="d2">1</data></node><node id="prec_1985_4_scc_201"><data key="d0">precedent</data><data key="d1">Singh Vs. Reserve Bank of India</data><data key="d2">1</data></node><node id="prec_2004_8_scc_161"><data key="d0">precedent</data><data key="d1">In Rajasthan State Ganganagar S. Mills Ltd. v. State of Rajasthan</data><data key="d2">1</data></node><node id="prec_2002_3_scc_25"><data key="d0">precedent</data><data key="d1">year. These aspects were highlighted in Range Forest Officer v. S.T. Hadimani</data><data key="d2">1</data></node><node id="prec_2004_8_scc_195"><data key="d0">precedent</data><data key="d1">Faridabad v. Siri Niwas</data><data key="d2">1</data></node><node id="prec_2004_8_scc_246"><data key="d0">precedent</data><data key="d1">Electricity Board v. Hariram</data><data key="d2">1</data></node><node id="prec_2005_5_scc_100"><data key="d0">precedent</data><data key="d1">In RBI v. S. Mani</data><data key="d2">1</data></node><node id="prec_2005_8_scc_481"><data key="d0">precedent</data><data key="d1">DB Batala Coop. Sugar Mills Ltd. v. Sowaran Singh</data><data key="d2">1</data></node><node id="prec_2010_1_scc_47"><data key="d0">precedent</data><data key="d1">Fisheries Terminal Department Vs. Bhikubhai Meghajibhai Chavda</data><data key="d2">1</data></node><node id="prec_2009_5_scc_65"><data key="d0">precedent</data><data key="d1">judgment delivered in the case of State of Bihar Vs. Upendra Narayan Singh</data><data key="d2">1</data></node><node id="prec_1981_3_scc_225"><data key="d0">precedent</data><data key="d1">Reliance was placed upon the judgment delivered in Mohan Lal Vs. Management of</data><data key="d2">1</data></node><node id="prec_1996_5_scc_419"><data key="d0">precedent</data><data key="d1">Central Bank of India Vs. S. Satyam</data><data key="d2">1</data></node><node id="prec_1999_3_scc_14"><data key="d0">precedent</data><data key="d1">Samishta Dube Vs. City Board</data><data key="d2">1</data></node><node id="prec_2010_3_scc_192"><data key="d0">precedent</data><data key="d1">Harjinder Singh Vs. Punjab State Warehousing Corporation</data><data key="d2">1</data></node><node id="prec_2000_4_scc_245"><data key="d0">precedent</data><data key="d1">of the judgment in Indian Overseas Bank Vs. I.O.B. Staff Canteen Workers' Union</data><data key="d2">1</data></node><node 