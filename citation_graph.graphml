data key="d2">1</data></node><node id="prec_2018_14_scc_81"><data key="d0">precedent</data><data key="d1">(2018) 14 SCC 81</data><data key="d2">1</data></node><node id="prec_2022_5_scc_42"><data key="d0">precedent</data><data key="d1">(2022) 5 SCC 42</data><data key="d2">1</data></node><node id="prec_2009_3_scc_240"><data key="d0">precedent</data><data key="d1">(2009) 3 SCC 240</data><data key="d2">1</data></node><node id="prec_2000_1_scc_512"><data key="d0">precedent</data><data key="d1">(2000) 1 SCC 512</data><data key="d2">1</data></node><node id="prec_1996_9_scc_422"><data key="d0">precedent</data><data key="d1">(1996) 9 SCC 422</data><data key="d2">1</data></node><node id="prec_2022_6_scc_1"><data key="d0">precedent</data><data key="d1">(2022) 6 SCC 1</data><data key="d2">1</data></node><node id="prec_2007_8_scc_66"><data key="d0">precedent</data><data key="d1">decision of this Court in the case of Bapu alias Gujraj Singh v. State of Rajasthan</data><data key="d2">1</data></node><node id="prec_2002_7_scc_748"><data key="d0">precedent</data><data key="d1">Learned counsel has referred to decisions of this Court in Shrikant Anandrao Bhosale v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_2006_10_scc_681"><data key="d0">precedent</data><data key="d1">(2006) 10 SCC 681</data><data key="d2">1</data></node><node id="prec_2003_11_scc_271"><data key="d0">precedent</data><data key="d1">(2003) 11 SCC 271</data><data key="d2">1</data></node><node id="prec_2019_8_scc_333"><data key="d0">precedent</data><data key="d1">The case of Sudru v. State of Chhattisgarh</data><data key="d2">1</data></node><node id="prec_2020_10_scc_166"><data key="d0">precedent</data><data key="d1">In Anwar Ali and Anr. v. State of Himachal Pradesh</data><data key="d2">1</data></node><node id="prec_2010_9_scc_189"><data key="d0">precedent</data><data key="d1">(2010) 9 SCC 189</data><data key="d2">1</data></node><node id="prec_2008_16_scc_73"><data key="d0">precedent</data><data key="d1">(2008) 16 SCC 73</data><data key="d2">1</data></node><node id="prec_2009_9_scc_152"><data key="d0">precedent</data><data key="d1">(2009) 9 SCC 152</data><data key="d2">1</data></node><node id="prec_air_1964_sc_1563"><data key="d0">precedent</data><data key="d1">Learned counsel has referred to decisions of this Court in Shrikant Anandrao Bhosale v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_air_1952_sc_343"><data key="d0">precedent</data><data key="d1">this Court referred to the celebrated decision in Hanumant v. State of Madhya Pradesh</data><data key="d2">1</data></node><node id="prec_2022_scc_online_sc_1532"><data key="d0">precedent</data><data key="d1">The learned counsel has submitted with reference to an observation of this Court in the case of Rahul v. State of Delhi</data><data key="d2">1</data></node><node id="prec_2022_scc_online_sc_673"><data key="d0">precedent</data><data key="d1">decision of this Court in the case of Sabitri Samantaray v. State of Odisha</data><data key="d2">1</data></node><node id="prec_2022_scc_online_sc_176"><data key="d0">precedent</data><data key="d1">we may usefully reiterate the observations in the case of Pappu v. The State of Uttar Pradesh</data><data key="d2">1</data></node><node id="prec_2021_9_scc_732"><data key="d0">precedent</data><data key="d1">(2021) 9 SCC 732</data><data key="d2">1</data></node><node id="prec_2020_4_scc_621"><data key="d0">precedent</data><data key="d1">(2020) 4 SCC 621</data><data key="d2">1</data></node><node id="prec_2011_12_scc_349"><data key="d0">precedent</data><data key="d1">gain in New India Assurance Co. Ltd. v. Genus Power Infrastructure Ltd.15</data><data key="d2">1</data></node><node id="prec_2015_2_scc_424"><data key="d0">precedent</data><data key="d1">(2015) 2 SCC 424</data><data key="d2">1</data></node><node id="prec_2022_scc_online_sc_1328"><data key="d0">precedent</data><data key="d1">2022 SCC OnLine SC 1328</data><data key="d2">1</data></node><node id="prec_2016_12_scc_18"><data key="d0">precedent</data><data key="d1">this Court in the case of Axis Bank v. SBS Organics Private Limited</data><data key="d2">1</data></node><node id="prec_2011_4_scc_548"><data key="d0">precedent</data><data key="d1">After considering the decision of this Court in the case of Narayan Chandra Ghosh v. UCO Bank</data><data key="d2">1</data></node><node id="prec_1980_1_scc_554"><data key="d0">precedent</data><data key="d1">(1980) 1 SCC 554</data><data key="d2">1</data></node><node id="prec_2021_10_scc_773"><data key="d0">precedent</data><data key="d1">this legal position was again reiterated in Satendar Kumar Antil vs CBI</data><data key="d2">1</data></node><node id="prec_1995_4_scc_190"><data key="d0">precedent</data><data key="d1">(1995) 4 SCC 190</data><data key="d2">1</data></node><node id="prec_2011_7_scc_130"><data key="d0">precedent</data><data key="d1">This Court in Krishan Kumar Malik v. State of Haryana4</data><data key="d2">1</data></node><node id="prec_2019_4_scc_771"><data key="d0">precedent</data><data key="d1">(2019) 4 SCC 771</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_201"><data key="d0">precedent</data><data key="d1">circumstantial evidence is well settled. The leading case being Sharad Birdhichand Sarda v. State of Maharashtra. According to it</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_486"><data key="d0">precedent</data><data key="d1">Maharashtra v. Prakash Nishad</data><data key="d2">1</data></node><node id="prec_1995_5_scc_482"><data key="d0">precedent</data><data key="d1">LIC Vs. Consumer Education and Research Centre was relied on to contend that every activity of public authority must be informed by reasons and guided by public interest and the exercise of discretion or power by public authority must be judged by that standard</data><data key="d2">1</data></node><node id="prec_1992_4_scc_477"><data key="d0">precedent</data><data key="d1">Navjyoti Coop.Group Housing Society and Ors. Vs. Union of India</data><data key="d2">1</data></node><node id="prec_1998_4_scc_117"><data key="d0">precedent</data><data key="d1">State of Punjab and Ors. Vs. Ram Lubhaya Bagga</data><data key="d2">1</data></node><node id="prec_1991_3_scc_554"><data key="d0">precedent</data><data key="d1">foreigner as held in Louis De Raedt v. Union of India</data><data key="d2">1</data></node><node id="prec_1976_2_scc_310"><data key="d0">precedent</data><data key="d1">State of Kerala Vs. N.M</data><data key="d2">1</data></node><node id="prec_2001_2_scc_259"><data key="d0">precedent</data><data key="d1">K. Thimmappa Vs. Chairman</data><data key="d2">1</data></node><node id="prec_air_1962_sc_1052"><data key="d0">precedent</data><data key="d1">AIR 1962 SC 1052</data><data key="d2">1</data></node><node id="prec_air_1964_sc_1140"><data key="d0">precedent</data><data key="d1">Indo-China Steam Navigation Co.Ltd. vs. Jasjit Singh</data><data key="d2">1</data></node><node id="prec_air_1955_sc_367"><data key="d0">precedent</data><data key="d1">Hans Muller of Nurenburg Vs. Superintendent</data><data key="d2">1</data></node><node id="prec_air_1952_sc_75"><data key="d0">precedent</data><data key="d1">State of W.B. Vs. Anwar Ali Sarkar as hereunder</data><data key="d2">1</data></node><node id="prec_air_1953_sc_156"><data key="d0">precedent</data><data key="d1">State of West Bengal v. Anwar Ali Sarkar</data><data key="d2">1</data></node><node id="prec_2022_1_scc_676"><data key="d0">precedent</data><data key="d1">(2022) 1 SCC 676</data><data key="d2">1</data></node><node id="prec_2007_3_scc_1"><data key="d0">precedent</data><data key="d1">Reliance is placed on Ram Singh v. Sonia</data><data key="d2">1</data></node><node id="prec_1972_1_scc_249"><data key="d0">precedent</data><data key="d1">Himachal Pradesh Administration v. Shri Om Prakash</data><data key="d2">1</data></node><node id="prec_2003_12_scc_377"><data key="d0">precedent</data><data key="d1">Reliance is placed on the judgment of this Court in Mousam Singha Roy v. State of West Bengal</data><data key="d2">1</data></node><node id="prec_1977_4_scc_540"><data key="d0">precedent</data><data key="d1">Barsay v. State of Bombay AIR</data><data key="d2">1</data></node><node id="prec_2001_7_scc_596"><data key="d0">precedent</data><data key="d1">Barsay v. State of Bombay AIR</data><data key="d2">1</data></node><node id="prec_2011_13_scc_621"><data key="d0">precedent</data><data key="d1">Arif v. State</data><data key="d2">1</data></node><node id="prec_2004_10_scc_657"><data key="d0">precedent</data><data key="d1">Mohmed Inayatullah v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_1988_3_scc_609"><data key="d0">precedent</data><data key="d1">Ors. v. State</data><data key="d2">1</data></node><node id="prec_1974_4_scc_611"><data key="d0">precedent</data><data key="d1">In Bhagwandas Keshwani v. State of Rajasthan</data><data key="d2">1</data></node><node id="prec_2004_11_scc_585"><data key="d0">precedent</data><data key="d1">In Esher Singh v. State of A.P</data><data key="d2">1</data></node><node id="prec_2004_7_scc_779"><data key="d0">precedent</data><data key="d1">(2004) 7 SCC 779</data><data key="d2">1</data></node><node id="prec_2007_11_scc_467"><data key="d0">precedent</data><data key="d1">(2007) 11 SCC 467</data><data key="d2">1</data></node><node id="prec_1978_3_scc_435"><data key="d0">precedent</data><data key="d1">Balbir Singh v. State of Punjab AIR</data><data key="d2">1</data></node><node id="prec_1952_1_scc_275"><data key="d0">precedent</data><data key="d1">The same view has been expressed by this Court in Kashmira Singh v. State of Madhya Pradesh</data><data key="d2">1</data></node><node id="prec_1999_9_scc_525"><data key="d0">precedent</data><data key="d1">through Duli Chand v. State of Haryana</data><data key="d2">1</data></node><node id="prec_2005_9_scc_719"><data key="d0">precedent</data><data key="d1">Ors. v. State of Bihar</data><data key="d2">1</data></node><node id="prec_2001_3_scc_628"><data key="d0">precedent</data><data key="d1">the Supreme Court has pertinently stated in Pawan Kumar v. State of Haryana</data><data key="d2">1</data></node><node id="prec_2001_6_scc_145"><data key="d0">precedent</data><data key="d1">(2001) 6 SCC 145</data><data key="d2">1</data></node><node id="prec_2000_5_scc_197"><data key="d0">precedent</data><data key="d1">Kooveli Poulo v. State of Kerala</data><data key="d2">1</data></node><node id="prec_2000_1_scc_471"><data key="d0">precedent</data><data key="d1">State of Maharashtra v. Suresh</data><data key="d2">1</data></node><node id="prec_2010_2_scc_748"><data key="d0">precedent</data><data key="d1">It was observed in Musheer Khan v. State of M.P</data><data key="d2">1</data></node><node id="prec_2014_4_scc_9"><data key="d0">precedent</data><data key="d1">See also Phula Singh v. State of Himachal Pradesh</data><data key="d2">1</data></node><node id="prec_1999_8_scc_624"><data key="d0">precedent</data><data key="d1">In Koli Lakjhmanbhai Chanabhai v. State of Gujarat</data><data key="d2">1</data></node><node id="prec_1976_1_scc_389"><data key="d0">precedent</data><data key="d1">See also Bhagwan Singh v. State of Haryana</data><data key="d2">1</data></node><node id="prec_1976_1_scc_727"><data key="d0">precedent</data><data key="d1">See also Bhagwan Singh v. State of Haryana</data><data key="d2">1</data></node><node id="prec_1996_3_scc_338"><data key="d0">precedent</data><data key="d1">we place reliance on Tahir v. State</data><data key="d2">1</data></node><node id="prec_1992_4_scc_662"><data key="d0">precedent</data><data key="d1">See also Parasram v. State of Haryana</data><data key="d2">1</data></node><node id="prec_1995_4_scc_255"><data key="d0">precedent</data><data key="d1">Balbir Singh v. State</data><data key="d2">1</data></node><node id="prec_1996_11_scc_139"><data key="d0">precedent</data><data key="d1">Balbir Singh v. State</data><data key="d2">1</data></node><node id="prec_1996_1_scc_427"><data key="d0">precedent</data><data key="d1">Balbir Singh v. State</data><data key="d2">1</data></node><node id="prec_2001_1_scc_652"><data key="d0">precedent</data><data key="d1">(2001) 1 SCC 652</data><data key="d2">1</data></node><node id="prec_2004_2_scc_694"><data key="d0">precedent</data><data key="d1">Ors. v. State of Karnataka</data><data key="d2">1</data></node><node id="prec_2002_7_scc_295"><data key="d0">precedent</data><data key="d1">Ors. v. State of Bihar</data><data key="d2">1</data></node><node id="prec_1999_8_scc_649"><data key="d0">precedent</data><data key="d1">of the Evidence Act. In Rammi alias Rameshwar v. State of M.P</data><data key="d2">1</data></node><node id="prec_1981_2_scc_752"><data key="d0">precedent</data><data key="d1">State of Rajasthan v. Smt Kalki</data><data key="d2">1</data></node><node id="prec_2007_4_scc_415"><data key="d0">precedent</data><data key="d1">Ors. v. State of Karnataka</data><data key="d2">1</data></node><node id="prec_1983_3_scc_217"><data key="d0">precedent</data><data key="d1">in Bharwada Bhoginbhai Hirjibhai v. State of Gujarat</data><data key="d2">1</data></node><node id="prec_1992_2_scc_86"><data key="d0">precedent</data><data key="d1">State of U.P. v. Ashok Kumar Srivastava</data><data key="d2">1</data></node><node id="prec_2006_10_scc_313"><data key="d0">precedent</data><data key="d1">Ors. v. The State of Madhya Pradesh</data><data key="d2">1</data></node><node id="prec_2022_9_scc_81"><data key="d0">precedent</data><data key="d1">Umesh v. Union of India</data><data key="d2">1</data></node><node id="prec_air_1953_sc_459"><data key="d0">precedent</data><data key="d1">Major Puran v. The State of Punjab AIR</data><data key="d2">1</data></node><node id="prec_air_1961_sc_1762"><data key="d0">precedent</data><data key="d1">Barsay v. State of Bombay AIR</data><data key="d2">1</data></node><node id="prec_air_1965_sc_652"><data key="d0">precedent</data><data key="d1">Barsay v. State of Bombay AIR</data><data key="d2">1</data></node><node id="prec_air_1962_sc_1788"><data key="d0">precedent</data><data key="d1">AIR 1962 SC 1788</data><data key="d2">1</data></node><node id="prec_air_1952_sc_159"><data key="d0">precedent</data><data key="d1">in Kashmira Singh v. The State of Madhya Pradesh</data><data key="d2">1</data></node><node id="prec_air_1956_sc_217"><data key="d0">precedent</data><data key="d1">Aher Raja Khima v. State of Saurashtra</data><data key="d2">1</data></node><node id="prec_air_1957_sc_216"><data key="d0">precedent</data><data key="d1">Balbir Singh v. State of Punjab AIR</data><data key="d2">1</data></node><node id="prec_air_1956_sc_460"><data key="d0">precedent</data><data key="d1">Anr. v. State of Punjab</data><data key="d2">1</data></node><node id="prec_2021_scc_online_sc_1131"><data key="d0">precedent</data><data key="d1">Anr. v. The State of U.P</data><data key="d2">1</data></node><node id="prec_2003_4_scc_305"><data key="d0">precedent</data><data key="d1">(2003) 4 SCC 305</data><data key="d2">1</data></node><node id="prec_2019_11_scc_633"><data key="d0">precedent</data><data key="d1">(2019) 11 SCC 633</data><data key="d2">1</data></node><node id="prec_2020_15_scc_1"><data key="d0">precedent</data><data key="d1">Innoventive Industries Ltd. v. ICICI Bank</data><data key="d2">1</data></node><node id="prec_2019_10_scc_750"><data key="d0">precedent</data><data key="d1">Sashidhar v. Indian Overseas Bank</data><data key="d2">1</data></node><node id="prec_2019_9_scc_158"><data key="d0">precedent</data><data key="d1">Gaurav Hargovindbhai Dave v. Asset Reconstruction Co</data><data key="d2">1</data></node><node id="prec_2019_10_scc_572"><data key="d0">precedent</data><data key="d1">Sagar Sharma v. Phoenix ARC</data><data key="d2">1</data></node><node id="prec_2019_10_scc_353"><data key="d0">precedent</data><data key="d1">Sagar Sharma v. Phoenix ARC</data><data key="d2">1</data></node><node id="prec_2018_2_scc_674"><data key="d0">precedent</data><data key="d1">(2018) 2 SCC 674</data><data key="d2">1</data></node><node id="prec_air_1964_sc_669"><data key="d0">precedent</data><data key="d1">so that they may be dealt with in the best possible way for the purpose of its revival by the BIFR. In State of Punjab v. The Okara Grain Buyers Syndicate Ltd. MANU</data><data key="d2">1</data></node><node id="prec_air_1959_sc_356"><data key="d0">precedent</data><data key="d1">see Bhogilal Chunilal Pandya v. State of Bombay</data><data key="d2">1</data></node><node id="prec_2019_12_scc_495"><data key="d0">precedent</data><data key="d1">(2019) 12 SCC 495</data><data key="d2">1</data></node><node id="prec_2023_1_scc_83"><data key="d0">precedent</data><data key="d1">(2023) 1 SCC 83</data><data key="d2">1</data></node><node id="prec_2019_4_scc_522"><data key="d0">precedent</data><data key="d1">(2019) 4 SCC 522</data><data key="d2">1</data></node><node id="prec_2023_6_scc_742"><data key="d0">precedent</data><data key="d1">three-Judge Bench of this Court in Chotkau v. State of Uttar Pradesh</data><data key="d2">1</data></node><node id="prec_2015_9_scc_588"><data key="d0">precedent</data><data key="d1">Mishra v. State of Uttarakhand</data><data key="d2">1</data></node><node id="prec_1974_4_scc_186"><data key="d0">precedent</data><data key="d1">This Court in Raghunandan v. State of U.P. reported in</data><data key="d2">1</data></node><node id="prec_1999_7_scc_69"><data key="d0">precedent</data><data key="d1">This Court in Dandu Lakshmi Reddy v. State of A.P</data><data key="d2">1</data></node><node id="prec_1997_6_scc_162"><data key="d0">precedent</data><data key="d1">This Court in State of Rajasthan v. Ani</data><data key="d2">1</data></node><node id="prec_1981_3_scc_191"><data key="d0">precedent</data><data key="d1">in Ram Chander v. State of Haryana</data><data key="d2">1</data></node><node id="prec_2012_9_scc_320"><data key="d0">precedent</data><data key="d1">In Kunal Majumdar v. State of Rajasthan</data><data key="d2">1</data></node><node id="prec_air_1957_sc_469"><data key="d0">precedent</data><data key="d1">From the long line of decisions which have taken this view it would be enough to refer to the decisions in Jumman v. State of Punjab</data><data key="d2">1</data></node><node id="prec_air_1962_sc_1239"><data key="d0">precedent</data><data key="d1">From the long line of decisions which have taken this view it would be enough to refer to the decisions in Jumman v. State of Punjab</data><data key="d2">1</data></node><node id="prec_air_1968_sc_1438"><data key="d0">precedent</data><data key="d1">From the long line of decisions which have taken this view it would be enough to refer to the decisions in Jumman v. State of Punjab</data><data key="d2">1</data></node><node id="prec_air_1951_sc_441"><data key="d0">precedent</data><data key="d1">as explained in Tara Singh v. State reported in AIR</data><data key="d2">1</data></node><node id="prec_2011_7_scc_59"><data key="d0">precedent</data><data key="d1">See Joseph Salvaraj A. vs. State of Gujarat and others</data><data key="d2">1</data></node><node id="prec_2019_14_scc_568"><data key="d0">precedent</data><data key="d1">In V. Ravi Kumar vs. State represented by Inspector of Police</data><data key="d2">1</data></node><node id="prec_2022_6_scc_599"><data key="d0">precedent</data><data key="d1">in Kahkashan Kausar alias Sonam and others vs. State of Bihar and others</data><data key="d2">1</data></node><node id="prec_2010_7_scc_667"><data key="d0">precedent</data><data key="d1">In Preeti Gupta and another vs. State of Jharkhand and another</data><data key="d2">1</data></node><node id="prec_2009_10_scc_184"><data key="d0">precedent</data><data key="d1">in Neelu Chopra and another vs. Bharti</data><data key="d2">1</data></node><node id="prec_2008_8_scc_148"><data key="d0">precedent</data><data key="d1">Reliance is placed on the decision of this Court in case of Bank of India vs. Ketan Praekh</data><data key="d2">1</data></node><node id="prec_2002_10_scc_194"><data key="d0">precedent</data><data key="d1">(2002) 10 SCC 194</data><data key="d2">1</data></node><node id="prec_2010_4_scc_393"><data key="d0">precedent</data><data key="d1">(2010) 4 SCC 393</data><data key="d2">1</data></node><node id="prec_2002_1_scc_1"><data key="d0">precedent</data><data key="d1">(2002) 1 SCC 1</data><data key="d2">1</data></node><node id="prec_2020_1_scc_1"><data key="d0">precedent</data><data key="d1">(2020) 1 SCC 1</data><data key="d2">1</data></node><node id="prec_2017_7_scc_444"><data key="d0">precedent</data><data key="d1">(2017) 7 SCC 444</data><data key="d2">1</data></node><node id="prec_1991_4_scc_584"><data key="d0">precedent</data><data key="d1">(1991) 4 SCC 584</data><data key="d2">1</data></node><node id="prec_1991_4_scc_406"><data key="d0">precedent</data><data key="d1">Delhi v. State of Gujarat and Others</data><data key="d2">1</data></node><node id="prec_2006_3_scc_699"><data key="d0">precedent</data><data key="d1">and Another v. Madhukar Nowlakha and Others</data><data key="d2">1</data></node><node id="prec_2006_7_scc_296"><data key="d0">precedent</data><data key="d1">Popular Muthiah v. State Represented By Inspector Of Police</data><data key="d2">1</data></node><node id="prec_2001_8_scc_570"><data key="d0">precedent</data><data key="d1">Popular Muthiah v. State Represented By Inspector Of Police</data><data key="d2">1</data></node><node id="prec_2017_8_scc_746"><data key="d0">precedent</data><data key="d1">Karnataka High Court in Roopa Reddy v. Prabhakar Reddy</data><data key="d2">1</data></node><node id="prec_2003_4_scc_675"><data key="d0">precedent</data><data key="d1">This view has been affirmed by the three judges' bench in Gian Singh v. State of Punjab and Another37 and reiterated by another three judges' bench in Jitendra Raghuvanshi and Others v. Babita Raghuvanshi and</data><data key="d2">1</data></node><node id="prec_2012_10_scc_303"><data key="d0">precedent</data><data key="d1">(2012) 10 SCC 303</data><data key="d2">1</data></node><node id="prec_2013_4_scc_58"><data key="d0">precedent</data><data key="d1">in State of Madhya Pradesh v. Laxmi Narayan and Others39</data><data key="d2">1</data></node><node id="prec_2019_5_scc_688"><data key="d0">precedent</data><data key="d1">(2019) 5 SCC 688</data><data key="d2">1</data></node><node id="prec_1975_2_scc_326"><data key="d0">precedent</data><data key="d1">(1975) 2 SCC 326</data><data key="d2">1</data></node><node id="prec_1994_1_scc_337"><data key="d0">precedent</data><data key="d1">(1994) 1 SCC 337</data><data key="d2">1</data></node><node id="prec_1997_4_scc_226"><data key="d0">precedent</data><data key="d1">(1997) 4 SCC 226</data><data key="d2">1</data></node><node id="prec_2011_5_scc_234"><data key="d0">precedent</data><data key="d1">(2011) 5 SCC 234</data><data key="d2">1</data></node><node id="prec_1991_2_scc_25"><data key="d0">precedent</data><data key="d1">(1991) 2 SCC 25</data><data key="d2">1</data></node><node id="prec_2009_13_scc_338"><data key="d0">precedent</data><data key="d1">(2009) 13 SCC 338</data><data key="d2">1</data></node><node id="prec_2004_7_scc_747"><data key="d0">precedent</data><data key="d1">Reliance placed on Gurbux Singh v. Harminder Kaur59</data><data key="d2">1</data></node><node id="prec_2013_9_scc_1"><data key="d0">precedent</data><data key="d1">(2013) 9 SCC 1</data><data key="d2">1</data></node><node id="prec_2010_14_scc_301"><data key="d0">precedent</data><data key="d1">(2010) 14 SCC 301</data><data key="d2">1</data></node><node id="prec_2010_13_scc_298"><data key="d0">precedent</data><data key="d1">nsible for the breakdown of marriage. It was observed that in Vishnu Dutt Sharma v. Manju Sharma62</data><data key="d2">1</data></node><node id="prec_2008_7_scc_734"><data key="d0">precedent</data><data key="d1">(2008) 7 SCC 734</data><data key="d2">1</data></node><node id="prec_2009_6_scc_379"><data key="d0">precedent</data><data key="d1">(2009) 6 SCC 379</data><data key="d2">1</data></node><node id="prec_2002_2_scc_73"><data key="d0">precedent</data><data key="d1">(2002) 2 SCC 73</data><data key="d2">1</data></node><node id="prec_1985_3_scc_62"><data key="d0">precedent</data><data key="d1">(1985) 3 SCC 62</data><data key="d2">1</data></node><node id="prec_2010_4_scc_460"><data key="d0">precedent</data><data key="d1">(2010) 4 SCC 460</data><data key="d2">1</data></node><node id="prec_air_1967_sc_1643"><data key="d0">precedent</data><data key="d1">AIR 1967 SC 1643</data><data key="d2">1</data></node><node id="prec_air_1963_sc_996"><data key="d0">precedent</data><data key="d1">AIR 1963 SC 996</data><data key="d2">1</data></node><node id="prec_air_1960_sc_768"><data key="d0">precedent</data><data key="d1">Others v. State Of Madhya Bharat</data><data key="d2">1</data></node><node id="prec_air_1962_sc_1621"><data key="d0">precedent</data><data key="d1">Others v. State Of Madhya Bharat</data><data key="d2">1</data></node><node id="prec_air_1967_sc_1"><data key="d0">precedent</data><data key="d1">AIR 1967 SC 1</data><data key="d2">1</data></node><node id="prec_2021_scc_online_sc_702"><data key="d0">precedent</data><data key="d1">2021 SCC OnLine SC 702</data><data key="d2">1</data></node><node id="prec_1973_1_scc_805"><data key="d0">precedent</data><data key="d1">(1973) 1 SCC 805</data><data key="d2">1</data></node><node id="prec_2006_8_scc_776"><data key="d0">precedent</data><data key="d1">(2006) 8 SCC 776</data><data key="d2">1</data></node><node id="prec_1970_1_scc_108"><data key="d0">precedent</data><data key="d1">Union of India and Another v. Tulsi Ram Patel</data><data key="d2">1</data></node><node id="prec_1971_1_scc_411"><data key="d0">precedent</data><data key="d1">Sardari Lal v. Union of India and Others</data><data key="d2">1</data></node><node id="prec_2020_13_scc_56"><data key="d0">precedent</data><data key="d1">Nisha Priya Bhatia v. Union of India and Another</data><data key="d2">1</data></node><node id="prec_2013_1_scc_311"><data key="d0">precedent</data><data key="d1">(2013) 1 SCC 311</data><data key="d2">1</data></node><node id="prec_2013_1_scc_312"><data key="d0">precedent</data><data key="d1">(2013) 1 SCC 312</data><data key="d2">1</data></node><node id="prec_2018_12_scc_807"><data key="d0">precedent</data><data key="d1">that the Complaints Committee will be deemed to be an inquiry authority for the State Bank of India and Others v. Ranjit Kumar Chakraborty and Another</data><data key="d2">1</data></node><node id="prec_1999_1_scc_759"><data key="d0">precedent</data><data key="d1">Chief Constable of the North Wales Police v. Evans</data><data key="d2">1</data></node><node id="prec_1995_6_scc_749"><data key="d0">precedent</data><data key="d1">Chaturvedi v. Union of India</data><data key="d2">1</data></node><node id="prec_2020_12_scc_426"><data key="d0">precedent</data><data key="d1">the question that would still beg an answer is Dr. Vijaykumaran C.P.V. v. Central University of Kerala and Others</data><data key="d2">1</data></node><node id="prec_1973_1_scc_500"><data key="d0">precedent</data><data key="d1">(1973) 1 SCC 500</data><data key="d2">1</data></node><node id="prec_2011_5_scc_553"><data key="d0">precedent</data><data key="d1">came to be affirmed by this Court in Savitri Devi Vs. State of U.P</data><data key="d2">1</data></node><node id="prec_2011_12_scc_375"><data key="d0">precedent</data><data key="d1">came to be affirmed by this Court in Savitri Devi Vs. State of U.P</data><data key="d2">1</data></node><node id="prec_2015_7_scc_21"><data key="d0">precedent</data><data key="d1">came to be affirmed by this Court in Savitri Devi Vs. State of U.P</data><data key="d2">1</data></node><node id="prec_1981_4_scc_335"><data key="d0">precedent</data><data key="d1">see Air India v. Nergesh Meerza</data><data key="d2">1</data></node><node id="prec_2020_10_scc_459"><data key="d0">precedent</data><data key="d1">(2020) 10 SCC 459</data><data key="d2">1</data></node><node id="prec_air_1951_sc_118"><data key="d0">precedent</data><data key="d1">could be imposed was considered. In Chintamanrao v. State of M.P</data><data key="d2">1</data></node><node id="prec_air_1952_sc_196"><data key="d0">precedent</data><data key="d1">C.J. in State of Madras v. V.G. Row</data><data key="d2">1</data></node><node id="prec_2006_11_scc_114"><data key="d0">precedent</data><data key="d1">Rama Narang v. Ramesh Narang and Another</data><data key="d2">1</data></node><node id="prec_2007_10_scc_257"><data key="d0">precedent</data><data key="d1">Surana and Another v. State Bank of Hyderabad</data><data key="d2">1</data></node><node id="prec_2010_14_scc_77"><data key="d0">precedent</data><data key="d1">Bharat Steel Tubes Limited v. IFCI Limited</data><data key="d2">1</data></node><node id="prec_2021_7_scc_613"><data key="d0">precedent</data><data key="d1">Abhishek Kumar Singh v. G. Pattanaik and Others</data><data key="d2">1</data></node><node id="prec_2000_2_scc_367"><data key="d0">precedent</data><data key="d1">Co. v. Ashok Kr. Newatia</data><data key="d2">1</data></node><node id="prec_2017_7_scc_342"><data key="d0">precedent</data><data key="d1">any notice to them or hearing them. The High Court could have balanced the equities rather than setting aside the sale deeds already executed bona fide by the Appellant. This Court in T. Ravi and Another v. B. Chinna Narasimha and Others reported in</data><data key="d2">1</data></node><node id="prec_2001_3_scc_739"><data key="d0">precedent</data><data key="d1">Mrityunjoy Das and Another v. Sayed Hasibur Rahaman and Others</data><data key="d2">1</data></node><node id="prec_1988_4_scc_592"><data key="d0">precedent</data><data key="d1">(1988) 4 SCC

