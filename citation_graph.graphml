ta key="d0">precedent</data><data key="d1">Refer to Baldev Singh Bajwa v. Monish Saini</data><data key="d2">2</data></node><node id="prec_2022_6_scc_30"><data key="d0">precedent</data><data key="d1">This settled proposition of law regarding scope of revision has been comprehensively discussed by the Apex Court in Abid-ul-Islam v. Inder Sain Dua</data><data key="d2">2</data></node><node id="prec_1998_8_scc_119"><data key="d0">precedent</data><data key="d1">except by quoting the decision of this Court in Sarla Ahuja v. United India Insurance Co. Ltd</data><data key="d2">2</data></node><node id="prec_1980_4_scc_259"><data key="d0">precedent</data><data key="d1">In Sri Raja Lakshmi Dyeing Works v. Rangaswamy Chettiar</data><data key="d2">2</data></node><node id="prec_1969_1_scc_688"><data key="d0">precedent</data><data key="d1">In Malini Ayyappa Naicker v. Seth Manghraj Udhavadas</data><data key="d2">2</data></node><node id="prec_1988_3_scc_131"><data key="d0">precedent</data><data key="d1">In Ram Dass v. Ishwar Chander</data><data key="d2">2</data></node><node id="prec_1996_5_scc_353"><data key="d0">precedent</data><data key="d1">In Prativa Devi v. T.V. Krishnan</data><data key="d2">2</data></node><node id="prec_air_1963_sc_698"><data key="d0">precedent</data><data key="d1">three-Judge Bench of this Court has stated thus in Hari Shankar v. Rao Girdhari Lal Chowdhury</data><data key="d2">2</data></node><node id="prec_2019_scc_online_del_8147"><data key="d0">precedent</data><data key="d1">Reliance is placed on the judgments of this Court in Bata India Limited v. Chawla Boot House</data><data key="d2">2</data></node><node id="prec_air_1963_sc_1241"><data key="d0">precedent</data><data key="d1">In the case of State of West Bengal v. Union of India</data><data key="d2">2</data></node><node id="prec_2013_1_scc_197"><data key="d0">precedent</data><data key="d1">(2013) 1 SCC 197</data><data key="d2">2</data></node><node id="prec_2020_20_scc_760"><data key="d0">precedent</data>