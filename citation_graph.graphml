ata></node><node id="prec_1979_3_scc_745"><data key="d0">precedent</data><data key="d1">(1979) 3 SCC 745</data><data key="d2">1</data></node><node id="prec_2001_4_scc_458"><data key="d0">precedent</data><data key="d1">(2001) 4 SCC 458</data><data key="d2">1</data></node><node id="prec_2013_2_scc_452"><data key="d0">precedent</data><data key="d1">not in agreement with the opinion expressed by this Court in Sangeet v. State of Haryana</data><data key="d2">1</data></node><node id="prec_2019_12_scc_438"><data key="d0">precedent</data><data key="d1">(2019) 12 SCC 438</data><data key="d2">1</data></node><node id="prec_2020_scc_online_sc_791"><data key="d0">precedent</data><data key="d1">Reliance was placed on Arvind Singh v. State of Maharashtra18 for the submission that if</data><data key="d2">1</data></node><node id="prec_2021_8_scc_784"><data key="d0">precedent</data><data key="d1">Reliance is placed on the decisions of this Court in the case of Punjab State Cooperative Milk Producers Federation Limited and Another versus Balbir Kumar Walia and others</data><data key="d2">1</data></node><node id="prec_2019_10_scc_674"><data key="d0">precedent</data><data key="d1">Reliance is placed on the decisions of this Court in the case of Punjab State Cooperative Milk Producers Federation Limited and Another versus Balbir Kumar Walia and others</data><data key="d2">1</data></node><node id="prec_2015_3_scc_653"><data key="d0">precedent</data><data key="d1">Odisha and Others versus Pramod Kumar Sahoo</data><data key="d2">1</data></node><node id="prec_1998_1_scc_687"><data key="d0">precedent</data><data key="d1">(1998) 1 SCC 687</data><data key="d2">1</data></node><node id="prec_2008_4_scc_67"><data key="d0">precedent</data><data key="d1">(2008) 4 SCC 67</data><data key="d2">1</data></node><node id="prec_2008_5_scc_535"><data key="d0">precedent</data><data key="d1">(2008) 5 SCC 535</data><data key="d2">1</data></node><node id="prec_2019_5_scc_418"><data key="d0">precedent</data><data key="d1">(2019) 5 SCC 418</data><data key="d2">1</data></node><node id="prec_2019_4_scc_197"><data key="d0">precedent</data><data key="d1">(2019) 4 SCC 197</data><data key="d2">1</data></node><node id="prec_2019_18_scc_106"><data key="d0">precedent</data><data key="d1">(2019) 18 SCC 106</data><data key="d2">1</data></node><node id="prec_2021_5_scc_283"><data key="d0">precedent</data><data key="d1">(2021) 5 SCC 283</data><data key="d2">1</data></node><node id="prec_1984_3_scc_654"><data key="d0">precedent</data><data key="d1">as this Court in the case of Dr. Pradeep Jain and Others v. Union of India and Others</data><data key="d2">1</data></node><node id="prec_2003_11_scc_146"><data key="d0">precedent</data><data key="d1">We must add that institutional and residential requirements were further held to be permissible in the case of Saurabh Chaudhari and Others. v. Union of India and Others reported in</data><data key="d2">1</data></node><node id="prec_2003_11_scc_186"><data key="d0">precedent</data><data key="d1">this Court in Magan Mehrotra and Others v. Union of India and Others reported in</data><data key="d2">1</data></node><node id="prec_2018_17_scc_524"><data key="d0">precedent</data><data key="d1">this Court in Magan Mehrotra and Others v. Union of India and Others reported in</data><data key="d2">1</data></node><node id="prec_2001_2_scc_451"><data key="d0">precedent</data><data key="d1">the learned Senior counsel appearing for EVEY placed strong reliance on the decision of this Court in W.B. State Electricity Board v. Patel Engineering Co. Ltd</data><data key="d2">1</data></node><node id="prec_2002_6_scc_315"><data key="d0">precedent</data><data key="d1">He placed strong reliance on the decision of this Court in the case of Kanhaiya Lal Agrawal v. Union of India and Others</data><data key="d2">1</data></node><node id="prec_2022_6_scc_127"><data key="d0">precedent</data><data key="d1">Projects Limited v. Vinod Kumar Jain and Others</data><data key="d2">1</data></node><node id="prec_1999_1_scc_492"><data key="d0">precedent</data><data key="d1">Relying on the decisions of this Court in Raunaq International Ltd. v. I.V.R. Construction Ltd. and Others reported in</data><data key="d2">1</data></node><node id="prec_2008_5_scc_772"><data key="d0">precedent</data><data key="d1">Company v. Orrisa Mining Corporation Limited reported in</data><data key="d2">1</data></node><node id="prec_1991_3_scc_273"><data key="d0">precedent</data><data key="d1">The decisions of this Court in Poddar Steel Corporation v. Ganesh Engineering Works and Others</data><data key="d2">1</data></node><node id="prec_2000_5_scc_287"><data key="d0">precedent</data><data key="d1">Ltd v. Commissioner</data><data key="d2">1</data></node><node id="prec_2009_6_scc_171"><data key="d0">precedent</data><data key="d1">Ltd v. Commissioner</data><data key="d2">1</data></node><node id="prec_2014_3_scc_760"><data key="d0">precedent</data><data key="d1">Ltd v. Commissioner</data><data key="d2">1</data></node><node id="prec_1991_1_scc_761"><data key="d0">precedent</data><data key="d1">Ltd v. Raja Kamakshya Narain Singh Etc</data><data key="d2">1</data></node><node id="prec_2020_16_scc_489"><data key="d0">precedent</data><data key="d1">Silppi Constructions Contractors v. Union of India</data><data key="d2">1</data></node><node id="prec_2005_1_scc_679"><data key="d0">precedent</data><data key="d1">three-Judge Bench decision of this Court in Association of Registration Plates v. Union of India and Others</data><data key="d2">1</data></node><node id="prec_2000_2_scc_617"><data key="d0">precedent</data><data key="d1">The law relating to award of contract by the State and public sector corporations was reviewed in Air India Ltd. v. Cochin International Airport Ltd</data><data key="d2">1</data></node><node id="prec_2007_14_scc_517"><data key="d0">precedent</data><data key="d1">As observed by this Court in Jagdish Mandal v. State of Orissa and Others</data><data key="d2">1</data></