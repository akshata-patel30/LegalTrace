 key="d0">precedent</data><data key="d1">2021 SCC OnLine SC 552</data><data key="d2">1</data></node><node id="prec_2018_scc_online_del_9516"><data key="d0">precedent</data><data key="d1">2018 SCC OnLine Del 9516</data><data key="d2">1</data></node><node id="prec_1952_scc_online_sc_64"><data key="d0">precedent</data><data key="d1">1952 SCC OnLine SC 64</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_4499"><data key="d0">precedent</data><data key="d1">2022 SCC OnLine Del 4499</data><data key="d2">1</data></node><node id="prec_2014_scc_online_del_821"><data key="d0">precedent</data><data key="d1">Pentel Kabushiki Kaisha v. Arora Stationers53</data><data key="d2">1</data></node><node id="prec_1991_3_scc_655"><data key="d0">precedent</data><data key="d1">(1991) 3 SCC 655</data><data key="d2">1</data></node><node id="prec_2013_3_scc_77"><data key="d0">precedent</data><data key="d1">Reliance has been placed on Suresh Kumar Bhikamchand Jain v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_air_1988_sc_1531"><data key="d0">precedent</data><data key="d1">AIR 1988 SC 1531</data><data key="d2">1</data></node><node id="prec_air_2001_sc_2023"><data key="d0">precedent</data><data key="d1">AIR 2001 SC 2023</data><data key="d2">1</data></node><node id="prec_air_2013_sc_296"><data key="d0">precedent</data><data key="d1">AIR 2013 SC 296</data><data key="d2">1</data></node><node id="prec_air_2015_sc_1002"><data key="d0">precedent</data><data key="d1">It has been submitted that reliance of the petitioner CBI in Narendra Kumar Amin v. CBI</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_3633"><data key="d0">precedent</data><data key="d1">2022 SCC OnLine Del 3633</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_180"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine SC 180</data><data key="d2">1</data></node><node id="prec_2023_7_scc_1"><data key="d0">precedent</data><data key="d1">(2023) 7 SCC 1</data><data key="d2">1</data></node><node id="prec_air_1963_sc_1307"><data key="d0">precedent</data><data key="d1">AIR 1963 SC 1307</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_495"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine SC 495</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_3598"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine Del 3598</data><data key="d2">1</data></node><node id="prec_2010_scc_online_del_1144"><data key="d0">precedent</data><data key="d1">Nilesh Shantilal Tank v. Jairaj Devidas</data><data key="d2">1</data></node><node id="prec_2023_dhc_000634"><data key="d0">precedent</data><data key="d1">2023/DHC/000634</data><data key="d2">1</data></node><node id="prec_2009_13_scc_55"><data key="d0">precedent</data><data key="d1">he submitted that the respondent ought to be estopped in line with the Supreme Court judgment of estoppel in Pepsico India Holdings Private Limited Vs. State of Kerala and Ors</data><data key="d2">1</data></node><node id="prec_2016_scc_online_del_2912"><data key="d0">precedent</data><data key="d1">this Court in Tata Teleservices Limited Vs Central Board of Direct Taxes</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_31"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine SC 31</data><data key="d2">1</data></node><node id="prec_2023_dhc_2862"><data key="d0">precedent</data><data key="d1">2023:DHC:2862</data><data key="d2">1</data></node><node id="prec_2004_3_scc_688"><data key="d0">precedent</data><data key="d1">(2004) 3 SCC 688</data><data key="d2">1</data></node><node id="prec_2006_9_scc_41"><data key="d0">precedent</data><data key="d1">(2006) 9 SCC 41</data><data key="d2">1</data></node><node id="prec_1994_4_scc_711"><data key="d0">precedent</data><data key="d1">(1994) 4 SCC 711</data><data key="d2">1</data></node><node id="prec_1991_4_scc_270"><data key="d0">precedent</data><data key="d1">The Division Bench first relied on the decisions in Patel Roadways Ltd v. Prasad Trading Co.26 and New</data><data key="d2">1</data></node><node id="prec_2004_4_scc_677"><data key="d0">precedent</data><data key="d1">(2004) 4 SCC 677</data><data key="d2">1</data></node><node id="prec_air_1966_sc_543"><data key="d0">precedent</data><data key="d1">AIR 1966 SC 543</data><data key="d2">1</data></node><node id="prec_2017_scc_online_del_12698"><data key="d0">precedent</data><data key="d1">2017 SCC OnLine Del 12698</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_2968"><data key="d0">precedent</data><data key="d1">2022 SCC OnLine Del 2968</data><data key="d2">1</data></node><node id="prec_2018_scc_online_del_10881"><data key="d0">precedent</data><data key="d1">the decision of the Court of Appeals in the UK in Lifestyle Equities CV v. Amazon UK Services Ltd30</data><data key="d2">1</data></node><node id="prec_2018_scc_online_del_8260"><data key="d0">precedent</data><data key="d1">the decision of the Court of Appeals in the UK in Lifestyle Equities CV v. Amazon UK Services Ltd30</data><data key="d2">1</data></node><node id="prec_1987_4_scc_193"><data key="d0">precedent</data><data key="d1">(1987) 4 SCC 193</data><data key="d2">1</data></node><node id="prec_2018_6_scc_744"><data key="d0">precedent</data><data key="d1">Ltd. v. W. Newman</data><data key="d2">1</data></node><node id="prec_2019_20_scc_182"><data key="d0">precedent</data><data key="d1">Ltd. v. W. Newman</data><data key="d2">1</data></node><node id="prec_2002_3_scc_375"><data key="d0">precedent</data><data key="d1">Sheela v. Firm Prahlad Rai Prem Prakash</data><data key="d2">1</data></node><node id="prec_2016_3_scc_343"><data key="d0">precedent</data><data key="d1">Sheela v. Firm Prahlad Rai Prem Prakash</data><data key="d2">1</data></node><node id="prec_1991_4_scc_572"><data key="d0">precedent</data><data key="d1">(1991) 4 SCC 572</data><data key="d2">1</data></node><node id="prec_1991_2_scc_87"><data key="d0">precedent</data><data key="d1">In Surjit Singh Kalra v. Union of India</data><data key="d2">1</data></node><node id="prec_2014_15_scc_610"><data key="d0">precedent</data><data key="d1">(2014) 15 SCC 610</data><data key="d2">1</data></node><node id="prec_air_1999_sc_100"><data key="d0">precedent</data><data key="d1">AIR 1999 SC 100</data><data key="d2">1</data></node><node id="prec_2014_scc_online_del_1506"><data key="d0">precedent</data><data key="d1">2014 SCC OnLine Del 1506</data><data key="d2">1</data></node><node id="prec_1995_scc_online_del_373"><data key="d0">precedent</data><data key="d1">1995 SCC OnLine Del 373</data><data key="d2">1</data></node><node id="prec_2023_dhc_2994"><data key="d0">precedent</data><data key="d1">2023:DHC:2994</data><data key="d2">1</data></node><node id="prec_2007_7_scc_798"><data key="d0">precedent</data><data key="d1">Ranjitsing Brahmajeetsingh Sharma vs. State of Maharashtra5and Union of India vs. Shiv Shanker Kesari6</data><data key="d2">1</data></node><node id="prec_2012_1_scc_14"><data key="d0">precedent</data><data key="d1">(2012) 1 SCC 14</data><data key="d2">1</data></node><node id="prec_2020_11_scc_648"><data key="d0">precedent</data><data key="d1">(2020) 11 SCC 648</data><data key="d2">1</data></node><node id="prec_2020_13_scc_337"><data key="d0">precedent</data><data key="d1">(2020) 13 SCC 337</data><data key="d2">1</data></node><node id="prec_2004_2_scc_362"><data key="d0">precedent</data><data key="d1">(2004) 2 SCC 362</data><data key="d2">1</data></node><node id="prec_2019_9_scc_165"><data key="d0">precedent</data><data key="d1">and Serious Fraud Investigation Office vs. Nittin Johari</data><data key="d2">1</data></node><node id="prec_2018_13_scc_813"><data key="d0">precedent</data><data key="d1">(2018) 13 SCC 813</data><data key="d2">1</data></node><node id="prec_1999_6_scc_172"><data key="d0">precedent</data><data key="d1">State of Punjab vs. Baldev Singh</data><data key="d2">1</data></node><node id="prec_air_1958_sc_448"><data key="d0">precedent</data><data key="d1">Rajendra Shah vs. State of Maharashtra16</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_657"><data key="d0">precedent</data><data key="d1">Ranjitsing Brahmajeetsingh Sharma vs. State of Maharashtra5and Union of India vs. Shiv Shanker Kesari6</data><data key="d2">1</data></node><node id="prec_2017_scc_online_del_8676"><data key="d0">precedent</data><data key="d1">Ranjitsing Brahmajeetsingh Sharma vs. State of Maharashtra5and Union of India vs. Shiv Shanker Kesari6</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_1917"><data key="d0">precedent</data><data key="d1">2022 SCC OnLine Del 1917</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_2095"><data key="d0">precedent</data><data key="d1">2022 SCC OnLine Del 2095</data><data key="d2">1</data></node><node id="prec_2010_scc_online_del_130"><data key="d0">precedent</data><data key="d1">Rajendra Shah vs. State of Maharashtra16</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_276"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine Del 276</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_352"><data key="d0">precedent</data><data key="d1">Muslim alias Hussain vs. State</data><data key="d2">1</data></node><node id="prec_air_2013_sc_681"><data key="d0">precedent</data><data key="d1">Court in Manohar v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_940"><data key="d0">precedent</data><data key="d1">Co-ordinate Bench of this Court in Agriboard International LLC v. Deputy Controller of Patents and Designs</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_4568"><data key="d0">precedent</data><data key="d1">and also by me in N.V. Satheesh Madhav and Anr v. Deputy Controller of Patents and Designs</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_4429"><data key="d0">precedent</data><data key="d1">Ltd v. Assistant Controller of Patents and Designs</data><data key="d2">1</data></node><node id="prec_2003_6_scc_545"><data key="d0">precedent</data><data key="d1">The Supreme Court in Chandra Singh v. State of Rajasthan</data><data key="d2">1</data></node><node id="prec_2005_6_scc_454"><data key="d0">precedent</data><data key="d1">in Taherakhatoon v. Salambin Mohammad</data><data key="d2">1</data></node><node id="prec_1999_2_scc_635"><data key="d0">precedent</data><data key="d1">in Taherakhatoon v. Salambin Mohammad</data><data key="d2">1</data></node><node id="prec_2004_4_scc_714"><data key="d0">precedent</data><data key="d1">drastic inhibiting effect on its functioning. The scope of power of judicial review was also laid down by the Supreme court in State of U.P. v. Johri Mal</data><data key="d2">1</data></node><node id="prec_2010_scc_online_del_4706"><data key="d0">precedent</data><data key="d1">In Shumel v. Union of India and Ors</data><data key="d2">1</data></node><node id="prec_2016_scc_online_del_3660"><data key="d0">precedent</data><data key="d1">The said judgment has been quoted with approval in Sushil Kumar v. Union of India</data><data key="d2">1</data></node><node id="prec_2011_scc_online_del_3496"><data key="d0">precedent</data><data key="d1">2011 SCC OnLine Del 3496</data><data key="d2">1</data></node><node id="prec_2006_scc_online_del_471"><data key="d0">precedent</data><data key="d1">this Court is not bound to exercise discretionary jurisdiction and in Babu Ram Sagar v. Labour Court</data><data key="d2">1</data></node><node id="prec_2006_scc_online_del_1648"><data key="d0">precedent</data><data key="d1">this Court is not bound to exercise discretionary jurisdiction and in Babu Ram Sagar v. Labour Court</data><data key="d2">1</data></node><node id="prec_2021_scc_online_del_4479"><data key="d0">precedent</data><data key="d1">Committee of Administrators was appointed by this Court in Manika Batra v. Table Tennis Federation of India</data><data key="d2">1</data></node><node id="prec_2016_scc_online_del_6766"><data key="d0">precedent</data><data key="d1">Sushil Kumar v. Union of India</data><data key="d2">1</data></node><node id="prec_2018_scc_online_del_8443"><data key="d0">precedent</data><data key="d1">In Paralympic Committee of India v. Naresh Kumar Sharma</data><data key="d2">1</data></node><node id="prec_2010_7_scc_626"><data key="d0">precedent</data><data key="d1">(2010) 7 SCC 626</data><data key="d2">1</data></node><node id="prec_2002_1_scc_633"><data key="d0">precedent</data><data key="d1">(2002) 1 SCC 633</data><data key="d2">1</data></node><node id="prec_2021_15_scc_125"><data key="d0">precedent</data><data key="d1">(2021) 15 SCC 125</data><data key="d2">1</data></node><node id="prec_2023_dhc_2528"><data key="d0">precedent</data><data key="d1">2023:DHC:2528</data><data key="d2">1</data></node><node id="prec_2013_scc_online_del_4986"><data key="d0">precedent</data><data key="d1">Limited v. Naga Limited</data><data key="d2">1</data></node><node id="prec_2015_scc_online_del_8115"><data key="d0">precedent</data><data key="d1">Limited v. Naga Limited</data><data key="d2">1</data></node><node id="prec_2010_scc_online_del_391"><data key="d0">precedent</data><data key="d1">Limited v. Naga Limited</data><data key="d2">1</data></node><node id="prec_2003_scc_online_del_365"><data key="d0">precedent</data><data key="d1">2003 SCC OnLine Del 365</data><data key="d2">1</data></node><node id="prec_2019_scc_online_del_9022"><data key="d0">precedent</data><data key="d1">2019 SCC OnLine Del 9022</data><data key="d2">1</data></node><node id="prec_2023_dhc_001454"><data key="d0">precedent</data><data key="d1">2023/DHC/001454</data><data key="d2">1</data></node><node id="prec_2020_2_scc_708"><data key="d0">precedent</data><data key="d1">(2020) 2 SCC 708</data><data key="d2">1</data></node><node id="prec_2018_6_scc_639"><data key="d0">precedent</data><data key="d1">the Supreme Court by referring to its judgment in Atcom Technologies Ltd. VS. Y.A. Chunawala</data><data key="d2">1</data></node><node id="prec_2008_3_scc_70"><data key="d0">precedent</data><data key="d1">In Singh Enterprises v. Commissioner of Central Excise</data><data key="d2">1</data></node><node id="prec_2009_5_scc_791"><data key="d0">precedent</data><data key="d1">in Commissioner of Customs and Central Excise v. Hongo India Private Limited</data><data key="d2">1</data></node><node id="prec_2020_5_scc_757"><data key="d0">precedent</data><data key="d1">In New India Assurance Company Limited v. Hili Multipurpose Cold Storage Private Limited</data><data key="d2">1</data></node><node id="prec_1974_2_scc_133"><data key="d0">precedent</data><data key="d1">Hukumdev Narain Yadav v. Lalit Narain Mishra</data><data key="d2">1</data></node><node id="prec_2008_2_scc_488"><data key="d0">precedent</data><data key="d1">have been highlighted in State of Uttar Pradesh v. Roshan Singh</data><data key="d2">1</data></node><node id="prec_2001_7_scc_549"><data key="d0">precedent</data><data key="d1">we need not travel beyond Pallav Sheth v. Custodian</data><data key="d2">1</data></node><node id="prec_1975_2_scc_232"><data key="d0">precedent</data><data key="d1">Reference may also be made to Maheshwar Prasad v. Kanahaiya Lal</data><data key="d2">1</data></node><node id="prec_1989_3_scc_396"><data key="d0">precedent</data><data key="d1">in Sundarjas Kanyalal Bhathija v. The Collector</data><data key="d2">1</data></node><node id="prec_1980_3_scc_719"><data key="d0">precedent</data><data key="d1">On this aspect another relevant judicial pronouncement comes in Ambika Prasad v. State of U.P</data><data key="d2">1</data></node><node id="prec_air_2005_sc_514"><data key="d0">precedent</data><data key="d1">AIR 2005 SC 514</data><data key="d2">1</data></node><node id="prec_air_1979_del_217"><data key="d0">precedent</data><data key="d1">In Print Pak Machinery Ltd. v. Jay Kay Papers Converters</data><data key="d2">1</data></node><node id="prec_air_1930_cal_685"><data key="d0">precedent</data><data key="d1">Banerji v. Kunjilal Biswas</data><data key="d2">1</data></node><node id="prec_air_1930_cal_324"><data key="d0">precedent</data><data key="d1">Banerji v. Kunjilal Biswas</data><data key="d2">1</data></node><node id="prec_air_1932_cal_1"><data key="d0">precedent</data><data key="d1">Co. v. B. Shamaldas</data><data key="d2">1</data></node><node id="prec_air_1954_cal_369"><data key="d0">precedent</data><data key="d1">and Manickchand Durgaprasad v. Pratabmull Rameswar</data><data key="d2">1</data></node><node id="prec_air_1961_cal_483"><data key="d0">precedent</data><data key="d1">and Manickchand Durgaprasad v. Pratabmull Rameswar</data><data key="d2">1</data></node><node id="prec_air_1962_sc_247"><data key="d0">precedent</data><data key="d1">The Union of India v. Ram Kanwar</data><data key="d2">1</data></node><node id="prec_air_1975_sc_907"><data key="d0">precedent</data><data key="d1">Reference may also be made to Maheshwar Prasad v. Kanahaiya Lal</data><data key="d2">1</data></node><node id="prec_air_1990_sc_261"><data key="d0">precedent</data><data key="d1">in Sundarjas Kanyalal Bhathija v. The Collector</data><data key="d2">1</data></node><node id="prec_air_1980_sc_1762"><data key="d0">precedent</data><data key="d1">On this aspect another relevant judicial pronouncement comes in Ambika Prasad v. State of U.P</data><data key="d2">1</data></node><node id="prec_2022_scc_online_sc_613"><data key="d0">precedent</data><data key="d1">2022 SCC OnLine SC 613</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_84"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine Del 84</data><data key="d2">1</data></node><node id="prec_2020_scc_online_del_1353"><data key="d0">precedent</data><data key="d1">2020 SCC OnLine Del 1353</data><data key="d2">1</data></node><node id="prec_2021_scc_online_del_2629"><data key="d0">precedent</data><data key="d1">learned Judge of the Court in Harjyot Singh vs Manpreet Kaur13. Upon due consideration of the judgments of the Supreme Court in Desh Raj and Salem Advocate</data><data key="d2">1</data></node><node id="prec_2012_scc_online_del_4794"><data key="d0">precedent</data><data key="d1">2012 SCC OnLine Del 4794</data><data key="d2">1</data></node><node id="prec_2021_scc_online_del_5398"><data key="d0">precedent</data><data key="d1">2021 SCC OnLine Del 5398</data><data key="d2">1</data></node><node id="prec_2023_dhc_3438"><data key="d0">precedent</data><data key="d1">Kashif v. NCB</data><data key="d2">1</data></node><node id="prec_1969_3_scc_429"><data key="d0">precedent</data><data key="d1">ble Supreme Court in Mohd. Husain Umar Kochra Etc. v. K.S. Dalipsinghji and Anr. Etc</data><data key="d2">1</data></node><node id="prec_2005_9_scc_773"><data key="d0">precedent</data><data key="d1">Reliance in this regard is placed on the judgment of the Hon'ble Supreme Court in Rajesh Jagdamba Avasthi v. State of Goa</data><data key="d2">1</data></node><node id="prec_2000_2_scc_513"><data key="d0">precedent</data><data key="d1">Abdul Rashid Ibrahim Mansuri v. State of Gujarat</data><data key="d2">1</data></node><node id="prec_2005_11_scc_600"><data key="d0">precedent</data><data key="d1">(2005) 11 SCC 600</data><data key="d2">1</data></node><node id="prec_air_1957_sc_340"><data key="d0">precedent</data><data key="d1">Swaminathan v. State of Madras</data><data key="d2">1</data></node><node id="prec_2006_3_scc_374"><data key="d0">precedent</data><data key="d1">(2006) 3 SCC 374</data><data key="d2">1</data></node><node id="prec_2018_11_scc_163"><data key="d0">precedent</data><data key="d1">In State of Maharashtra v. Bandu</data><data key="d2">1</data></node><node id="prec_2022_scc_online_sc_78"><data key="d0">precedent</data><data key="d1">ble Apex Court in Smruti Tukaram Badade v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_2023_dhc_2375"><data key="d0">precedent</data><data key="d1">2023:DHC:2375</data><data key="d2">1</data></node><node id="prec_1993_1scc_78"><data key="d0">precedent</data><data key="d1">Gautam v. Union of India</data><data key="d2">1</data></node><node id="prec_2004_7_scc_68"><data key="d0">precedent</data><data key="d1">In the case of Godawat Pan Masala v. Union of India</data><data key="d2">1</data></node><node id="prec_1998_1_scc_318"><data key="d0">precedent</data><data key="d1">reliance was placed on the case of State of T.N. v. K. Sabanayagam</data><data key="d2">1</data></node><node id="prec_1952_2_scc_41"><data key="d0">precedent</data><data key="d1">(1952) 2 SCC 41</data><data key="d2">1</data></node><node id="prec_1974_1_scc_167"><data key="d0">precedent</data><data key="d1">(1974) 1 SCC 167</data><data key="d2">1</data></node><node id="prec_1980_1_scc_167"><data key="d0">precedent</data><data key="d1">(1980) 1 SCC 167</data><data key="d2">1</data></node><node id="prec_1996_4_scc_513"><data key="d0">precedent</data><data key="d1">Constitution Bench of this Court in Pyarali K. Tejani v. Mahadeo Ramchandra Dange</data><data key="d2">1</data></node><node id="prec_2004_1_scc_256"><data key="d0">precedent</data><data key="d1">Harrisons Malayalam v. Union of India</data><data key="d2">1</data></node><node id="prec_2018_7_scc_365"><data key="d0">precedent</data><data key="d1">Mr. Narayan also placed reliance upon the judgment rendered by the Telangana High Court in Sri Kamadhenu Traders v. State of</data><data key="d2">1</data></node><node id="prec_2016_2_scc_161"><data key="d0">precedent</data><data key="d1">(2016) 2 SCC 161</data><data key="d2">1</data></node><node id="prec_1973_1_scc_227"><data key="d0">precedent</data><data key="d1">(1973) 1 SCC 227</data><data key="d2">1</data></node><node id="prec_1994_4_scc_406"><data key="d0">precedent</data><data key="d1">(1994) 4 SCC 406</data><data key="d2">1</data></node><node id="prec_2005_2_scc_515"><data key="d0">precedent</data><data key="d1">and to trade wherein there could be said to be no fundamental right and which aspect remained undealt in the appeal therefrom reported as Godfrey Phillips India Ltd. v. State of U.P</data><data key="d2">1</data></node><node id="prec_1995_1_scc_574"><data key="d0">precedent</data><data key="d1">leading to the legislation such as COTPA. The Supreme Court in Khoday Distilleries Ltd. v. State of Karnataka</data><data key="d2">1</data></node><node id="prec_1994_5_scc_509"><data key="d0">precedent</data><data key="d1">and in Ramesh Chandra Kachardas Porwal v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_1981_2_scc_722"><data key="d0">precedent</data><data key="d1">and in Ramesh Chandra Kachardas Porwal v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_2019_10_scc_575"><data key="d0">precedent</data><data key="d1">(2019) 10 SCC 575</data><data key="d2">1</data></node><node id="prec_2002_9_scc_232"><data key="d0">precedent</data><data key="d1">(2002) 9 SCC 232</data><data key="d2">1</data></node><node id="prec_1980_4_scc_136"><data key="d0">precedent</data><data key="d1">(1980) 4 SCC 136</data><data key="d2">1</data></node><node id="prec_1999_9_scc_620"><data key="d0">precedent</data><data key="d1">Constitution Bench in Belsund Sugar Co. Ltd. v. State of Bihar</data><data key="d2">1</data></node><node id="prec_1980_1_scc_223"><data key="d0">precedent</data><data key="d1">(1980) 1 SCC 223</data><data key="d2">1</data></node><node id="prec_1969_3_scc_838"><data key="d0">precedent</data><data key="d1">(1969) 3 SCC 838</data><data key="d2">1</data></node><node id="prec_1977_1_scc_340"><data key="d0">precedent</data><data key="d1">in State of Haryana v. Chanan Mal</data><data key="d2">1</data></node><node id="prec_1972_2_scc_218"><data key="d0">precedent</data><data key="d1">making the declaration does not comprehend the power of acquisition if it is not so specifically spelt out. In Kannan Devan Hills Produce Company Ltd. v. State of Kerala</data><data key="d2">1</data></node><node id="prec_1989_1_scc_420"><data key="d0">precedent</data><data key="d1">reference of this Court's judgment in Dineshchandra Jamnadas Gandhi v. State of Gujarat</data><data key="d2">1</data></node><node id="prec_1976_1_scc_412"><data key="d0">precedent</data><data key="d1">of Delhi v. Kacheroo Mal</data><data key="d2">1</data></node><node id="prec_1970_2_scc_71"><data key="d0">precedent</data><data key="d1">Seed Merchants' Asso- ciation v. Union of India</data><data key="d2">1</data></node><node id="prec_1983_4_scc_522"><data key="d0">precedent</data><data key="d1">(1983) 4 SCC 522</data><data key="d2">1</data></node><node id="prec_1982_1_scc_71"><data key="d0">precedent</data><data key="d1">Similar view was expressed by this Court in Gulam Abbas v. State of U.P</data><data key="d2">1</data></node><node id="prec_2007_4_scc_737"><data key="d0">precedent</data><data key="d1">vide Asif Hameed v. State of</data><data key="d2">1</data></node><node id="prec_1996_10_scc_304"><data key="d0">precedent</data><data key="d1">vide Asif Hameed v. State of</data><data key="d2">1</data></node><node id="prec_2005_13_scc_495"><data key="d0">precedent</data><data key="d1">State of Orissa v. Gopinath Dash</data><data key="d2">1</data></node><node id="prec_2006_4_scc_162"><data key="d0">precedent</data><data key="d1">State of Orissa v. Gopinath Dash</data><data key="d2">1</data></node><node id="prec_1997_9_scc_495"><data key="d0">precedent</data><data key="d1">(1997) 9 SCC 495</data><data key="d2">1</data></node><node id="prec_air_1974_sc_228"><data key="d0">precedent</data><data key="d1">Tejani v. Mahadeo Ramchandra Dange</data><data key="d2">1</data></node><node id="prec_air_1954_sc_220"><data key="d0">precedent</data><data key="d1">Bharucha v. Excise Commr</data><data key="d2">1</data></node><node id="prec_air_1956_sc_676"><data key="d0">precedent</data><data key="d1">AIR 1956 SC 676</data><data key="d2">1</data></node><node id="prec_air_1962_sc_1044"><data key="d0">precedent</data><data key="d1">AIR 1962 SC 1044</data><data key="d2">1</data></node><node id="prec_air_1964_sc_1284"><data key="d0">precedent</data><data key="d1">AIR 1964 SC 1284</data><data key="d2">1</data></node><node id="prec_air_1976_sc_1654"><data key="d0">precedent</data><data key="d1">in State of Haryana v. Chanan Mal</data><data key="d2">1</data></node><node id="prec_air_1970_sc_1436"><data key="d0">precedent</data><data key="d1">AIR 1970 SC 1436</data><data key="d2">1</data></node><node id="prec_air_1961_sc_1170"><data key="d0">precedent</data><data key="d1">Weaving Mills Co. Ltd. v. State of Uttar Pradesh</data><data key="d2">1</data></node><node id="prec_air_1956_sc_614"><data key="d0">precedent</data><data key="d1">In Shri Ram Narain v. Simla Banking and Industrial Co. Ltd</data><data key="d2">1</data></node><node id="prec_air_1916_cal_472"><data key="d0">precedent</data><data key="d1">Making of successive orders was disapproved by the Division Bench of the Calcutta High Court in Bishessur Chuckerbutty v. Emperor</data><data key="d2">1</data></node><node id="prec_air_1961_sc_884"><data key="d0">precedent</data><data key="d1">It is relevant to advert to the decision of this Court in Babulal Parate v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_air_1981_sc_2198"><data key="d0">precedent</data><data key="d1">AIR 1981 SC 2198</data><data key="d2">1</data></node><node id="prec_air_1984_sc_51"><data key="d0">precedent</data><data key="d1">and another decision rendered in Babulal Parate v. The State of Maharashtra</data><data key="d2">1</data></node><node id="prec_2018_scc_online_sc_49"><data key="d0">precedent</data><data key="d1">2018 SCC OnLine SC 49</data><data key="d2">1</data></node><node id="prec_2011_scc_online_del_5692"><data key="d0">precedent</data><data key="d1">2011 SCC OnLine Del 5692</data><data key="d2">1</data></node><node id="prec_2022_scc_online_sc_533"><data key="d0">precedent</data><data key="d1">2022 SCC OnLine SC 533</data><data key="d2">1</data></node><node id="prec_2006_12_scc_28"><data key="d0">precedent</data><data key="d1">(2006) 12 SCC 28</data><data key="d2">1</data></node><node id="prec_2018_12_scc_651"><data key="d0">precedent</data><data key="d1">(2018) 12 SCC 651</data><data key="d2">1</data></node><node id="prec_1980_4_scc_600"><data key="d0">precedent</data><data key="d1">Devidayal vs. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_1978_2_scc_424"><data key="d0">precedent</data><data key="d1">The Satpathy vs. PL Dani</data><data key="d2">1</data></node><node id="prec_2003_6_scc_675"><data key="d0">precedent</data><data key="d1">Surya Dev Rai vs. Ram Chander Rai</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_2484"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine Del 2484</data><data key="d2">1</data></node><node id="prec_2017_scc_online_del_8930"><data key="d0">precedent</data><data key="d1">2017 SCC OnLine Del 8930</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_1043"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine SC 1043</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_934"><data key="d0">precedent</data><data key="d1">Supreme Court in L. Chandra Kumar vs. Union of India22. To be sure</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_413"><data key="d0">precedent</data><data key="d1">BS Hari vs. Union of India</data><data key="d2">1</data></node><node id="prec_2000_3_scc_54"><data key="d0">precedent</data><data key="d1">(2000) 3 SCC 54</data><data key="d2">1</data></node><node id="prec_2011_3_scc_545"><data key="d0">precedent</data><data key="d1">(2011) 3 SCC 545</data><data key="d2">1</data></node><node id="prec_2018_15_scc_166"><data key="d0">precedent</data><data key="d1">(2018) 15 SCC 166</data><data key="d2">1</data></node><node id="prec_2008_2_scc_326"><data key="d0">precedent</data><data key="d1">(2008) 2 SCC 326</data><data key="d2">1</data></node><node id="prec_2008_10_scc_394"><data key="d0">precedent</data><data key="d1">he places reliance on Yogesh alias Sachin Jagdish Joshi v. State of Maharashtra</data><data key="d2">1</data></node><node id="prec_2009_6_scc_587"><data key="d0">precedent</data><data key="d1">Subair v. State of Kerala</data><data key="d2">1</data></node><node id="prec_1983_1_scc_305"><data key="d0">precedent</data><data key="d1">Nakara v. Union of India</data><data key="d2">1</data></node><node id="prec_2000_5_scc_299"><data key="d0">precedent</data><data key="d1">CCE v. Raghuvar</data><data key="d2">1</data></node><node id="prec_2023_dhc_000257"><data key="d0">precedent</data><data key="d1">2023/DHC/000257</data><data key="d2">1</data></node><node id="prec_2020_8_scc_401"><data key="d0">precedent</data><data key="d1">(2020) 8 SCC

