<data key="d1">Prahladdas Khandelwal v. Narendra Kumar Salave30</data><data key="d2">1</data></node><node id="prec_1952_1_scc_94"><data key="d0">precedent</data><data key="d1">Prahladdas Khandelwal v. Narendra Kumar Salave30</data><data key="d2">1</data></node><node id="prec_2006_9_scc_256"><data key="d0">precedent</data><data key="d1">Prahladdas Khandelwal v. Narendra Kumar Salave30</data><data key="d2">1</data></node><node id="prec_2014_15_scc_44"><data key="d0">precedent</data><data key="d1">Prahladdas Khandelwal v. Narendra Kumar Salave30</data><data key="d2">1</data></node><node id="prec_1973_3_scc_104"><data key="d0">precedent</data><data key="d1">Prahladdas Khandelwal v. Narendra Kumar Salave30</data><data key="d2">1</data></node><node id="prec_2004_7_scc_492"><data key="d0">precedent</data><data key="d1">(2004) 7 SCC 492</data><data key="d2">1</data></node><node id="prec_1982_1_scc_691"><data key="d0">precedent</data><data key="d1">(1982) 1 SCC 691</data><data key="d2">1</data></node><node id="prec_2021_6_scc_523"><data key="d0">precedent</data><data key="d1">(2021) 6 SCC 523</data><data key="d2">1</data></node><node id="prec_1984_1_scc_91"><data key="d0">precedent</data><data key="d1">(1984) 1 SCC 91</data><data key="d2">1</data></node><node id="prec_2018_18_scc_141"><data key="d0">precedent</data><data key="d1">(2018) 18 SCC 141</data><data key="d2">1</data></node><node id="prec_2012_11_scc_390"><data key="d0">precedent</data><data key="d1">(2012) 11 SCC 390</data><data key="d2">1</data></node><node id="prec_2012_1_scc_762"><data key="d0">precedent</data><data key="d1">(2012) 1 SCC 762</data><data key="d2">1</data></node><node id="prec_2006_2_scc_1"><data key="d0">precedent</data><data key="d1">it is pertinent to state that the Hon'ble Supreme Court in Rameshwar Prasad vs Union of India</data><data key="d2">1</data></node><node id="prec_2021_12_scc_780"><data key="d0">precedent</data><data key="d1">(2021) 12 SCC 780</data><data key="d2">1</data></node><node id="prec_2020_6_scc_548"><data key="d0">precedent</data><data key="d1">(2020) 6 SCC 548</data><data key="d2">1</data></node><node id="prec_1985_4_scc_689"><data key="d0">precedent</data><data key="d1">1985 4 SCC 689</data><data key="d2">1</data></node><node id="prec_1993_4_scc_175"><data key="d0">precedent</data><data key="d1">(1993) 4 SCC 175</data><data key="d2">1</data></node><node id="prec_1998_8_scc_703"><data key="d0">precedent</data><data key="d1">(1998) 8 SCC 703</data><data key="d2">1</data></node><node id="prec_1977_2_scc_494"><data key="d0">precedent</data><data key="d1">Shrivastava v. Bhupendra Kumar Jain</data><data key="d2">1</data></node><node id="prec_air_1955_sc_425"><data key="d0">precedent</data><data key="d1">AIR 1955 SC 425</data><data key="d2">1</data></node><node id="prec_air_1977_sc_1703"><data key="d0">precedent</data><data key="d1">Shrivastava v. Bhupendra Kumar Jain</data><data key="d2">1</data></node><node id="prec_2014_scc_online_del_4622"><data key="d0">precedent</data><data key="d1">Prahladdas Khandelwal v. Narendra Kumar Salave30</data><data key="d2">1</data></node><node id="prec_2018_scconline_del_10284"><data key="d0">precedent</data><data key="d1">Prahladdas Khandelwal v. Narendra Kumar Salave30</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_2438"><data key="d0">precedent</data><data key="d1">Prahladdas Khandelwal v. Narendra Kumar Salave30</data><data key="d2">1</data></node><node id="prec_2018_scconline_del_10782"><data key="d0">precedent</data><data key="d1">2018 SCCOnLine Del 10782</data><data key="d2">1</data></node><node id="prec_2023_dhc_3747"><data key="d0">precedent</data><data key="d1">2023:DHC:3747</data><data key="d2">1</data></node><node id="prec_2009_1_scc_196"><data key="d0">precedent</data><data key="d1">Kanpur vs J.K. Charitable Trust</data><data key="d2">1</data></node><node id="prec_2006_3_scc_1"><data key="d0">precedent</data><data key="d1">The Hon'ble Supreme Court relied upon an earlier decision in the case of Bharat Sanchar Nigam Limited vs Union of India</data><data key="d2">1</data></node><node id="prec_2022_scc_online_sc_543"><data key="d0">precedent</data><data key="d1">in terms with the decision of the Hon'ble Supreme Court in the case of Union of India vs Ashish Aggarwal</data><data key="d2">1</data></node><node id="prec_2006_scc_online_del_83"><data key="d0">precedent</data><data key="d1">In the cases titled Commissioner of Income Tax vs ARJ Security Printers</data><data key="d2">1</data></node><node id="prec_2004_3_scc_297"><data key="d0">precedent</data><data key="d1">placing reliance on the judgment of the Supreme Court in National Insurance Co. Ltd. v. Swaran Singh and Others</data><data key="d2">1</data></node><node id="prec_2018_7_scc_558"><data key="d0">precedent</data><data key="d1">the learned counsel for the respondent no.1 places reliance on the judgment of the Supreme Court in Amrit Paul Singh and Another v. Tata AIG General Insurance Company Limited and Others</data><data key="d2">1</data></node><node id="prec_2018_8_scc_492"><data key="d0">precedent</data><data key="d1">the Supreme Court in Rani and Others. v. National Insurance Company Limited and Others</data><data key="d2">1</data></node><node id="prec_2004_8_scc_517"><data key="d0">precedent</data><data key="d1">In National Insurance Co. Ltd. v. Challa Upendra Rao and others</data><data key="d2">1</data></node><node id="prec_2016_3_scc_10"><data key="d0">precedent</data><data key="d1">and Lakhmi Chand v. Reliance General Insurance</data><data key="d2">1</data></node><node id="prec_2023_4_scc_381"><data key="d0">precedent</data><data key="d1">the Supreme Court in Gohar Mohammed. v. Uttar Pradesh State Road Transport Corporation and Others</data><data key="d2">1</data></node><node id="prec_2003_2_scc_223"><data key="d0">precedent</data><data key="d1">The High Court had relied upon decisions of this Court in National Insurance Company Limited v. Challa Bharathamma</data><d