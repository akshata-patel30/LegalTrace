="prec_2014_6_scc_798"><data key="d0">precedent</data><data key="d1">(2014) 6 SCC 798</data><data key="d2">1</data></node><node id="prec_1973_2_scc_124"><data key="d0">precedent</data><data key="d1">(1973) 2 SCC 124</data><data key="d2">1</data></node><node id="prec_2011_1_scc_236"><data key="d0">precedent</data><data key="d1">(2011) 1 SCC 236</data><data key="d2">1</data></node><node id="prec_2009_6_scc_735"><data key="d0">precedent</data><data key="d1">(2009) 6 SCC 735</data><data key="d2">1</data></node><node id="prec_2005_6_scc_537"><data key="d0">precedent</data><data key="d1">(2005) 6 SCC 537</data><data key="d2">1</data></node><node id="prec_2018_8_scc_321"><data key="d0">precedent</data><data key="d1">(2018) 8 SCC 321</data><data key="d2">1</data></node><node id="prec_2004_5_scc_583"><data key="d0">precedent</data><data key="d1">(2004) 5 SCC 583</data><data key="d2">1</data></node><node id="prec_2009_10_scc_1"><data key="d0">precedent</data><data key="d1">(2009) 10 SCC 1</data><data key="d2">1</data></node><node id="prec_2016_11_scc_31"><data key="d0">precedent</data><data key="d1">(2016) 11 SCC 31</data><data key="d2">1</data></node><node id="prec_1952_1_scc_205"><data key="d0">precedent</data><data key="d1">(1952) 1 SCC 205</data><data key="d2">1</data></node><node id="prec_2015_7_scc_601"><data key="d0">precedent</data><data key="d1">(2015) 7 SCC 601</data><data key="d2">1</data></node><node id="prec_1976_3_scc_677"><data key="d0">precedent</data><data key="d1">(1976) 3 SCC 677</data><data key="d2">1</data></node><node id="prec_1976_4_scc_52"><data key="d0">precedent</data><data key="d1">(1976) 4 SCC 52</data><data key="d2">1</data></node><node id="prec_2007_4_scc_596"><data key="d0">precedent</data><data key="d1">(2007) 4 SCC 596</data><data key="d2">1</data></node><node id="prec_2003_6_scc_697"><data key="d0">precedent</data><data key="d1">2003 6 SCC 697</data><data key="d2">1</data></node><node id="prec_2002_4_scc_105"><data key="d0">precedent</data><data key="d1">(2002) 4 SCC 105</data><data key="d2">1</data></node><node id="prec_air_1966_sc_1942"><data key="d0">precedent</data><data key="d1">AIR 1966 SC 1942</data><data key="d2">1</data></node><node id="prec_air_1968_sc_822"><data key="d0">precedent</data><data key="d1">AIR 1968 SC 822</data><data key="d2">1</data></node><node id="prec_air_1963_sc_1295"><data key="d0">precedent</data><data key="d1">AIR 1963 SC 1295</data><data key="d2">1</data></node><node id="prec_air_1959_sc_249"><data key="d0">precedent</data><data key="d1">AIR 1959 SC 249</data><data key="d2">1</data></node><node id="prec_air_1960_sc_430"><data key="d0">precedent</data><data key="d1">AIR 1960 SC 430</data><data key="d2">1</data></node><node id="prec_2022_scc_online_sc_1224"><data key="d0">precedent</data><data key="d1">2022 SCC OnLine SC 1224</data><data key="d2">1</data></node><node id="prec_1951_scc_online_sc_70"><data key="d0">precedent</data><data key="d1">1951 SCC OnLine SC 70</data><data key="d2">1</data></node><node id="prec_2014_scc_online_del_6650"><data key="d0">precedent</data><data key="d1">2014 SCC OnLine Del 6650</data><data key="d2">1</data></node><node id="prec_2023_dhc_2686"><data key="d0">precedent</data><data key="d1">2023:DHC:2686</data><data key="d2">1</data></node><node id="prec_2011_3_scc_345"><data key="d0">precedent</data><data key="d1">The Supreme Court in Parimal Vs. Veena</data><data key="d2">1</data></node><node id="prec_2020_11_scc_253"><data key="d0">precedent</data><data key="d1">recent decision of the Supreme Court in Krishnaveni Rai v. Pankaj Rai and N.C. No</data><data key="d2">1</data></node><node id="prec_2018_9_scc_691"><data key="d0">precedent</data><data key="d1">As held by this Court in Anurag Mittal v. Shaily Mishra Mittal</data><data key="d2">1</data></node><node id="prec_1978_3_scc_258"><data key="d0">precedent</data><data key="d1">but it is necessary to state how the question before us has already been settled by the decision in Lila Gupta v. Laxmi Narain</data><data key="d2">1</data></node><node id="prec_air_1978_sc_1351"><data key="d0">precedent</data><data key="d1">Lila Gupta vs. Laxmi Narain</data><data key="d2">1</data></node><node id="prec_2014_dhc_4920"><data key="d0">precedent</data><data key="d1">2014:DHC:4920</data><data key="d2">1</data></node><node id="prec_2023_dhc_001427"><data key="d0">precedent</data><data key="d1">2023:DHC:001427</data><data key="d2">1</data></node><node id="prec_2010_1_scc_126"><data key="d0">precedent</data><data key="d1">(2010) 1 SCC 126</data><data key="d2">1</data></node><node id="prec_2006_1_scc_697"><data key="d0">precedent</data><data key="d1">(2006) 1 SCC 697</data><data key="d2">1</data></node><node id="prec_2019_2_scc_198"><data key="d0">precedent</data><data key="d1">(2019) 2 SCC 198</data><data key="d2">1</data></node><node id="prec_2013_14_scc_622"><data key="d0">precedent</data><data key="d1">(2013) 14 SCC 622</data><data key="d2">1</data></node><node id="prec_2013_10_scc_83"><data key="d0">precedent</data><data key="d1">(2013)10 SCC 83</data><data key="d2">1</data></node><node id="prec_2013_9_scc_620"><data key="d0">precedent</data><data key="d1">(2013)9 SCC 620</data><data key="d2">1</data></node><node id="prec_2022_5scc345"><data key="d0">precedent</data><data key="d1">(2022)5SCC345</data><data key="d2">1</data></node><node id="prec_2023_scc_online_sc_435"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine SC 435</data><data key="d2">1</data></node><node id="prec_2023_dhc_2711"><data key="d0">precedent</data><data key="d1">2023:DHC:2711</data><data key="d2">1</data></node><node id="prec_1977_2_scc_431"><data key="d0">precedent</data><data key="d1">(1977) 2 SCC 431</data><data key="d2">1</data></node><node id="prec_1983_4_scc_575"><data key="d0">precedent</data><data key="d1">(1983) 4 SCC 575</data><data key="d2">1</data></node><node id="prec_1969_1_scc_110"><data key="d0">precedent</data><data key="d1">(1969) 1 SCC 110</data><data key="d2">1</data></node><node id="prec_air_1977_sc_781"><data key="d0">precedent</data><data key="d1">AIR 1977 SC 781</data><data key="d2">1</data></node><node id="prec_air_1983_sc_1015"><data key="d0">precedent</data><data key="d1">AIR 1983 SC 1015</data><data key="d2">1</data></node><node id="prec_air_1961_sc_1506"><data key="d0">precedent</data><data key="d1">AIR 1961 SC 1506</data><data key="d2">1</data></node><node id="prec_air_1970_sc_898"><data key="d0">precedent</data><data key="d1">AIR 1970 SC 898</data><data key="d2">1</data></node><node id="prec_air_1954_sc_207"><data key="d0">precedent</data><data key="d1">AIR 1954 SC 207</data><data key="d2">1</data></node><node id="prec_2015_4_scc_136"><data key="d0">precedent</data><data key="d1">(2015) 4 SCC

136</data><data key="d2">1</data></node><node id="prec_2000_8_scc_151"><data key="d0">precedent</data><data key="d1">contract agreed between the parties have to be construed strictly and given its normal meaning. Reliance has been placed upon the judgments passed by the Supreme Court in the cases of Datar Switchgears Ltd. vs. Tata Finance Ltd. and Another</data><data key="d2">1</data></node><node id="prec_2020_5_scc_164"><data key="d0">precedent</data><data key="d1">(2020) 5 SCC 164</data><data key="d2">1</data></node><node id="prec_2019_7_scc_236"><data key="d0">precedent</data><data key="d1">In Parsa Kente Collieries Ltd. v. Rajasthan Rajya Vidyut Utpadan Nigam Ltd</data><data key="d2">1</data></node><node id="prec_2015_14_scc_21"><data key="d0">precedent</data><data key="d1">NHAI v. ITD Cementation India Ltd</data><data key="d2">1</data></node><node id="prec_air_1954_bom_423"><data key="d0">precedent</data><data key="d1">Co. vs. Shamlal and Bros</data><data key="d2">1</data></node><node id="prec_2012_scc_online_del_4396"><data key="d0">precedent</data><data key="d1">genuine pre-estimate of damages was enumerated by the Division Bench of this Court in the case of Tower Vision India Private Limited v. Procall Private Limited</data><data key="d2">1</data></node><node id="prec_2019_scc_online_del_8255"><data key="d0">precedent</data><data key="d1">Further reliance has been placed upon the judgment of this Court in the case of Fiberfill Engineers vs. Indian Oil Corporation Limited</data><data key="d2">1</data></node><node id="prec_2014_scconline_del_6948"><data key="d0">precedent</data><data key="d1">party claiming rent for the lock-in period to mitigate losses was also emphasised by this Court in the case of Adidas India Marketing Private Limited vs. Hicare India Properties Private Limited</data><data key="d2">1</data></node><node id="prec_2020_scc_online_del_2068"><data key="d0">precedent</data><data key="d1">vacated by the decision rendered by this Court in Halliburton Offshore Services Inc. vs. Vedanta Limited</data><data key="d2">1</data></node><node id="prec_2016_11_scc_808"><data key="d0">precedent</data><data key="d1">(2016) 11 SCC 808</data><data key="d2">1</data></node><node id="prec_2015_15_scc_697"><data key="d0">precedent</data><data key="d1">which was passed by this Court in Union of India v. Suvidha Ltd</data><data key="d2">1</data></node><node id="prec_2016_scc_online_del_4211"><data key="d0">precedent</data><data key="d1">Dish TV India Ltd. v. GNCTD</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_1900"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine Del 1900</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_700"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine Del 700</data><data key="d2">1</data></node><node id="prec_2018_scc_online_del_10624"><data key="d0">precedent</data><data key="d1">2018 SCC OnLine Del 10624</data><data key="d2">1</data></node><node id="prec_2018_scc_online_del_13447"><data key="d0">precedent</data><data key="d1">2018 SCC OnLine Del 13447</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_463"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine Del 463</data><data key="d2">1</data></node><node id="prec_2023_dhc_3121"><data key="d0">precedent</data><data key="d1">2023:DHC:3121</data><data key="d2">1</data></node><node id="prec_2010_11_scc_159"><data key="d0">precedent</data><data key="d1">Maharshi Dayanand University Vs. Surjeet Kaur1</data><data key="d2">1</data></node><node id="prec_2009_11_scc_726"><data key="d0">precedent</data><data key="d1">(2009) 11 SCC 726</data><data key="d2">1</data></node><node id="prec_air_2002_sc_629"><data key="d0">precedent</data><data key="d1">while placing reliance on its earlier pronouncement in the case of State of Punjab v. Renuka Singh8</data><data key="d2">1</data></node><node id="prec_2023_dhc_2783"><data key="d0">precedent</data><data key="d1">2023:DHC:2783</data><data key="d2">1</data></node><node id="prec_1982_3_scc_270"><data key="d0">precedent</data><data key="d1">and Anr. v. Prem Deva Niranjan Deva</data><data key="d2">1</data></node><node id="prec_2008_5_scc_287"><data key="d0">precedent</data><data key="d1">submits that the Supreme Court in Satyawati Sharma v. Union of India</data><data key="d2">1</data></node><node id="prec_2019_17_scc_237"><data key="d0">precedent</data><data key="d1">wherein it has been stated that as Satyawati Sharma v. Union of India</data><data key="d2">1</data></node><node id="prec_1985_2_scc_683"><data key="d0">precedent</data><data key="d1">question as to whether the judgement of the Supreme Court in Satyawati Sharma v. Union of India</data><data key="d2">1</data></node><node id="prec_1984_2_scc_75"><data key="d0">precedent</data><data key="d1">The Apex Court in Ravi Datt Sharma v. Ratan Lal Bhargava</data><data key="d2">1</data></node><node id="prec_1980_1_scc_290"><data key="d0">precedent</data><data key="d1">This was clearly held in the case of Kewal Singh v. Lajwanti</data><data key="d2">1</data></node><node id="prec_2001_5_scc_705"><data key="d0">precedent</data><data key="d1">Referring to Shiv Sarup Gupta v. Dr. Mahesh Chand Gupta</data><data key="d2">1</data></node><node id="prec_2000_9_scc_249"><data key="d0">precedent</data><data key="d1">Refer to Nathi Devi v. Radha Devi Gupta</data><data key="d2">1</data></node><node id="prec_1994_6_scc_349"><data key="d0">precedent</data><data key="d1">In Gauri Shanker and Ors. v. Union of India and Ors</data><data key="d2">1</data></node><node id="prec_1986_4_scc_736"><data key="d0">precedent</data><data key="d1">Sharma v. LIC of India</data><data key="d2">1</data></node><node id="prec_1996_1_scc_1"><data key="d0">precedent</data><data key="d1">Sharma v. LIC of India</data><data key="d2">1</data></node><node id="prec_2005_8_scc_504"><data key="d0">precedent</data><data key="d1">Sharma v. LIC of India</data><data key="d2">1</data></node><node id="prec_1986_3_scc_385"><data key="d0">precedent</data><data key="d1">as also the observations contained in the concluding portion of the judgment in Gian Devi Anand v. Jeevan Kumar</data><data key="d2">1</data></node><node id="prec_2002_5_scc_397"><data key="d0">precedent</data><data key="d1">and we cannot uphold such arbitrary classification ignoring the ratio of Harbilas Rai Bansal v. State of Punjab</data><data key="d2">1</data></node><node id="prec_1982_1_scc_39"><data key="d0">precedent</data><data key="d1">Our attention was drawn to the decision in Bishambhar Dayal Chandra Mohan v. State of U.P</data><data key="d2">1</data></node><node id="prec_1996_3_scc_105"><data key="d0">precedent</data><data key="d1">Sawai Bhawani Singh v. State of Rajasthan</data><data key="d2">1</data></node><node id="prec_2009_9_scc_772"><data key="d0">precedent</data><data key="d1">The controversy following Satyawati Sharma v. Union of India</data><data key="d2">1</data></node><node id="prec_1985_4_scc_221"><data key="d0">precedent</data><data key="d1">Mohinder Kumar v. State of Neutral Citation Number is</data><data key="d2">1</data></node><node id="prec_1987_4_scc_238"><data key="d0">precedent</data><data key="d1">Prabhakaran Nair v. State of T.N</data><data key="d2">1</data></node><node id="prec_1995_1_scc_104"><data key="d0">precedent</data><data key="d1">Bhatia v. Union of India</data><data key="d2">1</data></node><node id="prec_1998_8_scc_275"><data key="d0">precedent</data><data key="d1">D.C. Bhatia v. Union of India</data><data key="d2">1</data></node><node id="prec_2020_7_scc_327"><data key="d0">precedent</data><data key="d1">Inam v. Sanjay Kumar Singhal</data><data key="d2">1</data></node><node id="prec_1999_1_scc_141"><data key="d0">precedent</data><data key="d1">Again in Ram Narain Arora v. Asha Rani</data><data key="d2">1</data></node><node id="prec_1981_3_scc_36"><data key="d0">precedent</data><data key="d1">Quasim v. Manohar Lal Sharma</data><data key="d2">1</data></node><node id="prec_air_1980_sc_161"><data key="d0">precedent</data><data key="d1">This was clearly held in the case of Kewal Singh v. Lajwanti</data><data key="d2">1</data></node><node id="prec_air_1955_sc_166"><data key="d0">precedent</data><data key="d1">it is only proper to quote the following observations in Sakhawat Ali v. State of Orissa</data><data key="d2">1</data></node><node id="prec_air_1964_sc_1179"><data key="d0">precedent</data><data key="d1">strike down the same if it is found that the rationale of classification has become non-existent. In State of M.P. v. Bhopal Sugar Industries Ltd</data><data key="d2">1</data></node><node id="prec_air_1957_sc_628"><data key="d0">precedent</data><data key="d1">Chamarbaugwalla v. Union of India</data><data key="d2">1</data></node><node id="prec_air_1981_sc_1113"><data key="d0">precedent</data><data key="d1">Quasim v. Manohar Lal Sharma</data><data key="d2">1</data></node><node id="prec_air_1988_sc_1422"><data key="d0">precedent</data><data key="d1">In Ram Dass v. Ishwar Chander</data><data key="d2">1</data></node><node id="prec_2018_scc_online_del_8889"><data key="d0">precedent</data><data key="d1">reliance has been placed on Rani Sethi v. Amarjeet Singh</data><data key="d2">1</data></node><node id="prec_2013_scc_online_del_2793"><data key="d0">precedent</data><data key="d1">Reference has been made to Shiv Sarup Gupta v. Dr. Mahesh Chand Gupta</data><data key="d2">1</data></node><node id="prec_2014_scc_online_del_1707"><data key="d0">precedent</data><data key="d1">Judgement of this Court in Sharifuddin v. Babuddin and Ors</data><data key="d2">1</data></node><node id="prec_2008_scc_online_del_1256"><data key="d0">precedent</data><data key="d1">Judgement of this Court in Sharifuddin v. Babuddin and Ors</data><data key="d2">1</data></node><node id="prec_2002_scc_online_del_930"><data key="d0">precedent</data><data key="d1">Satyawati Sharma v. Union of India</data><data key="d2">1</data></node><node id="prec_1989_3_scc_202"><data key="d0">precedent</data><data key="d1">Ors. v. Bibhuti Bhushan Bagh</data><data key="d2">1</data></node><node id="prec_air_1940_bom_378"><data key="d0">precedent</data><data key="d1">It is relevant to refer the decision of the Bombay High Court in Emperor v. Hasan Mama</data><data key="d2">1</data></node><node id="prec_air_2003_sc_3268"><data key="d0">precedent</data><data key="d1">In Balram Kumawat v. Union of India</data><data key="d2">1</data></node><node id="prec_2015_13_scc_35"><data key="d0">precedent</data><data key="d1">(2015) 13 SCC 35</data><data key="d2">1</data></node><node id="prec_2017_14_scc_809"><data key="d0">precedent</data><data key="d1">(2017) 14 SCC 809</data><data key="d2">1</data></node><node id="prec_2015_13_scc_37"><data key="d0">precedent</data><data key="d1">(2015) 13 SCC 37</data><data key="d2">1</data></node><node id="prec_1988_2_scc_299"><data key="d0">precedent</data><data key="d1">(1988) 2 SCC 299</data><data key="d2">1</data></node><node id="prec_1989_2_scc_279"><data key="d0">precedent</data><data key="d1">In ITO v. Mewalal Dwarka Prasad</data><data key="d2">1</data></node><node id="prec_1996_9_scc_534"><data key="d0">precedent</data><data key="d1">(1996) 9 SCC 534</data><data key="d2">1</data></node><node id="prec_2016_scc_online_del_5751"><data key="d0">precedent</data><data key="d1">Kumar Suneja vs. Central Bureau of Investigation</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_2087"><data key="d0">precedent</data><data key="d1">2022 SCC OnLine Del 2087</data><data key="d2">1</data></node><node id="prec_2018_scc_online_del_11078"><data key="d0">precedent</data><data key="d1">2018 SCC OnLine Del 11078</data><data key="d2">1</data></node><node id="prec_2023_dhc_2409"><data key="d0">precedent</data><data key="d1">2023:DHC:2409</data><data key="d2">1</data></node><node id="prec_2013_5_scc_277"><data key="d0">precedent</data><data key="d1">(2013) 5 SCC 277</data><data key="d2">1</data></node><node id="prec_1999_1_scc_330"><data key="d0">precedent</data><data key="d1">(1999) 1 SCC 330</data><data key="d2">1</data></node><node id="prec_2018_4_scc_619"><data key="d0">precedent</data><data key="d1">(2018) 4 SCC 619</data><data key="d2">1</data></node><node id="prec_2020_7_scc_401"><data key="d0">precedent</data><data key="d1">(2020) 7 SCC 401</data><data key="d2">1</data></node><node id="prec_2019_scc_online_del_7593"><data key="d0">precedent</data><data key="d1">2019 SCC OnLine Del 7593</data><data key="d2">1</data></node><node id="prec_2023_dhc_2584"><data key="d0">precedent</data><data key="d1">2023:DHC:2584</data><data key="d2">1</data></node><node id="prec_2022_dhc_4280"><data key="d0">precedent</data><data key="d1">Kunwar Narayan vs. Ms Ozone Overseas Pvt Ltd and Anr. in ARB.P</data><data key="d2">1</data></node><node id="prec_2021_dhc_496"><data key="d0">precedent</data><data key="d1">Ltd..and Ravindra Kumar Verma v. BPTP Ltd nothing worthwhile would be achieved</data><data key="d2">1</data></node><node id="prec_2015_13_scc_610"><data key="d0">precedent</data><data key="d1">reference may be made to the Judgement of Supreme Court in Demarara Distilleries Pvt. Ltd. vs. Demerara Distillers Ltd</data><data key="d2">1</data></node><node id="prec_2009_scc_online_del_4355"><data key="d0">precedent</data><data key="d1">2009 SCC OnLine Del 4355</data><data key="d2">1</data></node><node id="prec_2003_6_scc_595"><data key="d0">precedent</data><data key="d1">Roop Kumar v. Mohan Thedani reported as</data><data key="d2">1</data></node><node id="prec_2009_4_scc_193"><data key="d0">precedent</data><data key="d1">Roop Kumar v. Mohan Thedani reported as</data><data key="d2">1</data></node><node id="prec_1995_3_scc_147"><data key="d0">precedent</data><data key="d1">Anil Kumar Sinah Vs. Shivnath Mishra</data><data key="d2">1</data></node><node id="prec_air_1982_sc_20"><data key="d0">precedent</data><data key="d1">Roop Kumar v. Mohan Thedani reported as</data><data key="d2">1</data></node><node id="prec_air_2019_sc_5760"><data key="d0">precedent</data><data key="d1">Tara Sikand Atwal v. Viraj Sikand and Ors. reported as</data><data key="d2">1</data></node><node id="prec_2011_scc_online_sc_1097"><data key="d0">precedent</data><data key="d1">ble Supreme Court in the matter of Kewal Krishan v. Rajesh Kumar</data><data key="d2">1</data></node><node id="prec_2018_scc_online_del_11410"><data key="d0">precedent</data><data key="d1">ble Court in the matter of Parmila Singh v. Ashok Saluja</data><data key="d2">1</data></node><node id="prec_2006_2_scc_777"><data key="d0">precedent</data><data key="d1">Ors. v. Bhakti Hari Nayak</data><data key="d2">1</data></node><node id="prec_2006_1_scc_46"><data key="d0">precedent</data><data key="d1">(2006) 1 SCC 46</data><data key="d2">1</data></node><node id="prec_2002_5_scc_90"><data key="d0">precedent</data><data key="d1">(2002) 5 SCC 90</data><data key="d2">1</data></node><node id="prec_1974_3_scc_554"><data key="d0">precedent</data><data key="d1">only establish that the defendants have infringed the Refer Umed v. Raj Singh</data><data key="d2">1</data></node><node id="prec_1974_2_scc_70"><data key="d0">precedent</data><data key="d1">special Refer State of Punjab v. Amar Singh</data><data key="d2">1</data></node><node id="prec_air_1990_del_233"><data key="d0">precedent</data><data key="d1">Sun Pharmaceutical Laboratories Ltd v. Hetero Healthcare Ltd</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_1773"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine Del 1773</data><data key="d2">1</data></node><node id="prec_2023_scc_online_del_896"><data key="d0">precedent</data><data key="d1">2023 SCC OnLine Del 896</data><data key="d2">1</data></node><node id="prec_1991_3_scc_27"><data key="d0">precedent</data><data key="d1">Jaharlal Das v. State of Orissa</data><data key="d2">1</data></node><node id="prec_2018_1_scc_202"><data key="d0">precedent</data><data key="d1">Khekh Ram v. State of Himachal Pradesh</data><data key="d2">1</data></node><node id="prec_2016_14_scc_640"><data key="d0">precedent</data><data key="d1">Mehboob Ali v. State of Rajasthan</data><data key="d2">1</data></node><node id="prec_2018_8_scc_271"><data key="d0">precedent</data><data key="d1">Surinder Kumar Khanna v. Intelligence Officer</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_1532"><data key="d0">precedent</data><data key="d1">Amit Ranjan v. Narcotics Control Bureau</data><data key="d2">1</data></node><node id="prec_2022_7_scc_678"><data key="d0">precedent</data><data key="d1">recent judgement of the Supreme Court in Ramnath Exports Pvt. Ltd. v. Vinita Mehta</data><data key="d2">1</data></node><node id="prec_2017_8_scc_377"><data key="d0">precedent</data><data key="d1">In TRF Ltd. v. Energo Engineering Projects Ltd</data><data key="d2">1</data></node><node id="prec_2019_5_scc_755"><data key="d0">precedent</data><data key="d1">The Supreme Court in the case of Bharat Broadband Network Limited v. United Telecoms Limited</data><data key="d2">1</data></node><node id="prec_2023_dhc_4177"><data key="d0">precedent</data><data key="d1">2023:DHC:4177</data><data key="d2">1</data></node><node id="prec_2022_dhc_4121"><data key="d0">precedent</data><data key="d1">Devki Nandan Garg v. Directorate of Enforcement</data><data key="d2">1</data></node><node id="prec_2023_dhc_1925"><data key="d0">precedent</data><data key="d1">or one who is sick or infirm. Reliance is also placed on the judgment of this Court in Kewal Krishan Kumar v. Enforcement</data><data key="d2">1</data></node><node id="prec_2017_dhc_5507"><data key="d0">precedent</data><data key="d1">coordinate bench of this court in Mrs Shivani Rajiv Saxena v. Directorate of Enforcement</data><data key="d2">1</data></node><node id="prec_2009_dhc_56"><data key="d0">precedent</data><data key="d1">CrPC and also the judgment of Meenu Dewan v. State in Bail Appln. No.736</data><data key="d2">1</data></no