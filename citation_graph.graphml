d1">Also see the decision in Vinita M. Khanolkar v. Pragna M. Pai</data><data key="d2">1</data></node><node id="prec_1996_1_scc_49"><data key="d0">precedent</data><data key="d1">Resham Singh Pyara Singh v. Abdul Sattar</data><data key="d2">1</data></node><node id="prec_1997_3_scc_462"><data key="d0">precedent</data><data key="d1">Ltd. v. Orissa State Finance Corporation</data><data key="d2">1</data></node><node id="prec_2002_4_scc_447"><data key="d0">precedent</data><data key="d1">(2002) 4 SCC 447</data><data key="d2">1</data></node><node id="prec_2002_3_scc_705"><data key="d0">precedent</data><data key="d1">(2002) 3 SCC 705</data><data key="d2">1</data></node><node id="prec_2003_10_scc_361"><data key="d0">precedent</data><data key="d1">2003 10 SCC 361</data><data key="d2">1</data></node><node id="prec_1984_1_scc_358"><data key="d0">precedent</data><data key="d1">(1984) 1 SCC 358</data><data key="d2">1</data></node><node id="prec_2018_14_scc_715"><data key="d0">precedent</data><data key="d1">2018 14 SCC 715</data><data key="d2">1</data></node><node id="prec_2005_10_scc_331"><data key="d0">precedent</data><data key="d1">(2005) 10 SCC 331</data><data key="d2">1</data></node><node id="prec_1970_3_scc_900"><data key="d0">precedent</data><data key="d1">(1970) 3 SCC 900</data><data key="d2">1</data></node><node id="prec_air_1972_del_102"><data key="d0">precedent</data><data key="d1">AIR 1972 Del 102</data><data key="d2">1</data></node><node id="prec_air_1971_sc_1292"><data key="d0">precedent</data><data key="d1">AIR 1971 SC 1292</data><data key="d2">1</data></node><node id="prec_2023_dhc_3144"><data key="d0">precedent</data><data key="d1">2023:DHC:3144</data><data key="d2">1</data></node><node id="prec_air_1981_del_95"><data key="d0">precedent</data><data key="d1">AIR 1981 Del 95</data><data key="d2">1</data></node><node id="prec_2056_2019_dlt_1"><data key="d0">precedent</data><data key="d1">2056 (2019) DLT 1</data><data key="d2">1</data></node><node id="prec_2022_scc_onl