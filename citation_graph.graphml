node id="prec_2007_13_scc_673"><data key="d0">precedent</data><data key="d1">the delegated authority has to act within the confines of the plenary legislation.42 The rules or regulations enacted by the JK Industries Ltd. v. Union of India</data><data key="d2">2</data></node><node id="prec_2015_1_scc_166"><data key="d0">precedent</data><data key="d1">(2015) 1 SCC 166</data><data key="d2">2</data></node><node id="prec_1994_6_scc_651"><data key="d0">precedent</data><data key="d1">he judgments of this Court in the cases of Tata Cellular v. Union of India5</data><data key="d2">2</data></node><node id="prec_2021_8_scc_511"><data key="d0">precedent</data><data key="d1">Reliance is placed on the decisions of Manish Kumar Vs. Union of India and Anr</data><data key="d2">2</data></node><node id="prec_1986_2_scc_237"><data key="d0">precedent</data><data key="d1">Sons Vs. Balbir Nath Mathur</data><data key="d2">2</data></node><node id="prec_1981_4_scc_675"><data key="d0">precedent</data><data key="d1">Garg Vs. Union of India and Ors</data><data key="d2">2</data></node><node id="prec_1986_4_scc_566"><data key="d0">precedent</data><data key="d1">This Court in the case of State of M.P. vs. Nandlal Jaiswal</data><data key="d2">2</data></node><node id="prec_2000_5_scc_471"><data key="d0">precedent</data><data key="d1">Parish vs. Union and India</data><data key="d2">2</data></node><node id="prec_air_1957_sc_907"><data key="d0">precedent</data><data key="d1">In Kanailal Sur vs. Paramnidhi Sadhu Khan AIR</data><data key="d2">2</data></node><node id="prec_2003_6_scc_175"><data key="d0">precedent</data><data key="d1">(2003) 6 SCC 175</data><data key="d2">2</data></node><node id="prec_2011_4_scc_324"><data key="d0">precedent</data><data key="d1">(2011) 4 SCC 324</data><data key="d2">2</data></node><node id="prec_2008_13_scc_767"><data key="d0">precedent</data><data key="d1">State of Haryana v. Jagdish10</data><data key="d2">2</data></node><node id="prec_2023_2_scc_353"><data key="d0">precedent</data><data key="d1">Verma v. State of Chhattisgarh29</data><data key="d2">2</data></node><node id="prec_air_1955_sc_801"><data key="d0">precedent</data><data key="d1">Major Puran v. The State of Punjab AIR</data><data key="d2">2</data></node><node id="prec_2019_8_scc_714"><data key="d0">precedent</data><data key="d1">(2019) 8 SCC 714</data><data key="d2">2</data></node><node id="prec_2017_9_scc_729"><data key="d0">precedent</data><data key="d1">(2017) 9 SCC 729</data><data key="d2">2</data></node><node id="prec_2019_5_scc_362"><data key="d0">precedent</data><data key="d1">SA v. Gangavaram Port Ltd</data><data key="d2">2</data></node><node id="prec_2021_5_scc_671"><data key="d0">precedent</data><data key="d1">referred first authority to determine and decide all questions of non-arbitrability. In Pravin Electricals Pvt. Ltd. v. Galaxy Infra and Engg. Pvt. Ltd.19</data><data key="d2">2</data></node><node id="prec_2018_16_scc_158"><data key="d0">precedent</data><data key="d1">followed by Ashok Munilal Jain v. Directorate of Enforcement</data><data key="d2">2</data></node><node id="prec_2018_10_scc_1"><data key="d0">precedent</data><data key="d1">Ors. vs. Union of India Thr. Secretary Ministry of Law and Justice</data><data key="d2">2</data></node><node id="prec_air_1959_sc_1012"><data key="d0">precedent</data><data key="d1">Anr. v. State of U.P. AIR</data><data key="d2">2</data></node><node id="prec_2019_11_scc_706"><data key="d0">precedent</data><data key="d1">This principle was reiterated in Anand Kumar Mohatta and another vs. State</data><data key="d2">2</data></node><node id="prec_1998_4_scc_409"><data key="d0">precedent</data><data key="d1">Supreme Court Bar Association v. Union of India and Another</data><data key="d2">2</data></node><node id="prec_1996_4_scc_622"><data key="d0">precedent</data><data key="d1">Delhi Development Authority v. Skipper Construction Co</data><data key="d2">2</data></node><node id="prec_2006_4_scc_558"><data key="d0">precedent</data><data key="d1">in Kaslefsky v. Kaslefsky46 that if the door of cruelty were opened too wide</data><data key="d2">2</data></node><node id="prec_2020_14_scc_657"><data key="d0">precedent</data><data key="d1">Munish Kakkar v. Nidhi Kakkar4 and Neha Tyagi v. Lieutenant Colonel Deepak Tyagi5 has held that an irretrievable marriage is</data><data key="d2">2</data></node><node id="prec_2019_9_scc_409"><data key="d0">precedent</data><data key="d1">Munish Kakkar v. Nidhi Kakkar4 and Neha Tyagi v. Lieutenant Colonel Deepak Tyagi5 has held that an irretrievable marriage is</data><data key="d2">2</data></node><node id="prec_1985_1_scc_591"><data key="d0">precedent</data><data key="d1">Rakapalli Raja Ram Gopala Rao v. Naragani Govinda Sehararao</data><data key="d2">2</data></node><node id="prec_2012_6_scc_502"><data key="d0">precedent</data><data key="d1">as noticed by this Court in Brij Mohan Lal v. Union of India</data><data key="d2">2</data></node><node id="prec_2003_3_scc_57"><data key="d0">precedent</data><data key="d1">reliance is placed on the decision of this Court in the case of Commissioner of Income Tax Vs. Hindustan Bulk Carriers</data><data key="d2">2</data></node><node id="prec_1988_2_scc_271"><data key="d0">precedent</data><data key="d1">Patna Improvement Trust v. Lakshmi Devi</data><data key="d2">2</data></node><node id="prec_2021_9_scc_657"><data key="d0">precedent</data><data key="d1">Ltd. v. Edelweiss Asset Reconstruction Co. Ltd</data><data key="d2">2</data></node><node id="prec_2021_5_scc_1"><data key="d0">precedent</data><data key="d1">of the IBC has been upheld by this Court in Manish Kumar v. Union of India and Another reported in</data><data key="d2">2</data></node><node id="prec_2023_scc_online_del_1830"><data key="d0">precedent</data><data key="d1">The learned Senior Counsel for the applicant relies upon the judgment of Nagesh Sharma v. The Sate</data><data key="d2">1</data></node><node id="prec_2022_scc_online_sc_891"><data key="d0">precedent</data><data key="d1">ble Supreme Court in Narcotics Control Bureau v. Mohit Aggarwal</data><data key="d2">1</data></node><node id="prec_2023_dhc_000201"><data key="d0">precedent</data><data key="d1">2023/DHC/000201</data><data key="d2">1</data></node><node id="prec_1981_2_scc_150"><data key="d0">precedent</data><data key="d1">The Supreme Court in Akhilesh Prasad Vs. Union Territory of Mizoram</data><data key="d2">1</data></node><node id="prec_2012_scc_online_del_5606"><data key="d0">precedent</data><data key="d1">preferred writ petitions before this Court and the said petitions being Naveen Kumar Jha Vs. UOI</data><data key="d2">1</data></node><node id="prec_2015_scc_online_del_7274"><data key="d0">precedent</data><data key="d1">preferred writ petitions before this Court and the said petitions being Naveen Kumar Jha Vs. UOI</data><data key="d2">1</data></node><node id="prec_2017_scc_online_del_7879"><data key="d0">precedent</data><data key="d1">Ors. Vs. UOI</data><data key="d2">1</data></node><node id="prec_2019_scc_online_del_6962"><data key="d0">precedent</data><data key="d1">Ors. Vs. UOI</data><data key="d2">1</data></node><node id="prec_2019_scc_online_del_11894"><data key="d0">precedent</data><data key="d1">Ors. Vs. Union of India</data><data key="d2">1</data></node><node id="prec_2019_scc_online_del_11891"><data key="d0">precedent</data><data key="d1">Ors. Vs. UOI</data><data key="d2">1</data></node><node id="prec_2019_scc_online_del_11892"><data key="d0">precedent</data><data key="d1">in Niraj Kumar Singh and Ors. Vs. Union of India and Ors</data><data key="d2">1</data></node><node id="prec_2020_scc_online_del_1243"><data key="d0">precedent</data><data key="d1">being Vipul Pandey and Ors. Vs. Union of India and Ors</data><data key="d2">1</data></node><node id="prec_2020_scc_online_del_1295"><data key="d0">precedent</data><data key="d1">being Vipul Pandey and Ors. Vs. Union of India and Ors</data><data key="d2">1</data></node><node id="prec_2022_scc_online_del_3911"